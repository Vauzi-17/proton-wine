diff --git a/build-scripts/build-step-arm64ec.sh b/build-scripts/build-step-arm64ec.sh
index 7a693daabe7..b263899b490 100755
--- a/build-scripts/build-step-arm64ec.sh
+++ b/build-scripts/build-step-arm64ec.sh
@@ -289,9 +289,8 @@ do
     )
 
     for patch in "${PATCHES[@]}"; do
-#      if git apply --check ./android/patches/$patch 2>/dev/null; then
-        git apply ./android/patches/$patch
-#      fi
+      # a patch that stops applying fails the build instead of shipping without it
+      git apply ./android/patches/$patch || { echo "FATAL: android/patches/$patch does not apply"; exit 1; }
     done
   fi
 
