From fe07313e77416c0fb17fd32d685b9585bad123c1 Mon Sep 17 00:00:00 2001
From: Vauzi-17 <189964753+Vauzi-17@users.noreply.github.com>
Date: Sat, 10 Oct 2026 04:21:47 +0000
Subject: [PATCH 03/21] ntsync: Keep userspace ntsync objects alive while a
 client uses them.

A kernel ntsync object stays alive for as long as a client holds its fd.
A userspace ntsync handle carries no such reference, so when the last
handle to, say, a mutex was closed while another thread waited on it,
wineserver destroyed the object and ntsync_close() failed the pending
wait (the library's documented behaviour). The object also left
inproc_mutexes, so a later owner death was never reported as
WAIT_ABANDONED. kernel32's sync test catches exactly this (sync.c:252,
387 and 393 fail only with userspace ntsync).

get_inproc_sync_fd now also returns, in userspace mode, a handle to the
server's inproc_sync object. The client keeps it in its cache entry and
closes it, with a raw close_handle request because fd_cache_mutex may be
held, when the entry's last reference goes away. The handle makes a cache
entry 20 bytes, so a cache block no longer comes out at a whole number of
pages; blocks stay 64k so anon_mmap_alloc() gets whole pages.

This is the fix of the proton-cachyos 11 and GE-Proton 11.0-5 ntsync
builds, on GameNative's patches. The reply field goes into
server/protocol.def; autogen.sh regenerates the protocol headers.
---
 .../common/dlls_ntdll_unix_sync_c.patch       | 72 ++++++++++++++++---
 .../patches/common/server_inproc_sync_c.patch | 21 +++++-
 server/protocol.def                           |  1 +
 3 files changed, 83 insertions(+), 11 deletions(-)

diff --git a/android/patches/common/dlls_ntdll_unix_sync_c.patch b/android/patches/common/dlls_ntdll_unix_sync_c.patch
index 2b1e5280383..913d39b5b1e 100644
--- a/android/patches/common/dlls_ntdll_unix_sync_c.patch
+++ b/android/patches/common/dlls_ntdll_unix_sync_c.patch
@@ -1,5 +1,5 @@
 diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
-index 67ab945cef8..8e79186810f 100644
+index 67ab945cef8..559a0a4ebe3 100644
 --- a/dlls/ntdll/unix/sync.c
 +++ b/dlls/ntdll/unix/sync.c
 @@ -61,7 +61,14 @@
@@ -276,26 +276,82 @@ index 67ab945cef8..8e79186810f 100644
      }
      else if (timeout->QuadPart <= 0)
      {
-@@ -636,7 +815,12 @@ static void release_inproc_sync( struct inproc_sync *sync )
+@@ -542,9 +721,13 @@ struct inproc_sync
+     unsigned int   access;    /* handle access rights */
+     unsigned short type;      /* enum inproc_sync_type as short to save space */
+     unsigned short closed;    /* fd has been closed but sync is still referenced */
++    obj_handle_t   handle;    /* userspace ntsync: server handle keeping the object alive */
+ };
+ 
+-#define INPROC_SYNC_CACHE_BLOCK_SIZE  (65536 / sizeof(struct inproc_sync))
++/* A block is always 64k: anon_mmap_alloc() takes whole pages, and with the
++ * userspace ntsync handle the entry is no longer a power of two in size. */
++#define INPROC_SYNC_CACHE_BLOCK_BYTES 65536
++#define INPROC_SYNC_CACHE_BLOCK_SIZE  (INPROC_SYNC_CACHE_BLOCK_BYTES / sizeof(struct inproc_sync))
+ #define INPROC_SYNC_CACHE_ENTRIES     128
+ 
+ static struct inproc_sync *inproc_sync_cache[INPROC_SYNC_CACHE_ENTRIES];
+@@ -582,7 +765,7 @@ static struct inproc_sync *cache_inproc_sync( HANDLE handle, struct inproc_sync
+         if (!entry) inproc_sync_cache[0] = inproc_sync_cache_initial_block;
+         else
+         {
+-            static const size_t size = INPROC_SYNC_CACHE_BLOCK_SIZE * sizeof(struct inproc_sync);
++            static const size_t size = INPROC_SYNC_CACHE_BLOCK_BYTES;
+             void *ptr = anon_mmap_alloc( size, PROT_READ | PROT_WRITE );
+             if (ptr == MAP_FAILED) return sync;
+             inproc_sync_cache[entry] = ptr;
+@@ -601,6 +784,7 @@ static struct inproc_sync *cache_inproc_sync( HANDLE handle, struct inproc_sync
+     }
+ 
+     cache->fd = sync->fd;
++    cache->handle = sync->handle;
+     cache->access = sync->access;
+     cache->type = sync->type;
+     cache->closed = sync->closed;
+@@ -633,10 +817,31 @@ static void release_inproc_sync( struct inproc_sync *sync )
+     /* save the fd now; as soon as the refcount hits 0 we cannot
+      * access the cache anymore */
+     int fd = sync->fd;
++#ifdef __ANDROID__
++    obj_handle_t handle = sync->handle;
++#endif
      LONG ref = InterlockedDecrement( &sync->refcount );
  
      assert( ref >= 0 );
 +#ifdef __ANDROID__
-+    /* userspace ntsync objects are owned by the server; nothing to close */
-+    if (!ref && !ntsync_userspace) close( fd );
++    /* userspace ntsync objects are owned by the server: drop the handle that
++     * kept this one alive. Not NtClose(), we may hold fd_cache_mutex here. */
++    if (!ref && ntsync_userspace)
++    {
++        if (handle)
++        {
++            SERVER_START_REQ( close_handle )
++            {
++                req->handle = handle;
++                wine_server_call( req );
++            }
++            SERVER_END_REQ;
++        }
++    }
++    else if (!ref) close( fd );
 +#else
      if (!ref) close( fd );
 +#endif
  }
  
  static struct inproc_sync *get_cached_inproc_sync( HANDLE handle )
-@@ -677,8 +861,18 @@ static NTSTATUS get_server_inproc_sync( HANDLE handle, struct inproc_sync *sync
+@@ -677,8 +882,23 @@ static NTSTATUS get_server_inproc_sync( HANDLE handle, struct inproc_sync *sync
          {
              obj_handle_t fd_handle;
              sync->refcount = 1;
++            sync->handle = 0;
 +#ifdef __ANDROID__
 +            /* userspace ntsync object handle is passed in fsync_shm_idx */
-+            if (ntsync_userspace) sync->fd = reply->fsync_shm_idx;
++            if (ntsync_userspace)
++            {
++                sync->fd = reply->fsync_shm_idx;
++                sync->handle = reply->sync_handle;
++            }
 +            else
 +            {
 +                sync->fd = wine_server_receive_fd( &fd_handle );
@@ -308,7 +364,7 @@ index 67ab945cef8..8e79186810f 100644
              sync->access = reply->access;
              sync->type = reply->type;
              sync->closed = 0;
-@@ -908,6 +1102,10 @@ int get_inproc_alert_fd(void)
+@@ -908,6 +1128,10 @@ int get_inproc_alert_fd(void)
              if (!server_call_unlocked( req ))
              {
                  if (do_fsync()) data->alert_fd = fd = reply->fsync_shm_idx;
@@ -319,7 +375,7 @@ index 67ab945cef8..8e79186810f 100644
                  else
                  {
                      data->alert_fd = fd = wine_server_receive_fd( &token );
-@@ -2426,6 +2624,19 @@ NTSTATUS WINAPI NtSignalAndWaitForSingleObject( HANDLE signal, HANDLE wait,
+@@ -2426,6 +2650,19 @@ NTSTATUS WINAPI NtSignalAndWaitForSingleObject( HANDLE signal, HANDLE wait,
   */
  NTSTATUS WINAPI NtYieldExecution(void)
  {
diff --git a/android/patches/common/server_inproc_sync_c.patch b/android/patches/common/server_inproc_sync_c.patch
index 8b10d07e4d6..74acf582251 100644
--- a/android/patches/common/server_inproc_sync_c.patch
+++ b/android/patches/common/server_inproc_sync_c.patch
@@ -1,5 +1,5 @@
 diff --git a/server/inproc_sync.c b/server/inproc_sync.c
-index a7020ef8fcd..6c6b4d4cc0f 100644
+index a7020ef8fcd..8e593d19b91 100644
 --- a/server/inproc_sync.c
 +++ b/server/inproc_sync.c
 @@ -36,7 +36,14 @@
@@ -201,13 +201,28 @@ index a7020ef8fcd..6c6b4d4cc0f 100644
  }
  
  static int get_obj_inproc_sync( struct object *obj, int *type )
-@@ -359,6 +468,10 @@ DECL_HANDLER(get_inproc_sync_fd)
+@@ -359,6 +468,25 @@ DECL_HANDLER(get_inproc_sync_fd)
  
      if ((fd = get_obj_inproc_sync( obj, &reply->type )) < 0) set_error( STATUS_NOT_IMPLEMENTED );
      else if (do_fsync()) reply->fsync_shm_idx = fsync_grab_shm_idx( fd );
 +#ifdef __ANDROID__
 +    /* userspace ntsync object handle; valid in every process */
-+    else if (ntsync_userspace) reply->fsync_shm_idx = fd;
++    else if (ntsync_userspace)
++    {
++        struct object *sync = get_obj_sync( obj );
++
++        reply->fsync_shm_idx = fd;
++        /* A kernel ntsync fd keeps the object alive in the client. A userspace
++         * handle does not, so give the client a handle to the server object
++         * instead, which it closes once it stops using the object. Without it,
++         * closing the last handle while another thread waits destroyed the
++         * object: the wait failed, and an abandoned mutex was never reported. */
++        if (sync)
++        {
++            reply->sync_handle = alloc_handle_no_access_check( current->process, sync, 0, 0 );
++            release_object( sync );
++        }
++    }
 +#endif
      else send_client_fd( current->process, fd, req->handle );
  
diff --git a/server/protocol.def b/server/protocol.def
index 98d256f8fa3..efa68aa253d 100644
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -4234,6 +4234,7 @@ enum inproc_sync_type
     int           type;         /* inproc sync type */
     unsigned int access;        /* handle access rights */
     unsigned int fsync_shm_idx;
+    obj_handle_t sync_handle;   /* userspace ntsync: handle keeping the object alive */
 @END
 
 
