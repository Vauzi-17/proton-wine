From fb05f0bedf20b26d0e78cb4d068f33421565407e Mon Sep 17 00:00:00 2001
From: Vauzi-17 <189964753+Vauzi-17@users.noreply.github.com>
Date: Sun, 27 Sep 2026 13:00:08 +0000
Subject: [PATCH 18/18] comctl32, m3.msstyles: Pill push buttons without a
 dotted focus box.

The push buttons of the Material 3 style were rounded rectangles with
11 pixel corners, and the focused one had a dotted rectangle inside:
a box inside a rounded button. The button images are now 34 pixel
circles with 16 pixel sizing margins, a pill on buttons up to 34 pixels
high, and with m3.msstyles the focused push button shows the accent
ring of the default button instead of the dotted rectangle.
---
 dlls/comctl32_v6/button.c      |  19 +++++++++++++++++++
 dlls/m3.msstyles/m3.rc         |  24 ++++++++++++------------
 dlls/m3.msstyles/m3_button.bmp | Bin 13878 -> 27798 bytes
 3 files changed, 31 insertions(+), 12 deletions(-)

diff --git a/dlls/comctl32_v6/button.c b/dlls/comctl32_v6/button.c
index 9128e523c..79e929682 100644
--- a/dlls/comctl32_v6/button.c
+++ b/dlls/comctl32_v6/button.c
@@ -2744,6 +2744,19 @@ cleanup:
 /**********************************************************************
  *       Themed Paint Functions
  */
+
+/* The Material 3 style (m3.msstyles) shows the focused push button with the ring of the
+ * default button: a dotted rectangle doesn't fit its rounded buttons. */
+static BOOL focus_ring_theme(void)
+{
+    WCHAR path[MAX_PATH];
+    const WCHAR *name;
+
+    if (FAILED(GetCurrentThemeName(path, ARRAY_SIZE(path), NULL, 0, NULL, 0))) return FALSE;
+    name = wcsrchr(path, '\\');
+    return !lstrcmpiW(name ? name + 1 : path, L"m3.msstyles");
+}
+
 static void PB_ThemedPaint(HTHEME theme, const BUTTON_INFO *infoPtr, HDC hDC, int state, UINT dtFlags, BOOL focused)
 {
     RECT bgRect, labelRect, imageRect, textRect, focusRect;
@@ -2752,6 +2765,12 @@ static void PB_ThemedPaint(HTHEME theme, const BUTTON_INFO *infoPtr, HDC hDC, in
     LRESULT cdrf;
     HWND parent;
 
+    if (focused && focus_ring_theme())
+    {
+        if (state == PBS_NORMAL) state = PBS_DEFAULTED;
+        focused = FALSE;
+    }
+
     if (infoPtr->font) SelectObject(hDC, infoPtr->font);
 
     GetClientRect(infoPtr->hwnd, &bgRect);
