+
+struct display_settings
+{
+    BOOL xp;      /* the hand painted taskbar: Luna or Material 3 */
+    BOOL m3;
+    UINT accent;  /* Material 3 */
+    UINT mode;
+    UINT scheme;  /* Luna */
+    int  rows;
+    BOOL locked;
+    BOOL clock;
+    BOOL frames;
+    BOOL wallpaper;
+    BOOL controls;
+};
+
+extern void get_display_settings( struct display_settings *settings );
+extern void set_display_settings( const struct display_settings *settings );
+extern void paint_display_preview( HDC hdc, const RECT *rect, const struct display_settings *settings );
