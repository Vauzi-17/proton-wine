+    SetRect( &corners[2], x, y + height - radius, x + radius, y + height );
+    SetRect( &corners[3], x + width - radius, y + height - radius, x + width, y + height );
+    draw_backdrop( hdc, x, y, corners, ARRAY_SIZE(corners) );
+    m3_fill_round_rect( hdc, 0, 0, width, height, radius, colors->surface_container_high, 255 );
 
     /* the user */
     rect.left = sheet.left + pad;
@@ -665,7 +710,7 @@ void do_m3_launcher( HWND tray )
