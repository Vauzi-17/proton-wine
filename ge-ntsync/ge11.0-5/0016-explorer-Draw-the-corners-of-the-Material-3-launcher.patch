From 44296e8ef59ec64879a852988f890cc2d7fa6d58 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 26 Sep 2026 14:18:11 +0000
Subject: [PATCH 16/19] explorer: Draw the corners of the Material 3 launcher
 without a window region.

X servers without the shape extension ignore window regions and showed
the launcher as a square. The corners are painted with what is behind
the launcher instead, the desktop and then each window from the bottom
up, since not every X server returns the windows when reading the
desktop.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019oF8nnfMD8z5Z1MeNXoYS9
---
 programs/explorer/m3launcher.c | 61 +++++++++++++++++++++++++++++-----
 1 file changed, 52 insertions(+), 9 deletions(-)

diff --git a/programs/explorer/m3launcher.c b/programs/explorer/m3launcher.c
index 0132a69a3..e84385220 100644
--- a/programs/explorer/m3launcher.c
+++ b/programs/explorer/m3launcher.c
@@ -413,24 +413,69 @@ static void draw_item( HDC hdc, const struct launcher_item *item, const struct m
     }
 }
 
+/*
+ * The window is square and its rounded corners show what is behind it: a window region
+ * needs the shape extension, which not every X server has. Reading the screen doesn't
+ * return the windows over the desktop with every X server either, so they are read one
+ * by one, from the bottom up. x and y are the position of the window, the parts are in
+ * screen coordinates.
+ */
+static void draw_backdrop( HDC hdc, int x, int y, const RECT *parts, unsigned int count )
+{
+    HWND windows[256], hwnd;
+    unsigned int i, window_count = 0;
+    RECT rect, part;
+    HDC src;
+
+    src = GetDC( 0 );
+    for (i = 0; i < count; i++)
+        BitBlt( hdc, parts[i].left - x, parts[i].top - y, parts[i].right - parts[i].left,
+                parts[i].bottom - parts[i].top, src, parts[i].left, parts[i].top, SRCCOPY );
+    ReleaseDC( 0, src );
+
+    for (hwnd = GetWindow( GetDesktopWindow(), GW_CHILD ); hwnd && window_count < ARRAY_SIZE(windows);
+         hwnd = GetWindow( hwnd, GW_HWNDNEXT ))
+        windows[window_count++] = hwnd;
+    while (window_count--)
+    {
+        hwnd = windows[window_count];
+        if (!IsWindowVisible( hwnd ) || IsIconic( hwnd ) || (GetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_LAYERED))
+            continue;
+        GetWindowRect( hwnd, &rect );
+        for (i = 0; i < count; i++) if (IntersectRect( &part, &rect, &parts[i] )) break;
+        if (i == count || !(src = GetDCEx( hwnd, 0, DCX_WINDOW | DCX_CACHE ))) continue;
+        for (i = 0; i < count; i++)
+            if (IntersectRect( &part, &rect, &parts[i] ))
+                BitBlt( hdc, part.left - x, part.top - y, part.right - part.left, part.bottom - part.top,
+                        src, part.left - rect.left, part.top - rect.top, SRCCOPY );
+        ReleaseDC( hwnd, src );
+    }
+}
+
