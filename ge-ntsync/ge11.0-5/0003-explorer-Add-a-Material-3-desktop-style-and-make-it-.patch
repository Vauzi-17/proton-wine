+UINT m3_accent;               /* index in m3_palettes */
+UINT m3_mode = M3_MODE_SYSTEM;
+
+static const WCHAR taskbar_key[] = L"Software\\Wine\\Explorer\\Taskbar";
+
+void m3_load_settings(void)
+{
+    DWORD value, size;
+    HKEY hkey;
+
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, taskbar_key, 0, KEY_QUERY_VALUE, &hkey )) return;
+    size = sizeof(value);
+    if (!RegGetValueW( hkey, NULL, L"Accent", RRF_RT_REG_DWORD, NULL, &value, &size ))
+        m3_accent = value < M3_ACCENTS ? value : 0;
+    size = sizeof(value);
+    if (!RegGetValueW( hkey, NULL, L"Mode", RRF_RT_REG_DWORD, NULL, &value, &size ))
+        m3_mode = value < M3_MODES ? value : M3_MODE_SYSTEM;
+    RegCloseKey( hkey );
+}
+
+void m3_save_settings(void)
+{
+    DWORD value;
+    HKEY hkey;
+
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, taskbar_key, 0, NULL, 0, KEY_SET_VALUE, NULL, &hkey, NULL )) return;
+    value = m3_accent;
+    RegSetValueExW( hkey, L"Accent", 0, REG_DWORD, (const BYTE *)&value, sizeof(value) );
+    value = m3_mode;
+    RegSetValueExW( hkey, L"Mode", 0, REG_DWORD, (const BYTE *)&value, sizeof(value) );
+    RegCloseKey( hkey );
+}
+
+/* the apps switch between light and dark window colors */
+BOOL m3_is_dark(void)
+{
+    COLORREF color;
+
+    if (m3_mode == M3_MODE_LIGHT) return FALSE;
+    if (m3_mode == M3_MODE_DARK) return TRUE;
+    color = GetSysColor( COLOR_WINDOW );
+    return (GetRValue(color) * 299 + GetGValue(color) * 587 + GetBValue(color) * 114) / 1000 < 128;
+}
+
+const struct m3_colors *m3_scheme( UINT accent, BOOL dark )
+{
+    return (const struct m3_colors *)m3_palettes[accent < M3_ACCENTS ? accent : 0][dark ? 1 : 0];
+}
+
+const struct m3_colors *m3_get_colors(void)
+{
+    return m3_scheme( m3_accent, m3_is_dark() );
+}
+
+/* a color with a state layer of another color on top */
+COLORREF m3_blend( COLORREF base, COLORREF over, BYTE alpha )
+{
+    return RGB( GetRValue(base) + (GetRValue(over) - GetRValue(base)) * alpha / 255,
+                GetGValue(base) + (GetGValue(over) - GetGValue(base)) * alpha / 255,
+                GetBValue(base) + (GetBValue(over) - GetBValue(base)) * alpha / 255 );
+}
+
+/*
+ * Fonts: Roboto and Material Symbols (Apache 2.0) are resources of explorer.exe,
+ * loaded into this process only. See material_fonts.txt.
+ */
+
+static void add_font_resource( UINT id )
+{
+    HRSRC res = FindResourceW( NULL, MAKEINTRESOURCEW( id ), (const WCHAR *)RT_RCDATA );
+    DWORD size, count = 0;
+    HGLOBAL mem;
+    void *data;
+
+    if (!res || !(size = SizeofResource( NULL, res ))) return;
+    if (!(mem = LoadResource( NULL, res )) || !(data = LockResource( mem ))) return;
+    if (!AddFontMemResourceEx( data, size, NULL, &count )) WARN( "failed to add font %u\n", id );
+}
+
+static void init_fonts(void)
+{
+    static BOOL done;
+
+    if (done) return;
+    done = TRUE;
+    add_font_resource( IDR_FONT_ROBOTO );
+    add_font_resource( IDR_FONT_ROBOTO_MEDIUM );
+    add_font_resource( IDR_FONT_SYMBOLS );
+    add_font_resource( IDR_FONT_SYMBOLS_FILLED );
+}
+
+/* height is the em size in pixels, as the CSS font size */
+HFONT m3_create_font( int height, BOOL medium )
+{
+    LOGFONTW lf;
+
+    init_fonts();
+    memset( &lf, 0, sizeof(lf) );
+    lf.lfHeight = -height;
+    lf.lfWeight = medium ? FW_MEDIUM : FW_NORMAL;
+    lf.lfCharSet = DEFAULT_CHARSET;
+    lf.lfQuality = ANTIALIASED_QUALITY;
+    lstrcpyW( lf.lfFaceName, medium ? L"Roboto Medium" : L"Roboto" );
+    return CreateFontIndirectW( &lf );
+}
+
+HFONT m3_create_icon_font( int size, BOOL filled )
+{
+    LOGFONTW lf;
+
+    init_fonts();
+    memset( &lf, 0, sizeof(lf) );
+    lf.lfHeight = -size;
+    lf.lfWeight = FW_NORMAL;
+    lf.lfCharSet = DEFAULT_CHARSET;
+    lf.lfQuality = ANTIALIASED_QUALITY;
+    lstrcpyW( lf.lfFaceName, filled ? L"Wine M3 Symbols Filled" : L"Wine M3 Symbols" );
+    return CreateFontIndirectW( &lf );
+}
+
+/* Roboto has no CJK: text it can't show is drawn with Tahoma, which links to the CJK fonts */
+void m3_draw_text( HDC hdc, HFONT font, const WCHAR *text, RECT *rect, UINT flags, COLORREF color )
+{
+    HGDIOBJ old_font = SelectObject( hdc, font );
+    int i, len = lstrlenW( text );
+    HFONT fallback = 0;
+    WORD glyphs[256];
+
+    if (len && len <= ARRAY_SIZE(glyphs) &&
+        GetGlyphIndicesW( hdc, text, len, glyphs, GGI_MARK_NONEXISTING_GLYPHS ) != GDI_ERROR)
+    {
+        for (i = 0; i < len; i++) if (glyphs[i] == 0xffff) break;
+        if (i < len)
+        {
+            LOGFONTW lf;
+
+            GetObjectW( font, sizeof(lf), &lf );
+            lstrcpyW( lf.lfFaceName, L"Tahoma" );
+            if (lf.lfWeight > FW_NORMAL) lf.lfWeight = FW_BOLD;
+            if ((fallback = CreateFontIndirectW( &lf ))) SelectObject( hdc, fallback );
+        }
+    }
+    SetBkMode( hdc, TRANSPARENT );
+    SetTextColor( hdc, color );
+    DrawTextW( hdc, text, -1, rect, flags );
+    SelectObject( hdc, old_font );
+    if (fallback) DeleteObject( fallback );
+}
+
+void m3_draw_icon( HDC hdc, HFONT font, WCHAR glyph, const RECT *rect, COLORREF color )
+{
+    HGDIOBJ old_font = SelectObject( hdc, font );
+    WCHAR str[2] = { glyph, 0 };
+    RECT rc = *rect;
+
+    SetBkMode( hdc, TRANSPARENT );
+    SetTextColor( hdc, color );
+    DrawTextW( hdc, str, 1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_NOCLIP );
+    SelectObject( hdc, old_font );
+}
