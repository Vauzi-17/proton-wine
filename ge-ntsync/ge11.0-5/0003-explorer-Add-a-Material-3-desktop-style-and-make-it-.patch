+/*
+ * Shapes. GDI has no anti-aliasing, so the coverage of each pixel is computed from the
+ * signed distance to the shape and the result is alpha blended onto the target.
+ */
+
+struct shape
+{
+    float cx, cy;  /* center */
+    float hw, hh;  /* half size */
+    float radius;
+};
+
+static float shape_distance( const struct shape *s, float x, float y )
+{
+    float qx = fabsf( x - s->cx ) - (s->hw - s->radius);
+    float qy = fabsf( y - s->cy ) - (s->hh - s->radius);
+    float ox = qx > 0 ? qx : 0, oy = qy > 0 ? qy : 0;
+    float inside = qx > qy ? qx : qy;
+
+    return sqrtf( ox * ox + oy * oy ) + (inside < 0 ? inside : 0) - s->radius;
+}
+
+static float clamp01( float value )
+{
+    return value < 0 ? 0 : value > 1 ? 1 : value;
+}
+
+enum shape_paint { PAINT_FILL, PAINT_FRAME, PAINT_SHADOW };
+
+/* paint the shape into a premultiplied ARGB bitmap of width x height and blend it at (x, y) */
+static void paint_shape( HDC hdc, int x, int y, int width, int height, const struct shape *s,
+                         enum shape_paint mode, float param, COLORREF color, BYTE alpha )
+{
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    BYTE r = GetRValue(color), g = GetGValue(color), b = GetBValue(color);
+    BITMAPINFO info;
+    HGDIOBJ old;
+    HBITMAP dib;
+    DWORD *bits;
+    int i, j;
+    HDC mem;
+
+    if (width <= 0 || height <= 0 || !alpha) return;
+    memset( &info, 0, sizeof(info) );
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    if (!(dib = CreateDIBSection( 0, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0 ))) return;
+
+    for (j = 0; j < height; j++)
+    {
+        for (i = 0; i < width; i++)
+        {
+            float d = shape_distance( s, i + 0.5f, j + 0.5f ), cover;
+            unsigned int a;
+
+            switch (mode)
+            {
+            case PAINT_FRAME:  /* param: line width */
+                cover = clamp01( 0.5f - d ) - clamp01( 0.5f - (d + param) );
+                break;
+            case PAINT_SHADOW:  /* param: spread, fading out quadratically */
+                cover = d <= 0 ? 1 : d >= param ? 0 : (1 - d / param) * (1 - d / param);
+                break;
+            default:
+                cover = clamp01( 0.5f - d );
+                break;
+            }
+            a = (unsigned int)(cover * alpha + 0.5f);
+            bits[j * width + i] = a ? (a << 24) | ((r * a / 255) << 16) | ((g * a / 255) << 8) | (b * a / 255) : 0;
+        }
+    }
+
+    mem = CreateCompatibleDC( hdc );
+    old = SelectObject( mem, dib );
+    GdiAlphaBlend( hdc, x, y, width, height, mem, 0, 0, width, height, blend );
+    SelectObject( mem, old );
+    DeleteDC( mem );
+    DeleteObject( dib );
+}
+
+static void init_shape( struct shape *s, int width, int height, int radius )
+{
+    s->cx = s->hw = width / 2.0f;
+    s->cy = s->hh = height / 2.0f;
+    s->radius = min( radius, min( width, height ) / 2 );
+}
+
+void m3_fill_round_rect( HDC hdc, int x, int y, int width, int height, int radius, COLORREF color, BYTE alpha )
+{
+    struct shape s;
+
+    if (radius <= 0 && alpha == 255)
+    {
+        HGDIOBJ old_brush = SelectObject( hdc, GetStockObject( DC_BRUSH ));
+
+        SetDCBrushColor( hdc, color );
+        PatBlt( hdc, x, y, width, height, PATCOPY );
+        SelectObject( hdc, old_brush );
+        return;
+    }
+    init_shape( &s, width, height, radius );
+    paint_shape( hdc, x, y, width, height, &s, PAINT_FILL, 0, color, alpha );
+}
+
+void m3_frame_round_rect( HDC hdc, int x, int y, int width, int height, int radius, int line,
+                          COLORREF color, BYTE alpha )
+{
+    struct shape s;
+
+    init_shape( &s, width, height, radius );
+    paint_shape( hdc, x, y, width, height, &s, PAINT_FRAME, line, color, alpha );
+}
+
+/* elevation shadow of a shape: level 1 to 3, mostly below the shape */
+void m3_draw_shadow( HDC hdc, int x, int y, int width, int height, int radius, int level )
+{
+    int spread = 2 + 3 * level, offset = level + 1;
+    struct shape s;
+
+    init_shape( &s, width, height, radius );
+    s.cx += spread;
+    s.cy += spread;
+    paint_shape( hdc, x - spread, y - spread + offset, width + 2 * spread, height + 2 * spread, &s,
+                 PAINT_SHADOW, spread, RGB(0,0,0), 40 + 10 * level );
+}
