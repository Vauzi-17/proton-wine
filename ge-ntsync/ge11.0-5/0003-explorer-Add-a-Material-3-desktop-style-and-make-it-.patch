+            RGB(0x4a,0x44,0x58), RGB(0xe8,0xde,0xf8), RGB(0x63,0x3b,0x48), RGB(0xff,0xd9,0xe3),
+            RGB(0xff,0xb4,0xab), RGB(0x14,0x12,0x18), RGB(0xe6,0xe0,0xe9), RGB(0xca,0xc4,0xcf),
