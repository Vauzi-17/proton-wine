+            RGB(0xd9,0xd9,0xe0), RGB(0xff,0xff,0xff), RGB(0xf3,0xf3,0xfa), RGB(0xed,0xed,0xf4),
+            RGB(0xe8,0xe7,0xee), RGB(0xe2,0xe2,0xe9), RGB(0x74,0x77,0x7f), RGB(0xc4,0xc6,0xd0),
