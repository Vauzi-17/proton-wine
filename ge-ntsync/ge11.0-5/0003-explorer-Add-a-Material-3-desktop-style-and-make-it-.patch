diff --git a/programs/explorer/m3launcher.c b/programs/explorer/m3launcher.c
new file mode 100644
index 000000000..3550b1243
--- /dev/null
+++ b/programs/explorer/m3launcher.c
@@ -0,0 +1,727 @@
+/*
+ * Material 3 launcher, the start menu of the Material 3 taskbar
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
