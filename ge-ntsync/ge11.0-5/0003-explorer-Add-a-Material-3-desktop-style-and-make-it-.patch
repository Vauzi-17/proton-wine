+/* the color roles of a Material 3 scheme, in the order of the palette tables */
+struct m3_colors
+{
+    COLORREF primary, on_primary, primary_container, on_primary_container;
+    COLORREF secondary_container, on_secondary_container, tertiary_container, on_tertiary_container;
+    COLORREF error, surface, on_surface, on_surface_variant;
+    COLORREF surface_dim, surface_container_lowest, surface_container_low, surface_container;
+    COLORREF surface_container_high, surface_container_highest, outline, outline_variant;
+    COLORREF inverse_surface, inverse_on_surface;
+};
+
+#define M3_ACCENTS 6  /* purple, blue, teal, green, orange, pink */
+
+enum m3_mode
+{
+    M3_MODE_SYSTEM,  /* light or dark following the window colors (the app's light/dark setting) */
+    M3_MODE_LIGHT,
+    M3_MODE_DARK,
+    M3_MODES
+};
+
+/* state layer opacities, out of 255 */
+#define M3_STATE_HOVER    20  /* 8% */
+#define M3_STATE_PRESSED  26  /* 10% */
+
+/* Material Symbols codepoints, see material_fonts.txt */
+#define M3_ICON_APPS            0xe5c3
