+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stddef.h>
+#include <stdlib.h>
+
+#define COBJMACROS
+#include <windows.h>
+#include <shellapi.h>
+#include <shlobj.h>
+#include <shlwapi.h>
+
+#include "explorer_private.h"
+#include "material.h"
+#include "resource.h"
+
+/*
+ * A sheet above the taskbar: the user, the built-in programs, the start menu shortcuts
+ * and the places. The rounded corners are a window region: the screen under the window
+ * can't be read back (a window of another process is not in the desktop surface), so
+ * the sheet has no shadow and its tonal color sets it apart.
+ */
+
+enum item_action
+{
+    ACTION_PROGRAM,       /* target: file or shortcut to open */
+    ACTION_FOLDER,        /* csidl */
+    ACTION_RUN,
+    ACTION_SETTINGS,
+    ACTION_SHUT_DOWN,
+    ACTION_ALL_PROGRAMS,
+};
+
+enum item_kind
+{
+    KIND_TILE,            /* a tonal tile with a symbol, and the name under it */
+    KIND_SHORTCUT,        /* a tile with the icon of a program */
+    KIND_CHIP,            /* an outlined chip with a symbol and a label */
+    KIND_ICON_BUTTON,     /* a round button with a symbol */
+};
+
+struct launcher_item
+{
+    enum item_action action;
+    enum item_kind   kind;
+    WCHAR            text[MAX_PATH];
+    WCHAR            target[MAX_PATH];
+    int              csidl;
+    WCHAR            glyph;
+    UINT             tone;   /* primary, secondary or tertiary container */
+    HICON            icon;
+    RECT             rect;
+};
+
+#define MAX_ITEMS      40
+#define MAX_SHORTCUTS  8   /* two rows, All programs has the rest */
+#define GRID_COLUMNS   4
+
+static struct launcher_item items[MAX_ITEMS];
+static unsigned int item_count, apps_end, shortcuts_end;
+static int hot_item = -1, pressed_item = -1, selected_item = -1;
+static BOOL launcher_done;
+static HWND launcher_window, launcher_tray;
+static UINT launcher_dpi = USER_DEFAULT_SCREEN_DPI;
+static HBITMAP launcher_base;     /* the whole window, without the hover and pressed states */
+static HFONT title_font, label_font, chip_font, icon_font, filled_icon_font, chip_icon_font;
+static RECT sheet;                /* in window coordinates, the whole window */
+static int labels_top[2];         /* "Apps" and "Installed" */
+static WCHAR user_name[64];
+
+static int px( int size )
+{
+    return MulDiv( size, launcher_dpi, USER_DEFAULT_SCREEN_DPI );
+}
+
+static struct launcher_item *add_item( enum item_action action, enum item_kind kind, UINT string_id, WCHAR glyph )
+{
+    struct launcher_item *item;
+    WCHAR *src, *dst;
+
+    if (item_count >= ARRAY_SIZE(items)) return NULL;
+    item = &items[item_count++];
+    memset( item, 0, sizeof(*item) );
+    item->action = action;
+    item->kind = kind;
+    item->glyph = glyph;
+    if (string_id)
+    {
+        LoadStringW( NULL, string_id, item->text, ARRAY_SIZE(item->text) );
+        /* some strings are shared with the menus and carry accelerator prefixes */
+        for (src = dst = item->text; *src; src++) if (*src != '&') *dst++ = *src;
+        *dst = 0;
+    }
+    return item;
+}
+
+static void add_program( UINT string_id, WCHAR glyph, const WCHAR *name, const WCHAR *alt_name )
+{
+    struct launcher_item *item;
+    WCHAR path[MAX_PATH];
+
+    if (!SearchPathW( NULL, name, NULL, MAX_PATH, path, NULL ) &&
+        (!alt_name || !SearchPathW( NULL, alt_name, NULL, MAX_PATH, path, NULL )))
+        return;
+    if (!(item = add_item( ACTION_PROGRAM, KIND_TILE, string_id, glyph ))) return;
+    lstrcpyW( item->target, path );
+}
+
+static void add_folder( enum item_kind kind, UINT string_id, WCHAR glyph, int csidl )
+{
+    struct launcher_item *item = add_item( ACTION_FOLDER, kind, string_id, glyph );
+
+    if (item) item->csidl = csidl;
+}
+
+/* the shortcuts of the start menu, one folder level deep, without uninstallers */
+static void collect_shortcuts( struct launcher_item *list, unsigned int *count, unsigned int max,
+                               const WCHAR *dir, int depth )
+{
+    WCHAR pattern[MAX_PATH], path[MAX_PATH], name[MAX_PATH];
+    WIN32_FIND_DATAW data;
+    unsigned int i;
+    HANDLE handle;
+
+    if (lstrlenW( dir ) + 3 >= MAX_PATH) return;
+    lstrcpyW( pattern, dir );
+    lstrcatW( pattern, L"\\*" );
+    if ((handle = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (data.dwFileAttributes & (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM)) continue;
+        if (!lstrcmpW( data.cFileName, L"." ) || !lstrcmpW( data.cFileName, L".." )) continue;
+        if (lstrlenW( dir ) + 1 + lstrlenW( data.cFileName ) >= MAX_PATH) continue;
+        lstrcpyW( path, dir );
+        lstrcatW( path, L"\\" );
+        lstrcatW( path, data.cFileName );
+
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        {
+            /* the Wine tools and the startup programs don't belong with the games */
+            if (depth > 0 && lstrcmpiW( data.cFileName, L"StartUp" ) &&
+                lstrcmpiW( data.cFileName, L"Administrative Tools" ) && lstrcmpiW( data.cFileName, L"Wine" ))
+                collect_shortcuts( list, count, max, path, depth - 1 );
+            continue;
+        }
+        if (lstrcmpiW( PathFindExtensionW( data.cFileName ), L".lnk" )) continue;
+
+        lstrcpynW( name, data.cFileName, ARRAY_SIZE(name) );
+        PathRemoveExtensionW( name );
+        if (StrStrIW( name, L"uninstall" )) continue;
+        /* the same shortcut can be in the user and in the common start menu */
+        for (i = 0; i < *count; i++) if (!lstrcmpiW( list[i].text, name )) break;
+        if (i < *count || *count >= max) continue;
+
+        memset( &list[*count], 0, sizeof(list[*count]) );
+        list[*count].action = ACTION_PROGRAM;
+        list[*count].kind = KIND_SHORTCUT;
+        lstrcpyW( list[*count].text, name );
+        lstrcpyW( list[*count].target, path );
+        (*count)++;
+    } while (FindNextFileW( handle, &data ));
+    FindClose( handle );
+}
+
+static int __cdecl compare_items( const void *a, const void *b )
+{
+    return lstrcmpiW( ((const struct launcher_item *)a)->text, ((const struct launcher_item *)b)->text );
+}
+
+static void add_shortcuts(void)
+{
+    static const int folders[][2] = { { CSIDL_STARTMENU, 0 }, { CSIDL_COMMON_STARTMENU, 0 },
+                                      { CSIDL_PROGRAMS, 1 }, { CSIDL_COMMON_PROGRAMS, 1 } };
+    struct launcher_item found[64];
+    unsigned int i, count = 0;
+    WCHAR dir[MAX_PATH];
+
+    for (i = 0; i < ARRAY_SIZE(folders); i++)
+        if (SUCCEEDED(SHGetFolderPathW( NULL, folders[i][0], NULL, SHGFP_TYPE_CURRENT, dir )))
+            collect_shortcuts( found, &count, ARRAY_SIZE(found), dir, folders[i][1] );
+    qsort( found, count, sizeof(found[0]), compare_items );
+
+    for (i = 0; i < count && i < MAX_SHORTCUTS && item_count < ARRAY_SIZE(items); i++)
+    {
+        struct launcher_item *item = &items[item_count++];
+
+        *item = found[i];
+        /* SHGetFileInfo only gives the generic shortcut icon, use the icon of the target */
+        if (!(item->icon = get_shortcut_icon( item->target )))
+        {
+            SHFILEINFOW info;
+
+            if (SHGetFileInfoW( item->target, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON ))
+                item->icon = info.hIcon;
+        }
+    }
+}
+
+static void build_items(void)
+{
+    unsigned int i;
+
+    item_count = 0;
+    add_item( ACTION_SETTINGS, KIND_ICON_BUTTON, IDS_M3_SETTINGS, M3_ICON_PALETTE );
+    add_item( ACTION_SHUT_DOWN, KIND_ICON_BUTTON, IDS_M3_SHUT_DOWN, M3_ICON_POWER );
+
+    add_program( IDS_M3_FILES, M3_ICON_FOLDER, L"wfm.exe", L"winefile.exe" );
+    add_program( IDS_XP_COMMAND_PROMPT, M3_ICON_TERMINAL, L"cmd.exe", NULL );
+    add_program( IDS_M3_NOTEPAD, M3_ICON_EDIT_NOTE, L"notepad.exe", NULL );
+    add_program( IDS_XP_WINECFG, M3_ICON_TUNE, L"winecfg.exe", NULL );
+    add_folder( KIND_TILE, IDS_XP_CONTROL_PANEL, M3_ICON_SETTINGS, CSIDL_CONTROLS );
+    add_program( IDS_TASK_MANAGER, M3_ICON_MONITORING, L"taskmgr.exe", NULL );
+    add_program( IDS_M3_REGEDIT, M3_ICON_ACCOUNT_TREE, L"regedit.exe", NULL );
+    add_item( ACTION_RUN, KIND_TILE, IDS_M3_RUN, M3_ICON_PLAY_ARROW );
+    for (i = 2; i < item_count; i++) items[i].tone = (i - 2) % 3;
+    apps_end = item_count;
+
+    add_shortcuts();
+    shortcuts_end = item_count;
+
+    add_folder( KIND_CHIP, IDS_M3_DOCUMENTS, M3_ICON_DESCRIPTION, CSIDL_PERSONAL );
+    add_folder( KIND_CHIP, IDS_M3_PICTURES, M3_ICON_IMAGE, CSIDL_MYPICTURES );
+    add_folder( KIND_CHIP, IDS_M3_MUSIC, M3_ICON_MUSIC_NOTE, CSIDL_MYMUSIC );
+    add_program( IDS_M3_DRIVES, M3_ICON_HARD_DRIVE, L"wfm.exe", NULL );
+    if (items[item_count - 1].glyph == M3_ICON_HARD_DRIVE) items[item_count - 1].kind = KIND_CHIP;
+    else add_folder( KIND_CHIP, IDS_M3_DRIVES, M3_ICON_HARD_DRIVE, CSIDL_DRIVES );
+    add_item( ACTION_ALL_PROGRAMS, KIND_CHIP, IDS_M3_ALL_PROGRAMS, M3_ICON_GRID_VIEW );
+}
+
+static void free_items(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < item_count; i++) if (items[i].icon) DestroyIcon( items[i].icon );
+    item_count = 0;
+}
+
+static void create_fonts(void)
+{
+    title_font = m3_create_font( px( 16 ), TRUE );
+    label_font = m3_create_font( px( 12 ), FALSE );
+    chip_font = m3_create_font( px( 14 ), TRUE );
+    icon_font = m3_create_icon_font( px( 24 ), FALSE );
+    filled_icon_font = m3_create_icon_font( px( 24 ), TRUE );
+    chip_icon_font = m3_create_icon_font( px( 18 ), FALSE );
+}
+
+static void delete_fonts(void)
+{
+    HFONT *fonts[] = { &title_font, &label_font, &chip_font, &icon_font, &filled_icon_font, &chip_icon_font };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(fonts); i++)
+    {
+        if (*fonts[i]) DeleteObject( *fonts[i] );
+        *fonts[i] = 0;
+    }
+}
+
+static int text_width( HFONT font, const WCHAR *text )
+{
+    HDC hdc = GetDC( 0 );
+    HGDIOBJ old = SelectObject( hdc, font );
+    SIZE size = { 0, 0 };
+
+    GetTextExtentPoint32W( hdc, text, lstrlenW( text ), &size );
+    SelectObject( hdc, old );
+    ReleaseDC( 0, hdc );
+    return size.cx;
+}
+
+/* place the items in a grid of tiles, returns the bottom of the grid */
+static int layout_grid( unsigned int first, unsigned int end, int top, int left, int width )
+{
+    int cell_width = width / GRID_COLUMNS, cell_height = px( 104 );
+    unsigned int i;
+
+    for (i = first; i < end; i++)
+    {
+        int col = (i - first) % GRID_COLUMNS, row = (i - first) / GRID_COLUMNS;
+
+        SetRect( &items[i].rect, left + col * cell_width, top + row * cell_height,
+                 left + (col + 1) * cell_width, top + (row + 1) * cell_height );
+    }
+    if (end <= first) return top;
+    return top + ((end - first + GRID_COLUMNS - 1) / GRID_COLUMNS) * cell_height;
+}
+
+static void layout( int max_width, int *width, int *height )
+{
+    int pad = px( 20 ), sheet_width = min( px( 520 ), max_width ), inner, x, y, chip_height = px( 32 );
+    unsigned int i;
+
+    inner = sheet_width - 2 * pad;
+    SetRect( &sheet, 0, 0, sheet_width, 0 );
+
+    /* header: the settings and power buttons on the right */
+    y = sheet.top + pad;
+    SetRect( &items[1].rect, sheet.right - pad - px( 48 ), y, sheet.right - pad, y + px( 48 ));
+    SetRect( &items[0].rect, items[1].rect.left - px( 48 ), y, items[1].rect.left, y + px( 48 ));
+    y += px( 48 ) + px( 12 );
+
+    labels_top[0] = y;
+    y = layout_grid( 2, apps_end, y + px( 24 ), sheet.left + pad, inner );
+    labels_top[1] = -1;
+    if (shortcuts_end > apps_end)
+    {
+        labels_top[1] = y + px( 4 );
+        y = layout_grid( apps_end, shortcuts_end, labels_top[1] + px( 24 ), sheet.left + pad, inner );
+    }
+
+    /* the chips flow over as many rows as they need */
+    y += px( 12 );
+    x = sheet.left + pad;
+    for (i = shortcuts_end; i < item_count; i++)
+    {
+        int chip_width = px( 8 + 18 + 8 + 16 ) + text_width( chip_font, items[i].text );
+
+        if (x > sheet.left + pad && x + chip_width > sheet.left + pad + inner)
+        {
+            x = sheet.left + pad;
+            y += chip_height + px( 8 );
+        }
+        SetRect( &items[i].rect, x, y, x + chip_width, y + chip_height );
+        x += chip_width + px( 8 );
+    }
+    y += chip_height + pad;
+
+    sheet.bottom = y;
+    *width = sheet.right;
+    *height = sheet.bottom;
+}
+
+static int item_radius( const struct launcher_item *item )
+{
+    switch (item->kind)
+    {
+    case KIND_CHIP: return px( 8 );
+    case KIND_ICON_BUTTON: return (item->rect.bottom - item->rect.top) / 2;
+    default: return px( 16 );
+    }
+}
+
+static void draw_item( HDC hdc, const struct launcher_item *item, const struct m3_colors *colors )
+{
+    const RECT *rc = &item->rect;
+    int width = rc->right - rc->left, tile = px( 56 ), x, y;
+    RECT rect;
+
+    switch (item->kind)
+    {
+    case KIND_ICON_BUTTON:
+        m3_draw_icon( hdc, icon_font, item->glyph, rc, colors->on_surface_variant );
+        break;
+
+    case KIND_CHIP:
+        m3_frame_round_rect( hdc, rc->left, rc->top, width, rc->bottom - rc->top, px( 8 ), px( 1 ),
+                             colors->outline_variant, 255 );
+        SetRect( &rect, rc->left + px( 8 ), rc->top, rc->left + px( 8 + 18 ), rc->bottom );
+        m3_draw_icon( hdc, chip_icon_font, item->glyph, &rect, colors->primary );
+        SetRect( &rect, rc->left + px( 8 + 18 + 8 ), rc->top, rc->right - px( 16 ), rc->bottom );
+        m3_draw_text( hdc, chip_font, item->text, &rect, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_NOPREFIX,
+                      colors->on_surface );
+        break;
+
+    case KIND_TILE:
+    case KIND_SHORTCUT:
+        x = rc->left + (width - tile) / 2;
+        y = rc->top + px( 8 );
+        SetRect( &rect, x, y, x + tile, y + tile );
+        if (item->kind == KIND_TILE)
+        {
+            static const size_t tones[3][2] =
+            {
+                { offsetof( struct m3_colors, primary_container ), offsetof( struct m3_colors, on_primary_container ) },
+                { offsetof( struct m3_colors, secondary_container ), offsetof( struct m3_colors, on_secondary_container ) },
+                { offsetof( struct m3_colors, tertiary_container ), offsetof( struct m3_colors, on_tertiary_container ) },
+            };
+            const BYTE *base = (const BYTE *)colors;
+
+            m3_fill_round_rect( hdc, x, y, tile, tile, px( 16 ), *(const COLORREF *)(base + tones[item->tone][0]), 255 );
+            m3_draw_icon( hdc, icon_font, item->glyph, &rect, *(const COLORREF *)(base + tones[item->tone][1]) );
+        }
+        else
+        {
+            int size = px( 32 );
+
+            m3_fill_round_rect( hdc, x, y, tile, tile, px( 16 ), colors->surface_container_highest, 255 );
+            if (item->icon)
+                DrawIconEx( hdc, x + (tile - size) / 2, y + (tile - size) / 2, item->icon, size, size, 0, NULL, DI_NORMAL );
+            else
+                m3_draw_icon( hdc, icon_font, M3_ICON_SPORTS_ESPORTS, &rect, colors->primary );
+        }
+        SetRect( &rect, rc->left + px( 4 ), y + tile + px( 6 ), rc->right - px( 4 ), rc->bottom - px( 2 ));
+        m3_draw_text( hdc, label_font, item->text, &rect, DT_CENTER | DT_WORDBREAK | DT_NOPREFIX | DT_END_ELLIPSIS,
+                      colors->on_surface );
+        break;
+    }
+}
+
+/* the sheet and the items */
+static HBITMAP build_base( HDC ref, int width, int height )
+{
+    const struct m3_colors *colors = m3_get_colors();
+    int avatar = px( 40 ), pad = px( 20 );
+    HGDIOBJ old, old_brush;
+    HBITMAP bitmap;
+    unsigned int i;
+    RECT rect;
+    HDC hdc;
+
+    if (!(hdc = CreateCompatibleDC( ref ))) return 0;
+    bitmap = CreateCompatibleBitmap( ref, width, height );
+    old = SelectObject( hdc, bitmap );
+    old_brush = SelectObject( hdc, GetStockObject( DC_BRUSH ));
+    SetDCBrushColor( hdc, colors->surface_container_high );
+    PatBlt( hdc, 0, 0, width, height, PATCOPY );
+    SelectObject( hdc, old_brush );
+
+    /* the user */
+    rect.left = sheet.left + pad;
+    rect.top = items[0].rect.top + (items[0].rect.bottom - items[0].rect.top - avatar) / 2;
+    m3_fill_round_rect( hdc, rect.left, rect.top, avatar, avatar, avatar / 2, colors->primary, 255 );
+    rect.right = rect.left + avatar;
+    rect.bottom = rect.top + avatar;
+    m3_draw_icon( hdc, filled_icon_font, M3_ICON_PERSON, &rect, colors->on_primary );
+    SetRect( &rect, rect.right + px( 12 ), items[0].rect.top, items[0].rect.left - px( 8 ), items[0].rect.bottom );
+    m3_draw_text( hdc, title_font, user_name, &rect, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_NOPREFIX | DT_END_ELLIPSIS,
+                  colors->on_surface );
+
+    /* section labels */
+    for (i = 0; i < ARRAY_SIZE(labels_top); i++)
+    {
+        WCHAR label[64];
+
+        if (labels_top[i] < 0) continue;
+        LoadStringW( NULL, i ? IDS_M3_INSTALLED : IDS_M3_APPS, label, ARRAY_SIZE(label) );
+        SetRect( &rect, sheet.left + pad + px( 4 ), labels_top[i], sheet.right - pad, labels_top[i] + px( 20 ));
+        m3_draw_text( hdc, chip_font, label, &rect, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_NOPREFIX,
+                      colors->on_surface_variant );
+    }
+
+    for (i = 0; i < item_count; i++) draw_item( hdc, &items[i], colors );
+
+    SelectObject( hdc, old );
+    DeleteDC( hdc );
+    return bitmap;
+}
+
+static void paint( HWND hwnd )
+{
+    const struct m3_colors *colors = m3_get_colors();
+    HGDIOBJ old_bitmap, old_base;
+    PAINTSTRUCT ps;
+    HBITMAP bitmap;
+    RECT client;
+    HDC hdc, mem, base;
+
+    hdc = BeginPaint( hwnd, &ps );
+    GetClientRect( hwnd, &client );
+    if (launcher_base && (mem = CreateCompatibleDC( hdc )))
+    {
+        base = CreateCompatibleDC( hdc );
+        bitmap = CreateCompatibleBitmap( hdc, client.right, client.bottom );
+        old_bitmap = SelectObject( mem, bitmap );
+        old_base = SelectObject( base, launcher_base );
+        BitBlt( mem, 0, 0, client.right, client.bottom, base, 0, 0, SRCCOPY );
+
+        /* state layers of the item under the pointer */
+        if (hot_item >= 0)
+        {
+            const RECT *rc = &items[hot_item].rect;
+
+            m3_fill_round_rect( mem, rc->left, rc->top, rc->right - rc->left, rc->bottom - rc->top,
+                                item_radius( &items[hot_item] ), colors->on_surface,
+                                hot_item == pressed_item ? M3_STATE_PRESSED : M3_STATE_HOVER );
+        }
+        BitBlt( hdc, 0, 0, client.right, client.bottom, mem, 0, 0, SRCCOPY );
+        SelectObject( base, old_base );
+        SelectObject( mem, old_bitmap );
+        DeleteObject( bitmap );
+        DeleteDC( base );
+        DeleteDC( mem );
+    }
+    EndPaint( hwnd, &ps );
+}
+
+static int hit_test( POINT pt )
+{
+    unsigned int i;
+
+    for (i = 0; i < item_count; i++) if (PtInRect( &items[i].rect, pt )) return i;
+    return -1;
+}
+
+static void set_hot( int index )
+{
+    if (index == hot_item) return;
+    if (hot_item >= 0) InvalidateRect( launcher_window, &items[hot_item].rect, FALSE );
+    hot_item = index;
+    if (hot_item >= 0) InvalidateRect( launcher_window, &items[hot_item].rect, FALSE );
+}
+
+static void move_hot( int dir )
+{
+    int count = item_count;
+
+    if (!count) return;
+    set_hot( hot_item < 0 ? (dir > 0 ? 0 : count - 1) : (hot_item + dir + count) % count );
+}
+
+static void execute( const struct launcher_item *item )
+{
+    SHELLEXECUTEINFOW sei;
+    LPITEMIDLIST pidl;
+
+    switch (item->action)
+    {
+    case ACTION_PROGRAM:
+        ShellExecuteW( NULL, NULL, item->target, NULL, NULL, SW_SHOWNORMAL );
+        break;
+    case ACTION_FOLDER:
+        if (FAILED(SHGetSpecialFolderLocation( NULL, item->csidl, &pidl ))) break;
+        memset( &sei, 0, sizeof(sei) );
+        sei.cbSize = sizeof(sei);
+        sei.fMask = SEE_MASK_IDLIST;
+        sei.nShow = SW_SHOWNORMAL;
+        sei.lpIDList = pidl;
+        ShellExecuteExW( &sei );
+        CoTaskMemFree( pidl );
+        break;
+    case ACTION_RUN:
+        run_dialog();
+        break;
+    case ACTION_SETTINGS:
+        show_display_settings();
+        break;
+    case ACTION_SHUT_DOWN:
+        shut_down( launcher_tray );
+        break;
+    case ACTION_ALL_PROGRAMS:
+        do_startmenu( launcher_tray );
+        break;
+    }
+}
+
+static LRESULT CALLBACK launcher_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    RECT client;
+    POINT pt;
+    int index;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+        paint( hwnd );
+        return 0;
+
+    case WM_ERASEBKGND:
+        return 1;
+
+    case WM_MOUSEMOVE:
+        pt.x = (short)LOWORD( lparam );
+        pt.y = (short)HIWORD( lparam );
+        set_hot( hit_test( pt ));
+        return 0;
+
+    case WM_LBUTTONDOWN:
+    case WM_RBUTTONDOWN:
+    case WM_MBUTTONDOWN:
+        pt.x = (short)LOWORD( lparam );
+        pt.y = (short)HIWORD( lparam );
+        GetClientRect( hwnd, &client );
+        if (!PtInRect( &client, pt ))
+        {
+            launcher_done = TRUE;
+            return 0;
+        }
+        if (msg != WM_LBUTTONDOWN) return 0;
+        pressed_item = hit_test( pt );
+        set_hot( pressed_item );
+        if (pressed_item >= 0) InvalidateRect( hwnd, &items[pressed_item].rect, FALSE );
+        return 0;
+
+    case WM_LBUTTONUP:
+        pt.x = (short)LOWORD( lparam );
+        pt.y = (short)HIWORD( lparam );
+        index = hit_test( pt );
+        if (index >= 0 && index == pressed_item)
+        {
+            selected_item = index;
+            launcher_done = TRUE;
+        }
+        else if (pressed_item >= 0) InvalidateRect( hwnd, &items[pressed_item].rect, FALSE );
+        pressed_item = -1;
+        return 0;
+
+    case WM_KEYDOWN:
+        switch (wparam)
+        {
+        case VK_ESCAPE:
+            launcher_done = TRUE;
+            break;
+        case VK_LEFT:
+        case VK_UP:
+            move_hot( -1 );
+            break;
+        case VK_RIGHT:
+        case VK_DOWN:
+        case VK_TAB:
+            move_hot( 1 );
+            break;
+        case VK_RETURN:
+        case VK_SPACE:
+            if (hot_item >= 0)
+            {
+                selected_item = hot_item;
+                launcher_done = TRUE;
+            }
+            break;
+        }
+        return 0;
+
+    case WM_ACTIVATE:
+        if (LOWORD( wparam ) == WA_INACTIVE) launcher_done = TRUE;
+        break;
+
+    case WM_CAPTURECHANGED:
+        if ((HWND)lparam != hwnd) launcher_done = TRUE;
+        break;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+void do_m3_launcher( HWND tray )
+{
+    static const WCHAR classW[] = L"__wine_m3_launcher";
+    static BOOL registered;
+    int width, height, x, y, radius;
+    RECT tray_rect;
+    DWORD size;
+    MSG msg;
+    HDC hdc;
+
+    if (launcher_window) return;
+    if (!registered)
+    {
+        WNDCLASSEXW cls;
+
+        memset( &cls, 0, sizeof(cls) );
+        cls.cbSize = sizeof(cls);
+        cls.lpfnWndProc = launcher_proc;
+        cls.hCursor = LoadCursorW( 0, (const WCHAR *)IDC_ARROW );
+        cls.lpszClassName = classW;
+        registered = RegisterClassExW( &cls ) != 0;
+    }
+
+    launcher_tray = tray;
+    launcher_dpi = GetDpiForWindow( tray );
+    if (!launcher_dpi) launcher_dpi = USER_DEFAULT_SCREEN_DPI;
+    size = ARRAY_SIZE(user_name);
+    if (!GetUserNameW( user_name, &size )) lstrcpyW( user_name, L"User" );
+    create_fonts();
+    build_items();
+
+    GetWindowRect( tray, &tray_rect );
+    layout( GetSystemMetrics( SM_CXSCREEN ) - 2 * px( 8 ), &width, &height );
+    /* the sheet sits 8 pixels above the taskbar */
+    x = tray_rect.left + px( 8 );
+    y = max( 0, tray_rect.top - px( 8 ) - height );
+
+    hdc = GetDC( 0 );
+    launcher_base = build_base( hdc, width, height );
+    ReleaseDC( 0, hdc );
+
+    launcher_window = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW, classW, NULL, WS_POPUP,
+                                       x, y, width, height, tray, 0, 0, 0 );
+    if (launcher_window)
+    {
+        radius = px( 28 );
+        SetWindowRgn( launcher_window, CreateRoundRectRgn( 0, 0, width + 1, height + 1, 2 * radius, 2 * radius ), FALSE );
+        hot_item = pressed_item = selected_item = -1;
+        launcher_done = FALSE;
+        ShowWindow( launcher_window, SW_SHOWNORMAL );
+        SetForegroundWindow( launcher_window );
+        SetFocus( launcher_window );
+        SetCapture( launcher_window );
+        UpdateWindow( launcher_window );
+
+        while (!launcher_done)
+        {
+            if (!GetMessageW( &msg, 0, 0, 0 ))
+            {
+                PostQuitMessage( msg.wParam );
+                break;
+            }
+            TranslateMessage( &msg );
+            DispatchMessageW( &msg );
+        }
+
+        if (GetCapture() == launcher_window) ReleaseCapture();
+        DestroyWindow( launcher_window );
+        launcher_window = 0;
+        /* launch after the launcher is gone so that the program can take the foreground */
+        if (selected_item >= 0) execute( &items[selected_item] );
+    }
+
+    if (launcher_base) DeleteObject( launcher_base );
+    launcher_base = 0;
+    free_items();
+    delete_fonts();
+}
