+/* the preview of the Material 3 style: background, a window and the taskbar */
+static void draw_m3_preview( HDC hdc, int width, int height, const struct display_settings *settings )
+{
+    BOOL dark = settings->mode == M3_MODE_LIGHT ? FALSE : settings->mode == M3_MODE_DARK ? TRUE : is_dark_theme();
+    const struct m3_colors *colors = m3_scheme( settings->accent, dark );
+    int bar = max( height / 4, 14 ), top = height - bar, size = bar - 4, pill = bar - 8;
+    HFONT font = m3_create_font( max( bar / 2 - 1, 8 ), TRUE );
+    int wx = width * 3 / 10, wy = max( 4, top / 6 ), ww = width * 2 / 5, wh = top - wy - 6;
+    RECT rect;
+
+    if (use_xp_wallpaper( TRUE, settings->wallpaper ))
+    {
+        HBITMAP background = build_m3_wallpaper( hdc, width, height, settings->accent, dark );
+        HDC background_dc = CreateCompatibleDC( hdc );
+        HGDIOBJ old_background = SelectObject( background_dc, background );
+
+        BitBlt( hdc, 0, 0, width, height, background_dc, 0, 0, SRCCOPY );
+        SelectObject( background_dc, old_background );
+        DeleteDC( background_dc );
+        DeleteObject( background );
+    }
+    else fill_solid( hdc, 0, 0, width, height, GetSysColor( COLOR_DESKTOP ));
+
+    if (wh > bar)
+    {
+        m3_draw_shadow( hdc, wx, wy, ww, wh, 0, 1 );
+        fill_solid( hdc, wx, wy, ww, wh, colors->surface );
+        fill_solid( hdc, wx, wy, ww, bar - 2, colors->surface_container_high );
+        SetRect( &rect, wx + 6, wy, wx + ww - 6, wy + bar - 2 );
+        m3_draw_text( hdc, font, L"Wine", &rect, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_NOPREFIX, colors->on_surface );
+    }
+
+    fill_solid( hdc, 0, top, width, bar, colors->surface_container );
+    m3_fill_round_rect( hdc, 3, top + 2, size, size, size / 3, colors->primary_container, 255 );
+    m3_fill_round_rect( hdc, size + 8, top + 4, bar * 4, pill, pill / 2, colors->secondary_container, 255 );
+    SetRect( &rect, size + 8 + pill / 2, top + 4, size + 8 + bar * 4 - pill / 2, top + 4 + pill );
+    m3_draw_text( hdc, font, L"Wine", &rect, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_NOPREFIX | DT_END_ELLIPSIS,
+                  colors->on_secondary_container );
+    if (settings->clock)
+    {
+        SetRect( &rect, width - bar * 3, top, width - 6, height );
+        m3_draw_text( hdc, font, clock_time, &rect, DT_SINGLELINE | DT_VCENTER | DT_RIGHT | DT_NOPREFIX,
+                      colors->on_surface );
+    }
+    DeleteObject( font );
+}
