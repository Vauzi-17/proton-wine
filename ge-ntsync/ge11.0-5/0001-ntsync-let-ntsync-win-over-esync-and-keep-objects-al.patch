index 000000000..a72a8a9b8
--- /dev/null
+++ b/android/patches/ntsync/dlls_ntdll_unix_esync.c.patch
@@ -0,0 +1,49 @@
+diff --git a/dlls/ntdll/unix/esync.c b/dlls/ntdll/unix/esync.c
+index 202e945b9..4ac8116b8 100644
+--- a/dlls/ntdll/unix/esync.c
++++ b/dlls/ntdll/unix/esync.c
+@@ -54,15 +54,21 @@
+ 
+ WINE_DEFAULT_DEBUG_CHANNEL(esync);
+ 
++/* Set by esync_init() once wineserver reports ESYNC_USED_BY_SERVER in the
++ * init_first_thread reply. wineserver makes the choice (ntsync wins over
++ * esync), so WINEESYNC alone must not turn esync on here: that made the
++ * client take esync paths while the server was using ntsync. */
++static int esync_enabled;
++
++static int esync_requested(void)
++{
++    return getenv("WINEESYNC") && atoi(getenv("WINEESYNC")) && !do_fsync();
++}
++
+ int do_esync(void)
+ {
+ #ifdef HAVE_SYS_EVENTFD_H
+-    static int do_esync_cached = -1;
+-
+-    if (do_esync_cached == -1)
+-        do_esync_cached = getenv("WINEESYNC") && atoi(getenv("WINEESYNC")) && !do_fsync();
+-
+-    return do_esync_cached;
++    return esync_enabled;
+ #else
+     static int once;
+     if (!once++)
+@@ -1246,7 +1252,7 @@ NTSTATUS esync_signal_and_wait( HANDLE signal, HANDLE wait, BOOLEAN alertable,
+ 
+ void esync_init(int fd)
+ {
+-    if (!do_esync())
++    if (!esync_requested())
+     {
+         /* make sure the server isn't running without WINEESYNC */
+         HANDLE handle;
+@@ -1263,6 +1269,7 @@ void esync_init(int fd)
+     }
+ 
+     shm_fd = fd;
++    esync_enabled = 1;
+ 
+     pagesize = sysconf( _SC_PAGESIZE );
+ 
