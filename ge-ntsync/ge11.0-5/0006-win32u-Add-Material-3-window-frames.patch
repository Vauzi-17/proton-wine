+static const struct m3_frame_colors *get_m3_frame_colors( BOOL active )
+{
+    static struct m3_frame_colors colors;
+    const COLORREF *pal;
+    COLORREF window;
+    BOOL dark;
+
+    update_frame_settings();
+    if (m3_frame_accent >= M3_FRAME_ACCENTS) return NULL;
+    if (m3_frame_mode) dark = m3_frame_mode == 2;
+    else
+    {
+        window = get_sys_color( COLOR_WINDOW );
+        dark = (GetRValue(window) * 299 + GetGValue(window) * 587 + GetBValue(window) * 114) / 1000 < 128;
+    }
+    pal = m3_frame_palette[m3_frame_accent][dark];
+    colors.bar = active ? pal[1] : pal[0];
+    colors.text = active ? pal[2] : pal[3];
+    colors.outline = pal[4];
+    colors.glyph = active ? pal[2] : pal[3];
+    colors.error = pal[5];
+    colors.on_error = dark ? RGB(0x69,0x00,0x05) : RGB(0xff,0xff,0xff);
+    colors.active = active;
+    return &colors;
+}
+
+static const struct m3_frame_colors *get_m3_window_colors( HWND hwnd, DWORD style, DWORD ex_style )
+{
+    if (!has_xp_frame( style, ex_style )) return NULL;
+    return get_m3_frame_colors( (win_get_flags( hwnd ) & WIN_NCACTIVATED) != 0 );
+}
+
+static COLORREF m3_mix( COLORREF base, COLORREF over, float amount )
+{
+    return RGB( GetRValue(base) + (GetRValue(over) - GetRValue(base)) * amount,
+                GetGValue(base) + (GetGValue(over) - GetGValue(base)) * amount,
+                GetBValue(base) + (GetBValue(over) - GetBValue(base)) * amount );
+}
+
+static float m3_clamp( float value )
+{
+    return value < 0 ? 0 : value > 1 ? 1 : value;
+}
+
+/* coverage of a pixel center by a stroke along the segment (x1,y1)-(x2,y2) */
+static float m3_segment_cover( float px, float py, float x1, float y1, float x2, float y2, float half )
+{
+    float dx = x2 - x1, dy = y2 - y1, len = dx * dx + dy * dy, t = 0, ex, ey;
+
+    if (len > 0) t = m3_clamp( ((px - x1) * dx + (py - y1) * dy) / len );
+    ex = px - (x1 + t * dx);
+    ey = py - (y1 + t * dy);
+    return m3_clamp( half + 0.5f - sqrtf( ex * ex + ey * ey ));
+}
+
+/* coverage of a pixel center by the outline of a square of half size r centered on (cx,cy) */
+static float m3_square_cover( float px, float py, float cx, float cy, float r, float half )
+{
+    float d = fmaxf( fabsf( px - cx ), fabsf( py - cy ));
+
+    return m3_clamp( half + 0.5f - fabsf( d - r ));
+}
+
+/* draw a caption button: a flat box with an anti-aliased glyph, red when the close button is pushed */
+static void m3_draw_caption_button( HDC hdc, const RECT *rect, UINT flags, const struct m3_frame_colors *colors,
+                                    UINT dpi )
+{
+    int width = rect->right - rect->left, height = rect->bottom - rect->top, x, y;
+    BOOL down = (flags & DFCS_PUSHED) != 0, grayed = (flags & DFCS_INACTIVE) != 0;
+    UINT type = flags & 0xff;
+    float scale = dpi / 96.0f, half = 0.5f * scale, r = 5 * scale, cx, cy;
+    COLORREF back = colors->bar, glyph = colors->glyph;
+    HBITMAP bitmap, prev_bitmap;
+    HDC mem;
+
+    if (width <= 0 || height <= 0) return;
+    if (down && type == DFCS_CAPTIONCLOSE)
+    {
+        back = colors->error;
+        glyph = colors->on_error;
+    }
+    else if (down) back = m3_mix( back, colors->glyph, 0.1f );  /* pressed state layer */
+    if (grayed) glyph = m3_mix( back, glyph, 0.38f );
+
+    if (!(mem = NtGdiCreateCompatibleDC( hdc ))) return;
+    if (!(bitmap = NtGdiCreateCompatibleBitmap( hdc, width, height )))
+    {
+        NtGdiDeleteObjectApp( mem );
+        return;
+    }
+    prev_bitmap = NtGdiSelectBitmap( mem, bitmap );
+    xp_fill( mem, 0, 0, width, height, back );
+
+    cx = width / 2.0f;
+    cy = height / 2.0f;
+    for (y = (int)(cy - r - 2 * scale - 1); y <= (int)(cy + r + 2 * scale + 1); y++)
+    {
+        for (x = (int)(cx - r - 2 * scale - 1); x <= (int)(cx + r + 2 * scale + 1); x++)
+        {
+            float px = x + 0.5f, py = y + 0.5f, cover = 0, o = 2 * scale;
+
+            if (x < 0 || y < 0 || x >= width || y >= height) continue;
+            switch (type)
+            {
+            case DFCS_CAPTIONCLOSE:
+                cover = fmaxf( m3_segment_cover( px, py, cx - r, cy - r, cx + r, cy + r, half ),
+                               m3_segment_cover( px, py, cx + r, cy - r, cx - r, cy + r, half ));
+                break;
+            case DFCS_CAPTIONMIN:
+                cover = m3_segment_cover( px, py, cx - r, cy, cx + r, cy, half );
+                break;
+            case DFCS_CAPTIONMAX:
+                cover = m3_square_cover( px, py, cx, cy, r, half );
+                break;
+            case DFCS_CAPTIONRESTORE:
+                /* the front square, and the part of the back one outside of it */
+                cover = m3_square_cover( px, py, cx - o / 2, cy + o / 2, r - o / 2, half );
+                if (fabsf( px - (cx - o / 2) ) > r - o / 2 + half || fabsf( py - (cy + o / 2) ) > r - o / 2 + half)
+                    cover = fmaxf( cover, m3_square_cover( px, py, cx + o / 2, cy - o / 2, r - o / 2, half ));
+                break;
+            }
+            if (cover > 0) NtGdiSetPixel( mem, x, y, m3_mix( back, glyph, cover ));
+        }
+    }
+
+    NtGdiBitBlt( hdc, rect->left, rect->top, width, height, mem, 0, 0, SRCCOPY, 0, 0 );
+    NtGdiSelectBitmap( mem, prev_bitmap );
+    NtGdiDeleteObjectApp( bitmap );
+    NtGdiDeleteObjectApp( mem );
+}
+
+/* the Material 3 caption buttons fill the caption height, one caption height wide each */
+static void m3_caption_button_rect( HWND hwnd, RECT *rect, int index, DWORD style, DWORD ex_style )
+{
+    int caption = get_system_metrics( (ex_style & WS_EX_TOOLWINDOW) ? SM_CYSMCAPTION : SM_CYCAPTION );
+    int width = get_system_metrics( (ex_style & WS_EX_TOOLWINDOW) ? SM_CXSMSIZE : SM_CXSIZE );
+
+    get_inside_rect( hwnd, COORDS_WINDOW, rect, style, ex_style );
+    rect->right -= index * width;
+    rect->left = rect->right - width;
+    rect->bottom = rect->top + caption - 1;
+}
+
+/* the frame outside the caption: the bar color, with a thin outline around the window */
+static void m3_draw_frame( HDC hdc, const RECT *outer, const RECT *inner, const struct m3_frame_colors *colors )
+{
+    int left = inner->left - outer->left, top = inner->top - outer->top;
+    int right = outer->right - inner->right, bottom = outer->bottom - inner->bottom;
+    int width = outer->right - outer->left, height = outer->bottom - outer->top;
+
+    xp_fill( hdc, outer->left, outer->top, width, top, colors->bar );
+    xp_fill( hdc, outer->left, inner->bottom, width, bottom, colors->bar );
+    xp_fill( hdc, outer->left, inner->top, left, inner->bottom - inner->top, colors->bar );
+    xp_fill( hdc, inner->right, inner->top, right, inner->bottom - inner->top, colors->bar );
+    if (left > 0 || top > 0 || right > 0 || bottom > 0)
+    {
+        xp_fill( hdc, outer->left, outer->top, width, 1, colors->outline );
+        xp_fill( hdc, outer->left, outer->bottom - 1, width, 1, colors->outline );
+        xp_fill( hdc, outer->left, outer->top, 1, height, colors->outline );
+        xp_fill( hdc, outer->right - 1, outer->top, 1, height, colors->outline );
+    }
+}
+
+/* the title font: Roboto Medium when it is installed, the caption font otherwise */
+static HFONT m3_create_title_font( HDC hdc, const LOGFONTW *caption_font )
+{
+    static const WCHAR robotoW[] = {'R','o','b','o','t','o',' ','M','e','d','i','u','m',0};
+    WCHAR face[LF_FACESIZE];
+    HFONT font, prev;
+    LOGFONTW lf = *caption_font;
+
+    lf.lfWeight = FW_NORMAL;
+    lf.lfQuality = ANTIALIASED_QUALITY;
+    memcpy( lf.lfFaceName, robotoW, sizeof(robotoW) );
+    font = NtGdiHfontCreate( &lf, sizeof(lf), 0, 0, NULL );
+    prev = NtGdiSelectFont( hdc, font );
+    face[0] = 0;
+    NtGdiGetTextFaceW( hdc, ARRAY_SIZE(face), face, FALSE );
+    NtGdiSelectFont( hdc, prev );
+    if (!wcsicmp( face, robotoW )) return font;
+    NtGdiDeleteObjectApp( font );
+    lf = *caption_font;
+    lf.lfWeight = FW_NORMAL;
+    return NtGdiHfontCreate( &lf, sizeof(lf), 0, 0, NULL );
+}
