+/*
+ * Material 3 frames: a flat title bar in the surface colors of the scheme picked in the
+ * explorer desktop settings, a thin outline and plain caption glyphs; the title is in
+ * Roboto Medium when the desktop installed it. Same frame and caption sizes as the
+ * classic frame.
+ */
+
+static void xp_fill( HDC hdc, int x, int y, int width, int height, COLORREF color );
+
+struct m3_frame_colors
+{
+    COLORREF bar, text, outline, glyph, error, on_error;
+    BOOL     active;
+};
+
+/* surface container, surface container high, on surface, on surface variant, outline variant
+ * and error of the tonal spot schemes of the explorer desktop, light and dark */
+static const COLORREF m3_frame_palette[M3_FRAME_ACCENTS][2][6] =
+{
+    { { RGB(0xf2,0xec,0xf4), RGB(0xec,0xe6,0xee), RGB(0x1d,0x1b,0x20), RGB(0x49,0x45,0x4e), RGB(0xca,0xc4,0xcf), RGB(0xba,0x1a,0x1a) },
+      { RGB(0x21,0x1f,0x24), RGB(0x2b,0x29,0x2f), RGB(0xe6,0xe0,0xe9), RGB(0xca,0xc4,0xcf), RGB(0x49,0x45,0x4e), RGB(0xff,0xb4,0xab) } },  /* purple */
+    { { RGB(0xed,0xed,0xf4), RGB(0xe8,0xe7,0xee), RGB(0x1a,0x1b,0x20), RGB(0x44,0x47,0x4f), RGB(0xc4,0xc6,0xd0), RGB(0xba,0x1a,0x1a) },
+      { RGB(0x1e,0x1f,0x25), RGB(0x28,0x2a,0x2f), RGB(0xe2,0xe2,0xe9), RGB(0xc4,0xc6,0xd0), RGB(0x44,0x47,0x4f), RGB(0xff,0xb4,0xab) } },  /* blue */
+    { { RGB(0xe9,0xef,0xec), RGB(0xe3,0xea,0xe7), RGB(0x16,0x1d,0x1b), RGB(0x3f,0x49,0x46), RGB(0xbe,0xc9,0xc5), RGB(0xba,0x1a,0x1a) },
+      { RGB(0x1a,0x21,0x1f), RGB(0x25,0x2b,0x2a), RGB(0xdd,0xe4,0xe1), RGB(0xbe,0xc9,0xc5), RGB(0x3f,0x49,0x46), RGB(0xff,0xb4,0xab) } },  /* teal */
+    { { RGB(0xec,0xef,0xe6), RGB(0xe6,0xe9,0xe0), RGB(0x19,0x1d,0x17), RGB(0x42,0x49,0x40), RGB(0xc2,0xc9,0xbd), RGB(0xba,0x1a,0x1a) },
+      { RGB(0x1d,0x21,0x1b), RGB(0x27,0x2b,0x25), RGB(0xe0,0xe4,0xdb), RGB(0xc2,0xc9,0xbd), RGB(0x42,0x49,0x40), RGB(0xff,0xb4,0xab) } },  /* green */
+    { { RGB(0xfc,0xeb,0xe2), RGB(0xf6,0xe5,0xdc), RGB(0x22,0x1a,0x15), RGB(0x52,0x44,0x3c), RGB(0xd7,0xc3,0xb7), RGB(0xba,0x1a,0x1a) },
+      { RGB(0x26,0x1e,0x19), RGB(0x31,0x28,0x23), RGB(0xf0,0xdf,0xd7), RGB(0xd7,0xc3,0xb7), RGB(0x52,0x44,0x3c), RGB(0xff,0xb4,0xab) } },  /* orange */
+    { { RGB(0xfb,0xea,0xeb), RGB(0xf5,0xe4,0xe6), RGB(0x22,0x19,0x1b), RGB(0x52,0x43,0x45), RGB(0xd6,0xc2,0xc4), RGB(0xba,0x1a,0x1a) },
+      { RGB(0x26,0x1d,0x1f), RGB(0x31,0x28,0x29), RGB(0xf0,0xde,0xe0), RGB(0xd6,0xc2,0xc4), RGB(0x52,0x43,0x45), RGB(0xff,0xb4,0xab) } },  /* pink */
+};
