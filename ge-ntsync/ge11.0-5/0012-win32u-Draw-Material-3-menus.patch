From 0b25fa55f38ab3e3364fadda24850f02bf3a3ec9 Mon Sep 17 00:00:00 2001
From: Vauzi-17 <189964753+Vauzi-17@users.noreply.github.com>
Date: Sat, 26 Sep 2026 11:35:34 +0000
Subject: [PATCH 12/18] win32u: Draw Material 3 menus.

With the Material 3 frames, menus get taller items with more room,
rounded state layers in place of the highlight, disabled text at 38%
instead of the embossed gray, anti-aliased check marks, radio dots and
submenu arrows, shortcuts on the right, inset separators and a thin
outline. The menu bar takes the color of the title bar. Menus with
their own background brush and owner-drawn items stay as they are.
---
 dlls/win32u/defwnd.c         |  81 ++++++++++-
 dlls/win32u/menu.c           | 251 ++++++++++++++++++++++++++++++++++-
 dlls/win32u/win32u_private.h |  12 ++
 3 files changed, 335 insertions(+), 9 deletions(-)

diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index 16b5782de..23d85bdd0 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -1809,7 +1809,30 @@ static const struct m3_frame_colors *get_m3_window_colors( HWND hwnd, DWORD styl
     return get_m3_frame_colors( (win_get_flags( hwnd ) & WIN_NCACTIVATED) != 0 );
 }
 
-static COLORREF m3_mix( COLORREF base, COLORREF over, float amount )
+/* Material 3 menus go with the Material 3 frames; a menu bar takes the color of its title bar */
+BOOL get_m3_menu_colors( HWND hwnd, struct m3_menu_colors *colors )
+{
+    const struct m3_frame_colors *frame;
+    const COLORREF *pal;
+    BOOL dark;
+
+    if (!(frame = get_m3_frame_colors( hwnd && (win_get_flags( hwnd ) & WIN_NCACTIVATED) ))) return FALSE;
+    if (m3_frame_mode) dark = m3_frame_mode == 2;
+    else
+    {
+        COLORREF window = get_sys_color( COLOR_WINDOW );
+        dark = (GetRValue(window) * 299 + GetGValue(window) * 587 + GetBValue(window) * 114) / 1000 < 128;
+    }
+    pal = m3_frame_palette[m3_frame_accent][dark];
+    colors->back = pal[0];
+    colors->bar = frame->bar;
+    colors->text = pal[2];
+    colors->variant = pal[3];
+    colors->outline = pal[4];
+    return TRUE;
+}
+
+COLORREF m3_mix( COLORREF base, COLORREF over, float amount )
 {
     return RGB( GetRValue(base) + (GetRValue(over) - GetRValue(base)) * amount,
                 GetGValue(base) + (GetGValue(over) - GetGValue(base)) * amount,
@@ -1822,7 +1845,7 @@ static float m3_clamp( float value )
 }
 
 /* coverage of a pixel center by a stroke along the segment (x1,y1)-(x2,y2) */
-static float m3_segment_cover( float px, float py, float x1, float y1, float x2, float y2, float half )
+float m3_segment_cover( float px, float py, float x1, float y1, float x2, float y2, float half )
 {
     float dx = x2 - x1, dy = y2 - y1, len = dx * dx + dy * dy, t = 0, ex, ey;
 
@@ -1840,6 +1863,60 @@ static float m3_square_cover( float px, float py, float cx, float cy, float r, f
     return m3_clamp( half + 0.5f - fabsf( d - r ));
 }
 
+/* anti-aliased strokes over a solid background, drawn pixel by pixel in box:
+ * count segments of 4 floats (x1, y1, x2, y2), relative to the box */
+void m3_draw_strokes( HDC hdc, const RECT *box, const float *segments, int count, float width,
+                      COLORREF back, COLORREF color )
+{
+    int x, y, i;
+
+    for (y = box->top; y < box->bottom; y++)
+    {
+        for (x = box->left; x < box->right; x++)
+        {
+            float px = x - box->left + 0.5f, py = y - box->top + 0.5f, cover = 0;
+
+            for (i = 0; i < count; i++)
+                cover = fmaxf( cover, m3_segment_cover( px, py, segments[4 * i], segments[4 * i + 1],
+                                                        segments[4 * i + 2], segments[4 * i + 3], width / 2 ));
+            if (cover > 0) NtGdiSetPixel( hdc, x, y, m3_mix( back, color, cover ));
+        }
+    }
+}
+
+/* an anti-aliased rounded rectangle over a solid background */
+void m3_fill_round_rect( HDC hdc, const RECT *rect, int radius, COLORREF back, COLORREF color )
+{
+    int width = rect->right - rect->left, height = rect->bottom - rect->top, x, y;
+    HBRUSH brush = NtGdiCreateSolidBrush( color, NULL );
+    RECT rc;
+
+    radius = min( radius, min( width, height ) / 2 );
+    SetRect( &rc, rect->left + radius, rect->top, rect->right - radius, rect->bottom );
+    fill_rect( hdc, &rc, brush );
+    SetRect( &rc, rect->left, rect->top + radius, rect->right, rect->bottom - radius );
+    fill_rect( hdc, &rc, brush );
+    NtGdiDeleteObjectApp( brush );
+
+    /* the corners */
+    for (y = 0; y < radius; y++)
+    {
+        for (x = 0; x < radius; x++)
+        {
+            float dx = radius - (x + 0.5f), dy = radius - (y + 0.5f);
+            float cover = m3_clamp( radius + 0.5f - sqrtf( dx * dx + dy * dy ));
+            COLORREF pixel;
+
+            if (cover <= 0) continue;
+            pixel = m3_mix( back, color, cover );
+            NtGdiSetPixel( hdc, rect->left + x, rect->top + y, pixel );
+            NtGdiSetPixel( hdc, rect->right - 1 - x, rect->top + y, pixel );
+            NtGdiSetPixel( hdc, rect->left + x, rect->bottom - 1 - y, pixel );
+            NtGdiSetPixel( hdc, rect->right - 1 - x, rect->bottom - 1 - y, pixel );
+        }
+    }
+}
+
