                                     UINT dpi )
diff --git a/dlls/win32u/menu.c b/dlls/win32u/menu.c
index dda7d119e..be26a0937 100644
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -2146,9 +2146,206 @@ static void calc_menu_item_size( HDC hdc, struct menu_item *item, HWND owner, IN
     TRACE( "%s\n", wine_dbgstr_rect( &item->rect ));
 }
 
+/*
+ * Material 3 menus, with the Material 3 style of the explorer desktop: taller items with
+ * more room, rounded state layers instead of the highlight, anti-aliased check marks and
+ * arrows, a menu bar in the color of the title bar.
+ */
+
+static int m3_px( int value )
+{
+    return value * (int)get_system_dpi() / 96;
+}
+
+/* the room and height of a popup menu item */
+static void m3_popup_item_size( struct menu_item *item )
+{
+    int height = item->rect.bottom - item->rect.top;
+
+    if (item->fType & MF_OWNERDRAW) return;
+    if (item->fType & MF_SEPARATOR) height = m3_px( 9 );
+    else
+    {
+        height = max( height, m3_px( 32 ));
+        item->rect.right += m3_px( 24 );
+    }
+    item->rect.bottom = item->rect.top + height;
+}
+
+static void m3_draw_check( HDC hdc, const RECT *rect, BOOL radio, COLORREF back, COLORREF color )
+{
+    int size = min( rect->right - rect->left, rect->bottom - rect->top );
+    RECT box;
+
+    SetRect( &box, rect->left, (rect->top + rect->bottom - size) / 2, rect->left + size,
+             (rect->top + rect->bottom + size) / 2 );
+    if (radio)
+    {
+        InflateRect( &box, -size * 5 / 16, -size * 5 / 16 );
+        m3_fill_round_rect( hdc, &box, size, back, color );
+    }
+    else
+    {
+        float s = size / 16.0f;
+        float check[8] = { 3 * s, 8.5f * s, 6.5f * s, 12 * s, 6.5f * s, 12 * s, 13 * s, 4.5f * s };
+
+        m3_draw_strokes( hdc, &box, check, 2, max( 1.5f, 1.6f * s ), back, color );
+    }
+}
+
+static void m3_draw_arrow( HDC hdc, const RECT *rect, COLORREF back, COLORREF color )
+{
+    int size = m3_px( 16 );
+    float s = size / 16.0f;
+    float arrow[8] = { 6 * s, 4 * s, 10 * s, 8 * s, 10 * s, 8 * s, 6 * s, 12 * s };
+    RECT box;
+
+    SetRect( &box, rect->right - m3_px( 12 ) - size, (rect->top + rect->bottom - size) / 2,
+             rect->right - m3_px( 12 ), (rect->top + rect->bottom + size) / 2 );
+    m3_draw_strokes( hdc, &box, arrow, 2, max( 1.5f, 1.5f * s ), back, color );
+}
+
+static void m3_fill( HDC hdc, const RECT *rect, COLORREF color )
+{
+    HBRUSH brush = NtGdiCreateSolidBrush( color, NULL );
+
+    fill_rect( hdc, rect, brush );
+    NtGdiDeleteObjectApp( brush );
+}
+
+static void draw_bitmap_item( HWND hwnd, HDC hdc, struct menu_item *item, const RECT *rect,
+                              struct menu *menu, HWND owner, UINT odaction );
+
+static void m3_draw_menu_item( HWND hwnd, struct menu *menu, HWND owner, HDC hdc, struct menu_item *item,
+                               BOOL menu_bar, RECT rect, const struct m3_menu_colors *colors, UINT odaction )
+{
+    COLORREF back = menu_bar ? colors->bar : colors->back, text, variant;
+    BOOL grayed = (item->fState & MF_GRAYED) != 0;
+    UINT format = DT_SINGLELINE | DT_VCENTER;
+    RECT box, bmprc;
+    int i;
+
+    m3_fill( hdc, &rect, back );
+    if (item->fType & MF_SEPARATOR)
+    {
+        if (menu_bar) return;
+        SetRect( &box, rect.left + m3_px( 12 ), (rect.top + rect.bottom) / 2, rect.right - m3_px( 12 ),
+                 (rect.top + rect.bottom) / 2 + max( 1, m3_px( 1 )));
+        m3_fill( hdc, &box, colors->outline );
+        return;
+    }
+    if (item->fState & MF_HILITE)
+    {
+        COLORREF state = m3_mix( back, colors->text, (item->fState & MF_MOUSESELECT) && menu_bar ? 0.12f : 0.08f );
+
+        box = rect;
+        if (menu_bar) InflateRect( &box, -m3_px( 2 ), -m3_px( 2 ));
+        else InflateRect( &box, -m3_px( 4 ), -m3_px( 1 ));
+        m3_fill_round_rect( hdc, &box, menu_bar ? (box.bottom - box.top) / 2 : m3_px( 8 ), back, state );
+        back = state;
+    }
+    text = grayed ? m3_mix( back, colors->text, 0.38f ) : colors->text;
+    variant = grayed ? text : colors->variant;
+    NtGdiGetAndSetDCDword( hdc, NtGdiSetBkMode, TRANSPARENT, NULL );
+    NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, text, NULL );
+
+    if (menu_bar)
+    {
+        if (item->hbmpItem)
+        {
+            POINT org;
+
+            SetRect( &bmprc, item->hbmpItem == HBMMENU_CALLBACK ? 3 : (item->text ? menucharsize.cx : 0), 0, 0, 0 );
+            bmprc.right = bmprc.left + item->bmpsize.cx;
+            bmprc.top = item->hbmpItem == HBMMENU_CALLBACK ? (rect.bottom - rect.top - item->bmpsize.cy) / 2 : 0;
+            bmprc.bottom = bmprc.top + item->bmpsize.cy;
+            set_viewport_org( hdc, rect.left, rect.top, &org );
+            draw_bitmap_item( hwnd, hdc, item, &bmprc, menu, owner, odaction );
+            set_viewport_org( hdc, org.x, org.y, NULL );
+            rect.left += item->bmpsize.cx;
+        }
+        if (item->text) DrawTextW( hdc, item->text, -1, &rect, format | DT_CENTER );
+        return;
+    }
+
+    box = rect;
+    box.left += m3_px( 12 );
+    if (!(menu->dwStyle & MNS_NOCHECK))
+    {
+        UINT check_width = get_system_metrics( SM_CXMENUCHECK ), check_height = get_system_metrics( SM_CYMENUCHECK );
+        HBITMAP bm = (item->fState & MF_CHECKED) ? item->hCheckBit : item->hUnCheckBit;
+        BOOL checked = FALSE;
+
+        if (bm)
+        {
+            HDC mem_hdc = NtGdiCreateCompatibleDC( hdc );
+
+            NtGdiSelectBitmap( mem_hdc, bm );
+            NtGdiBitBlt( hdc, box.left, (rect.top + rect.bottom - check_height) / 2, check_width, check_height,
+                         mem_hdc, 0, 0, SRCCOPY, 0, 0 );
+            NtGdiDeleteObjectApp( mem_hdc );
+            checked = TRUE;
+        }
+        else if (item->fState & MF_CHECKED)
+        {
+            RECT check = { box.left, rect.top, box.left + check_width, rect.bottom };
+
+            m3_draw_check( hdc, &check, (item->fType & MFT_RADIOCHECK) != 0, back, text );
+            checked = TRUE;
+        }
+        if (item->hbmpItem && !(checked && (menu->dwStyle & MNS_CHECKORBMP)))
+        {
+            POINT org;
+
+            bmprc.left = (menu->dwStyle & MNS_CHECKORBMP) ? m3_px( 12 ) : m3_px( 12 ) + check_width + 4;
+            bmprc.right = bmprc.left + item->bmpsize.cx;
+            bmprc.top = (rect.bottom - rect.top - item->bmpsize.cy) / 2;
+            bmprc.bottom = bmprc.top + item->bmpsize.cy;
+            set_viewport_org( hdc, rect.left, rect.top, &org );
+            draw_bitmap_item( hwnd, hdc, item, &bmprc, menu, owner, odaction );
+            set_viewport_org( hdc, org.x, org.y, NULL );
+        }
+        box.left += check_width + 4;
+    }
+    else if (item->hbmpItem)
+    {
+        POINT org;
+
+        SetRect( &bmprc, m3_px( 12 ), (rect.bottom - rect.top - item->bmpsize.cy) / 2, 0, 0 );
+        bmprc.right = bmprc.left + item->bmpsize.cx;
+        bmprc.bottom = bmprc.top + item->bmpsize.cy;
+        set_viewport_org( hdc, rect.left, rect.top, &org );
+        draw_bitmap_item( hwnd, hdc, item, &bmprc, menu, owner, odaction );
+        set_viewport_org( hdc, org.x, org.y, NULL );
+    }
+    if (item->fType & MF_POPUP) m3_draw_arrow( hdc, &rect, back, variant );
+    if (!item->text) return;
+
+    if (!(menu->dwStyle & MNS_CHECKORBMP)) box.left += menu->textOffset;
+    box.right -= m3_px( 12 ) + ((item->fType & MF_POPUP) ? m3_px( 16 ) : 0);
+    for (i = 0; item->text[i]; i++) if (item->text[i] == '\t' || item->text[i] == '\b') break;
+    if (item->fState & MFS_DEFAULT)
+    {
+        HFONT prev_font = NtGdiSelectFont( hdc, get_menu_font( TRUE ));
+
+        DrawTextW( hdc, item->text, i, &box, format | DT_LEFT );
+        NtGdiSelectFont( hdc, prev_font );
+    }
+    else DrawTextW( hdc, item->text, i, &box, format | DT_LEFT );
+
+    /* the shortcut, on the right */
+    if (item->text[i])
+    {
+        NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, variant, NULL );
+        DrawTextW( hdc, item->text + i + 1, -1, &box, format | DT_RIGHT );
+    }
+}
