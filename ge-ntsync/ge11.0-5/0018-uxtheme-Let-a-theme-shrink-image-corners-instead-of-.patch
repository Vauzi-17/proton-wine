diff --git a/dlls/uxtheme/msstyles.c b/dlls/uxtheme/msstyles.c
index 7ad79f3f5..b1ff99a4c 100644
--- a/dlls/uxtheme/msstyles.c
+++ b/dlls/uxtheme/msstyles.c
@@ -254,6 +254,14 @@ PUXINI_FILE MSSTYLES_GetThemeIni(PTHEME_FILE tf)
     return UXINI_LoadINI(tf->hTheme, L"themes_ini");
 }
 
+/***********************************************************************
+ *      MSSTYLES_ScaleCorners
+ */
+BOOL MSSTYLES_ScaleCorners(PTHEME_CLASS tc)
+{
+    return tc->tf->scale_corners;
+}
+
 /***********************************************************************
  *      MSSTYLES_GetThemeDPI
  *
@@ -919,6 +927,18 @@ static void parse_recolors(PTHEME_FILE tf, PUXINI_FILE ini)
     }
 }
 
+static void parse_sizing(PTHEME_FILE tf, PUXINI_FILE ini)
+{
+    LPCWSTR lpName, lpValue;
+    DWORD dwLen, dwValueLen;
+
+    while((lpName=UXINI_GetNextValue(ini, &dwLen, &lpValue, &dwValueLen))) {
+        if(CompareStringW(LOCALE_SYSTEM_DEFAULT, NORM_IGNORECASE, lpName, dwLen, L"ScaleCorners", -1) == CSTR_EQUAL)
+            tf->scale_corners = CompareStringW(LOCALE_SYSTEM_DEFAULT, NORM_IGNORECASE, lpValue, dwValueLen,
+                                               L"true", -1) == CSTR_EQUAL;
+    }
+}
+
 /***********************************************************************
  *      MSSTYLES_ParseThemeIni
  *
@@ -1002,6 +1022,10 @@ static void MSSTYLES_ParseThemeIni(PTHEME_FILE tf, BOOL setMetrics)
             parse_recolors(tf, ini);
             continue;
         }
+        if(CompareStringW(LOCALE_SYSTEM_DEFAULT, NORM_IGNORECASE, lpName, dwLen, L"WineSizing", -1) == CSTR_EQUAL) {
+            parse_sizing(tf, ini);
+            continue;
+        }
         if(MSSTYLES_ParseIniSectionName(lpName, dwLen, szAppName, szClassName, &iPartId, &iStateId)) {
             BOOL isGlobal = FALSE;
             if(!lstrcmpiW(szClassName, L"globals")) {
