+++ b/dlls/uxtheme/draw.c
@@ -809,24 +809,43 @@ static HRESULT UXTHEME_DrawImageBackground(HTHEME hTheme, HDC hdc, int iPartId,
     }
     else {
         HDC hdcDst = NULL;
-        MARGINS sm;
+        MARGINS sm, ssm;
         POINT org;
 
         dstSize.x = abs(dstSize.x);
         dstSize.y = abs(dstSize.y);
 
         GetThemeMargins(hTheme, hdc, iPartId, iStateId, TMT_SIZINGMARGINS, NULL, &sm);
+        /* sm are the margins in the destination, ssm the ones in the image */
+        ssm = sm;
 
         /* Resize sizing margins if destination is smaller */
         if (sm.cyTopHeight + sm.cyBottomHeight > dstSize.y || sm.cxLeftWidth + sm.cxRightWidth > dstSize.x) {
-            if (sm.cyTopHeight + sm.cyBottomHeight > dstSize.y) {
-                sm.cyTopHeight = MulDiv(sm.cyTopHeight, dstSize.y, srcSize.y);
-                sm.cyBottomHeight = dstSize.y - sm.cyTopHeight;
+            if (MSSTYLES_ScaleCorners(hTheme)) {
+                /* Wine extension: shrink the corners evenly, so that round corners stay round */
+                int num = dstSize.y, den = sm.cyTopHeight + sm.cyBottomHeight;
+
+                if (!den || (LONGLONG)dstSize.x * den < (LONGLONG)num * (sm.cxLeftWidth + sm.cxRightWidth)) {
+                    num = dstSize.x;
+                    den = sm.cxLeftWidth + sm.cxRightWidth;
+                }
+                sm.cxLeftWidth = MulDiv(ssm.cxLeftWidth, num, den);
+                sm.cxRightWidth = min(MulDiv(ssm.cxRightWidth, num, den), dstSize.x - sm.cxLeftWidth);
+                sm.cyTopHeight = MulDiv(ssm.cyTopHeight, num, den);
+                sm.cyBottomHeight = min(MulDiv(ssm.cyBottomHeight, num, den), dstSize.y - sm.cyTopHeight);
             }
+            else {
+                if (sm.cyTopHeight + sm.cyBottomHeight > dstSize.y) {
+                    sm.cyTopHeight = MulDiv(sm.cyTopHeight, dstSize.y, srcSize.y);
+                    sm.cyBottomHeight = dstSize.y - sm.cyTopHeight;
+                }
 
-            if (sm.cxLeftWidth + sm.cxRightWidth > dstSize.x) {
-                sm.cxLeftWidth = MulDiv(sm.cxLeftWidth, dstSize.x, srcSize.x);
-                sm.cxRightWidth = dstSize.x - sm.cxLeftWidth;
+                if (sm.cxLeftWidth + sm.cxRightWidth > dstSize.x) {
+                    sm.cxLeftWidth = MulDiv(sm.cxLeftWidth, dstSize.x, srcSize.x);
+                    sm.cxRightWidth = dstSize.x - sm.cxLeftWidth;
+                }
+                /* the corners are cut, not scaled */
+                ssm = sm;
             }
         }
 
