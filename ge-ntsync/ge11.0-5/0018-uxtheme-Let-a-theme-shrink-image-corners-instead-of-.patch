+                               ssm.cxLeftWidth, ssm.cyBottomHeight,
+                               transparent, transparentcolor)) {
             hr = HRESULT_FROM_WIN32(GetLastError());
             goto draw_error; 
         }
         /* Lower right corner */
-        if(!UXTHEME_Blt (hdcDst, dstSize.x-sm.cxRightWidth, dstSize.y-sm.cyBottomHeight, 
-                         sm.cxRightWidth, sm.cyBottomHeight,
-                         hdcSrc, rcSrc.right-sm.cxRightWidth, rcSrc.bottom-sm.cyBottomHeight, 
-                         transparent, transparentcolor)) {
+        if(!UXTHEME_StretchBlt(hdcDst, dstSize.x-sm.cxRightWidth, dstSize.y-sm.cyBottomHeight,
+                               sm.cxRightWidth, sm.cyBottomHeight,
+                               hdcSrc, rcSrc.right-ssm.cxRightWidth, rcSrc.bottom-ssm.cyBottomHeight,
+                               ssm.cxRightWidth, ssm.cyBottomHeight,
+                               transparent, transparentcolor)) {
             hr = HRESULT_FROM_WIN32(GetLastError());
             goto draw_error; 
