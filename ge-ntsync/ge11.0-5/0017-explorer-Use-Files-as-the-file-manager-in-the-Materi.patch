+/*
+ * Files as the file manager. The Android app starts C:\windows\wfm.exe, its own file manager,
+ * when there is no program to run. In the Material 3 style it is replaced by a copy of Files
+ * and kept as wfm-winlator.exe, to be put back for the other styles. The app puts its file
+ * manager back when it updates the prefix; it is replaced again at the next start.
+ */
+
+/* Files is a builtin program, the file manager of the app is not */
+static BOOL is_builtin_program( const WCHAR *path )
+{
+    static const char signature[] = "Wine builtin DLL";
+    char buffer[0x40 + sizeof(signature)];
+    DWORD read = 0;
+    HANDLE file;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    ReadFile( file, buffer, sizeof(buffer), &read, NULL );
+    CloseHandle( file );
+    return read == sizeof(buffer) && !memcmp( buffer + 0x40, signature, sizeof(signature) - 1 );
+}
+
+static BOOL same_contents( const WCHAR *path1, const WCHAR *path2 )
+{
+    HANDLE file1, file2;
+    BOOL same = FALSE;
+    char *buffer;
+    DWORD size;
+
+    file1 = CreateFileW( path1, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    file2 = CreateFileW( path2, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file1 != INVALID_HANDLE_VALUE && file2 != INVALID_HANDLE_VALUE &&
+        (size = GetFileSize( file1, NULL )) == GetFileSize( file2, NULL ) && size < 64 << 20 &&
+        (buffer = malloc( 2 * (size_t)size + 1 )))
+    {
+        DWORD read1 = 0, read2 = 0;
+
+        same = ReadFile( file1, buffer, size, &read1, NULL ) && ReadFile( file2, buffer + size, size, &read2, NULL ) &&
+               read1 == size && read2 == size && !memcmp( buffer, buffer + size, size );
+        free( buffer );
+    }
+    if (file1 != INVALID_HANDLE_VALUE) CloseHandle( file1 );
+    if (file2 != INVALID_HANDLE_VALUE) CloseHandle( file2 );
+    return same;
+}
+
+void m3_apply_file_manager( BOOL enable )
+{
+    WCHAR files[MAX_PATH], wfm[MAX_PATH], backup[MAX_PATH];
+
+    GetSystemDirectoryW( files, MAX_PATH - 16 );
+    lstrcatW( files, L"\\files.exe" );
+    GetWindowsDirectoryW( wfm, MAX_PATH - 24 );
+    lstrcpyW( backup, wfm );
+    lstrcatW( wfm, L"\\wfm.exe" );
+    lstrcatW( backup, L"\\wfm-winlator.exe" );
+
+    /* only the file manager of the app is replaced, there is none elsewhere */
+    if (GetFileAttributesW( wfm ) == INVALID_FILE_ATTRIBUTES) return;
+
+    if (enable)
+    {
+        if (GetFileAttributesW( files ) == INVALID_FILE_ATTRIBUTES || same_contents( files, wfm )) return;
+        /* an older copy of Files is simply updated */
+        if (!is_builtin_program( wfm ) && !MoveFileExW( wfm, backup, MOVEFILE_REPLACE_EXISTING ))
+        {
+            WARN( "can't keep %s: %lu\n", debugstr_w(wfm), GetLastError() );
+            return;
+        }
+        if (!CopyFileW( files, wfm, FALSE ))
+        {
+            WARN( "can't copy Files: %lu\n", GetLastError() );
+            if (GetFileAttributesW( wfm ) == INVALID_FILE_ATTRIBUTES) MoveFileExW( backup, wfm, 0 );
+        }
+    }
+    else if (is_builtin_program( wfm ) && GetFileAttributesW( backup ) != INVALID_FILE_ATTRIBUTES)
+    {
+        if (!MoveFileExW( backup, wfm, MOVEFILE_REPLACE_EXISTING ))
+            WARN( "can't put back %s: %lu\n", debugstr_w(wfm), GetLastError() );
+    }
+}
+
+/* whether folders open in Files: the Material 3 style, with Files as the file manager */
+BOOL m3_files_opens_folders(void)
+{
+    WCHAR style[16];
+    DWORD size = sizeof(style);
+
+    if (!RegGetValueW( HKEY_CURRENT_USER, taskbar_key, L"Style", RRF_RT_REG_SZ, NULL, style, &size ) &&
+        lstrcmpiW( style, L"material3" ))
+        return FALSE;
+    m3_load_settings();
+    return m3_file_manager;
+}
