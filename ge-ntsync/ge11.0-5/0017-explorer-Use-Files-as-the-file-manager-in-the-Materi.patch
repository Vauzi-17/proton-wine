+/* in the Material 3 style, folders open in Files */
+static BOOL open_in_files(const parameters_struct *parameters)
+{
+    WCHAR cmdline[MAX_PATH + 16];
+    STARTUPINFOW si;
+    PROCESS_INFORMATION pi;
+    int len;
+
+    if (!m3_files_opens_folders()) return FALSE;
+    lstrcpyW(cmdline, L"files.exe");
+    if (parameters->root[0])
+    {
+        if (!PathIsDirectoryW(parameters->root)) return FALSE;
+        lstrcatW(cmdline, L" \"");
+        lstrcatW(cmdline, parameters->root);
+        /* a backslash before the closing quote would escape it */
+        len = lstrlenW(cmdline);
+        if (cmdline[len - 1] == '\\') lstrcatW(cmdline, L"\\");
+        lstrcatW(cmdline, L"\"");
+    }
+    memset(&si, 0, sizeof(si));
+    si.cb = sizeof(si);
+    if (!CreateProcessW(NULL, cmdline, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi)) return FALSE;
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    return TRUE;
+}
+
