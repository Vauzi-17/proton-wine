+static void xp_delete_fonts(void)
+{
+    if (xp_font) DeleteObject( xp_font );
+    if (xp_bold_font) DeleteObject( xp_bold_font );
+    if (xp_title_font) DeleteObject( xp_title_font );
+    xp_font = xp_bold_font = xp_title_font = 0;
