+/* notification posted to the desktop window */
+void handle_parent_notify( HWND hwnd, WPARAM wp )
+{
+    switch (LOWORD(wp))
+    {
+    case WM_CREATE:
+        add_taskbar_button( hwnd );
+        break;
+    case WM_DESTROY:
+        remove_taskbar_button( hwnd );
+        cleanup_systray_window( hwnd );
+        break;
+    }
+    sync_taskbar_buttons();
+}
