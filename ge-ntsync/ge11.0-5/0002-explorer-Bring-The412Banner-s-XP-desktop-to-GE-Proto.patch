+    out.append('\n/* images */\n')
+    for file in images:
+        out.append(f'/* @makedep: {file} */\n{file.replace(".", "_").upper()} BITMAP "{file}"\n\n')
+    out.append(FOOTER)
+    with open('winexp.rc', 'w') as f:
+        f.write(''.join(out))
+    print(f'{len(images)} images')
+
+
+if __name__ == '__main__':
+    main()
