+    else:
+        fill = vgrad(1, h, two(s['tab_face']))
+    c.draw(both(rrect(1, 1, w - 1, h + 4, 2), rect(0, 0, w, h)), fill)
+    if state in ('hot', 'selected'):
+        c.draw(both(rrect(0, 0, w, h + 4, 3), rect(0, 0, w, 3)),
