From d36fae17b9fbeeab1cacec119a4cb0ac544b2f3b Mon Sep 17 00:00:00 2001
From: Vauzi-17 <189964753+Vauzi-17@users.noreply.github.com>
Date: Sat, 26 Sep 2026 11:35:34 +0000
Subject: [PATCH 14/15] explorer: Roboto and Material 3 icons in programs.

With the Material 3 style, programs get Roboto for dialogs (the MS
Shell Dlg substitutes) and for menus, status bars and message boxes,
behind a new switch that is on by default; and Material symbols as the
icons of folders, drives, the computer and the documents, with the
controls switch. The fonts and icons used before come back with the
other styles.
---
 programs/explorer/explorer.rc        |  13 +++
 programs/explorer/explorer_private.h |   1 +
 programs/explorer/m3_computer.ico    | Bin 0 -> 6578 bytes
 programs/explorer/m3_documents.ico   | Bin 0 -> 12734 bytes
 programs/explorer/m3_drive.ico       | Bin 0 -> 11109 bytes
 programs/explorer/m3_folder.ico      | Bin 0 -> 6645 bytes
 programs/explorer/m3_folder_open.ico | Bin 0 -> 13828 bytes
 programs/explorer/m3settings.c       |   9 +-
 programs/explorer/material.c         | 136 +++++++++++++++++++++++++++
 programs/explorer/material.h         |   3 +
 programs/explorer/material_fonts.txt |   5 +
 programs/explorer/resource.h         |   8 ++
 programs/explorer/systray.c          |   7 ++
 13 files changed, 181 insertions(+), 1 deletion(-)
 create mode 100644 programs/explorer/m3_computer.ico
 create mode 100644 programs/explorer/m3_documents.ico
 create mode 100644 programs/explorer/m3_drive.ico
 create mode 100644 programs/explorer/m3_folder.ico
 create mode 100644 programs/explorer/m3_folder_open.ico

diff --git a/programs/explorer/explorer.rc b/programs/explorer/explorer.rc
index 20bc03f56..b0441f029 100644
--- a/programs/explorer/explorer.rc
+++ b/programs/explorer/explorer.rc
@@ -98,6 +98,7 @@ STRINGTABLE
     IDS_M3_CLASSIC_NOTE "The plain Wine taskbar and windows."
     IDS_M3_APP_COLORS   "Material colors in programs"
     IDS_M3_CONTROLS     "Material buttons and controls"
+    IDS_M3_APP_FONTS    "Roboto font in programs"
 }
 
 IDD_DISPLAY_PROPERTIES DIALOGEX 0, 0, 262, 306
@@ -140,6 +141,18 @@ LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
 /* @makedep: wine.ico */
 IDI_WINE_LOGO ICON wine.ico
 
+/* Material 3 shell icons, see material_fonts.txt */
+/* @makedep: m3_folder.ico */
+IDI_M3_FOLDER ICON m3_folder.ico
+/* @makedep: m3_folder_open.ico */
+IDI_M3_FOLDER_OPEN ICON m3_folder_open.ico
+/* @makedep: m3_drive.ico */
+IDI_M3_DRIVE ICON m3_drive.ico
+/* @makedep: m3_computer.ico */
+IDI_M3_COMPUTER ICON m3_computer.ico
+/* @makedep: m3_documents.ico */
+IDI_M3_DOCUMENTS ICON m3_documents.ico
+
 /* Wine XP desktop background: the emblem, centered on the line between the two colors */
 /* @makedep: wallpaper_light.bmp */
 IDB_WALLPAPER_LIGHT BITMAP wallpaper_light.bmp
diff --git a/programs/explorer/explorer_private.h b/programs/explorer/explorer_private.h
index cbe4f0a8c..9491d04df 100644
--- a/programs/explorer/explorer_private.h
+++ b/programs/explorer/explorer_private.h
@@ -46,6 +46,7 @@ struct display_settings
     BOOL wallpaper;
     BOOL controls;
     BOOL app_colors;  /* Material 3 system colors */
+    BOOL app_fonts;   /* Roboto in the programs */
 };
 
 extern void get_display_settings( struct display_settings *settings );
