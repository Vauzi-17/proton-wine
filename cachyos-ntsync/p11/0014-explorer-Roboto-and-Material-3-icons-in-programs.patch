+/*
+ * Roboto in the programs: the dialog font ("MS Shell Dlg") and the menu, status and message
+ * fonts. The fonts in use before are kept in the registry and put back for the other styles.
+ * The font substitutes are read when a process starts, so only new programs get the change.
+ */
+
+static const WCHAR fonts_key[] = L"Software\\Wine\\Explorer\\Taskbar\\Fonts";
+static const WCHAR substitutes_key[] = L"Software\\Microsoft\\Windows NT\\CurrentVersion\\FontSubstitutes";
+static const WCHAR * const dialog_fonts[] = { L"MS Shell Dlg", L"MS Shell Dlg 2" };
+
+static void set_roboto( LOGFONTW *font, int height )
+{
+    lstrcpyW( font->lfFaceName, L"Roboto" );
+    font->lfHeight = -MulDiv( height, GetDpiForSystem(), 96 );
+    font->lfWeight = FW_NORMAL;
+    font->lfQuality = DEFAULT_QUALITY;
+}
+
+void m3_apply_fonts( BOOL enable )
+{
+    NONCLIENTMETRICSW ncm = { sizeof(ncm) };
+    WCHAR value[LF_FACESIZE];
+    DWORD size, applied = 0;
+    HKEY hkey, substitutes;
+    unsigned int i;
+
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, fonts_key, 0, NULL, 0, KEY_QUERY_VALUE | KEY_SET_VALUE, NULL, &hkey, NULL ))
+        return;
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, substitutes_key, 0, NULL, 0, KEY_QUERY_VALUE | KEY_SET_VALUE, NULL,
+                         &substitutes, NULL ))
+    {
+        RegCloseKey( hkey );
+        return;
+    }
+    size = sizeof(applied);
+    RegGetValueW( hkey, NULL, L"Applied", RRF_RT_REG_DWORD, NULL, &applied, &size );
+
+    if (enable)
+    {
+        if (!applied)
+        {
+            /* remember the fonts of the programs, missing substitutes as empty strings */
+            SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+            RegSetValueExW( hkey, L"Metrics", 0, REG_BINARY, (const BYTE *)&ncm, sizeof(ncm) );
+            for (i = 0; i < ARRAY_SIZE(dialog_fonts); i++)
+            {
+                size = sizeof(value);
+                if (RegGetValueW( substitutes, NULL, dialog_fonts[i], RRF_RT_REG_SZ, NULL, value, &size )) value[0] = 0;
+                RegSetValueExW( hkey, dialog_fonts[i], 0, REG_SZ, (const BYTE *)value, (lstrlenW( value ) + 1) * sizeof(WCHAR) );
+            }
+            applied = 1;
+            RegSetValueExW( hkey, L"Applied", 0, REG_DWORD, (const BYTE *)&applied, sizeof(applied) );
+        }
+        for (i = 0; i < ARRAY_SIZE(dialog_fonts); i++)
+            RegSetValueExW( substitutes, dialog_fonts[i], 0, REG_SZ, (const BYTE *)L"Roboto", sizeof(L"Roboto") );
+        /* for this session only: the fonts come back when the style is changed and Wine restarts */
+        SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+        set_roboto( &ncm.lfMenuFont, 13 );
+        set_roboto( &ncm.lfStatusFont, 12 );
+        set_roboto( &ncm.lfMessageFont, 12 );
+        SystemParametersInfoW( SPI_SETNONCLIENTMETRICS, sizeof(ncm), &ncm, SPIF_SENDCHANGE );
+    }
+    else if (applied)
+    {
+        size = sizeof(ncm);
+        if (!RegGetValueW( hkey, NULL, L"Metrics", RRF_RT_REG_BINARY, NULL, &ncm, &size ) && size == sizeof(ncm))
+            SystemParametersInfoW( SPI_SETNONCLIENTMETRICS, sizeof(ncm), &ncm, SPIF_SENDCHANGE );
+        for (i = 0; i < ARRAY_SIZE(dialog_fonts); i++)
+        {
+            size = sizeof(value);
+            if (RegGetValueW( hkey, NULL, dialog_fonts[i], RRF_RT_REG_SZ, NULL, value, &size )) continue;
+            if (value[0])
+                RegSetValueExW( substitutes, dialog_fonts[i], 0, REG_SZ, (const BYTE *)value, (lstrlenW( value ) + 1) * sizeof(WCHAR) );
+            else RegDeleteValueW( substitutes, dialog_fonts[i] );
+        }
+        RegDeleteValueW( hkey, L"Applied" );
+    }
+    TRACE( "enable %d was applied %lu\n", enable, applied );
+    RegCloseKey( substitutes );
+    RegCloseKey( hkey );
+}
+
+/*
+ * Shell icons: Material symbols for folders, drives, the computer and the documents, as the
+ * default icons of their classes (HKEY_CLASSES_ROOT is the machine's classes in Wine). The
+ * shell reads them in each new process. Only the values set here are removed again.
+ */
+
+static const struct
+{
+    const WCHAR *key;
+    UINT id;
+} shell_icons[] =
+{
+    { L"Software\\Classes\\Folder\\DefaultIcon", IDI_M3_FOLDER },  /* the open folder is IDI_M3_FOLDER_OPEN */
+    { L"Software\\Classes\\Drive\\DefaultIcon", IDI_M3_DRIVE },
+    { L"Software\\Classes\\CLSID\\{20D04FE0-3AEA-1069-A2D8-08002B30309D}\\DefaultIcon", IDI_M3_COMPUTER },
+    { L"Software\\Classes\\CLSID\\{450D8FBA-AD25-11D0-98A8-0800361B1103}\\DefaultIcon", IDI_M3_DOCUMENTS },
+};
+
+void m3_apply_shell_icons( BOOL enable )
+{
+    WCHAR icon[MAX_PATH + 16], current[MAX_PATH + 16];
+    unsigned int i;
+
+    GetWindowsDirectoryW( icon, MAX_PATH );
+    lstrcatW( icon, L"\\explorer.exe" );
+    for (i = 0; i < ARRAY_SIZE(shell_icons); i++)
+    {
+        DWORD size = sizeof(current);
+        WCHAR value[MAX_PATH + 16];
+        BOOL ours;
+        HKEY hkey;
+
+        swprintf( value, ARRAY_SIZE(value), L"%s,-%u", icon, shell_icons[i].id );
+        ours = !RegGetValueW( HKEY_LOCAL_MACHINE, shell_icons[i].key, NULL, RRF_RT_REG_SZ, NULL, current, &size ) &&
+               !lstrcmpiW( current, value );
+        if (enable && !ours)
+        {
+            if (size != sizeof(current)) continue;  /* someone else's icon */
+            if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, shell_icons[i].key, 0, NULL, 0, KEY_SET_VALUE, NULL, &hkey, NULL ))
+                continue;
+            RegSetValueExW( hkey, NULL, 0, REG_SZ, (const BYTE *)value, (lstrlenW( value ) + 1) * sizeof(WCHAR) );
+            RegCloseKey( hkey );
+        }
+        else if (!enable && ours) RegDeleteKeyW( HKEY_LOCAL_MACHINE, shell_icons[i].key );
+    }
+}
