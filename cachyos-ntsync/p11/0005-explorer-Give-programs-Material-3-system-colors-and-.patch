     return m3_scheme( m3_accent, m3_is_dark() );
 }
 
+static COLORREF scheme_system_color( const struct m3_colors *c, int id )
+{
+    switch (id)
+    {
+    case COLOR_SCROLLBAR:        return c->surface_container_high;
+    case COLOR_BACKGROUND:       return c->surface_container_lowest;
+    case COLOR_ACTIVECAPTION:
+    case COLOR_GRADIENTACTIVECAPTION:
+    case COLOR_ACTIVEBORDER:     return c->surface_container_high;
+    case COLOR_INACTIVECAPTION:
+    case COLOR_GRADIENTINACTIVECAPTION:
+    case COLOR_INACTIVEBORDER:   return c->surface_container;
+    case COLOR_CAPTIONTEXT:      return c->on_surface;
+    case COLOR_INACTIVECAPTIONTEXT: return c->on_surface_variant;
+    case COLOR_MENU:
+    case COLOR_MENUBAR:
+    case COLOR_BTNFACE:          return c->surface_container;
+    case COLOR_WINDOW:           return c->surface;
+    case COLOR_WINDOWFRAME:      return c->outline_variant;
+    case COLOR_MENUTEXT:
+    case COLOR_WINDOWTEXT:
+    case COLOR_BTNTEXT:          return c->on_surface;
+    case COLOR_APPWORKSPACE:     return c->surface_container_low;
+    case COLOR_HIGHLIGHT:
+    case COLOR_MENUHILIGHT:      return c->primary_container;
+    case COLOR_HIGHLIGHTTEXT:    return c->on_primary_container;
+    case COLOR_GRAYTEXT:         return m3_blend( c->surface_container, c->on_surface, 97 );  /* 38% */
+    /* the 3D edges become a subtle outline */
+    case COLOR_BTNHIGHLIGHT:     return c->surface_container_highest;
+    case COLOR_3DLIGHT:          return c->surface_container_high;
+    case COLOR_BTNSHADOW:        return c->outline_variant;
+    case COLOR_3DDKSHADOW:       return c->outline;
+    case COLOR_INFOBK:           return c->inverse_surface;
+    case COLOR_INFOTEXT:         return c->inverse_on_surface;
+    case COLOR_HOTLIGHT:         return c->primary;
+    default:                     return GetSysColor( id );
+    }
+}
+
+/* the Material 3 colors, or the colors of the app back */
+void m3_apply_system_colors( BOOL enable )
+{
+    COLORREF current[SYSTEM_COLORS], colors[SYSTEM_COLORS], applied[SYSTEM_COLORS];
+    BOOL was_applied;
+    unsigned int i;
+    HKEY hkey;
+
+    init_app_colors();
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, colors_key, 0, NULL, 0, KEY_QUERY_VALUE | KEY_SET_VALUE,
+                         NULL, &hkey, NULL )) return;
+    get_system_colors( current );
+    was_applied = read_colors( hkey, L"Applied", applied ) && !memcmp( applied, current, sizeof(current) );
+
+    if (enable)
+    {
+        const struct m3_colors *scheme = m3_get_colors();
+
+        for (i = 0; i < SYSTEM_COLORS; i++) colors[i] = scheme_system_color( scheme, system_color_ids[i] );
+        if (memcmp( colors, current, sizeof(colors) ))
+        {
+            SetSysColors( SYSTEM_COLORS, system_color_ids, colors );
+            get_system_colors( colors );  /* as stored */
+        }
+        RegSetValueExW( hkey, L"Applied", 0, REG_BINARY, (const BYTE *)colors, sizeof(colors) );
+    }
+    else if (was_applied)
+    {
+        SetSysColors( SYSTEM_COLORS, system_color_ids, app_colors );
+        RegDeleteValueW( hkey, L"Applied" );
+    }
+    RegCloseKey( hkey );
+    TRACE( "enable %d was applied %d\n", enable, was_applied );
+}
