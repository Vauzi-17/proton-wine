+    unsigned int i;
 
     if (mode == M3_MODE_LIGHT) return FALSE;
     if (mode == M3_MODE_DARK) return TRUE;
-    color = GetSysColor( COLOR_WINDOW );
+    init_app_colors();
+    for (i = 0; i < SYSTEM_COLORS; i++) if (system_color_ids[i] == COLOR_WINDOW) break;
+    color = app_colors[i];
     return (GetRValue(color) * 299 + GetGValue(color) * 587 + GetBValue(color) * 114) / 1000 < 128;
 }
 
