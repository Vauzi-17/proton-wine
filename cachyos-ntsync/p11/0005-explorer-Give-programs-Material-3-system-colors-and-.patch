+/* The Material 3 frames of the programs (drawn by win32u in every process) use Roboto Medium:
+ * the fonts go to the Fonts folder, where the processes started afterwards find them. */
+void m3_install_fonts(void)
+{
+    static const struct { UINT id; const WCHAR *name; } fonts[] =
+    {
+        { IDR_FONT_ROBOTO, L"wine_m3_roboto.ttf" },
+        { IDR_FONT_ROBOTO_MEDIUM, L"wine_m3_roboto_medium.ttf" },
+    };
+    WIN32_FILE_ATTRIBUTE_DATA attr;
+    WCHAR path[MAX_PATH];
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(fonts); i++)
+    {
+        HRSRC res = FindResourceW( NULL, MAKEINTRESOURCEW( fonts[i].id ), (const WCHAR *)RT_RCDATA );
+        DWORD size, written;
+        HGLOBAL mem;
+        HANDLE file;
+        void *data;
+
+        if (!res || !(size = SizeofResource( NULL, res ))) continue;
+        if (!(mem = LoadResource( NULL, res )) || !(data = LockResource( mem ))) continue;
+        if (!GetWindowsDirectoryW( path, MAX_PATH - 40 )) return;
+        lstrcatW( path, L"\\Fonts\\" );
+        lstrcatW( path, fonts[i].name );
+        if (GetFileAttributesExW( path, GetFileExInfoStandard, &attr ) && !attr.nFileSizeHigh &&
+            attr.nFileSizeLow == size)
+            continue;
+        file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+        if (file == INVALID_HANDLE_VALUE)
+        {
+            WARN( "can't write %s\n", debugstr_w(path) );
+            continue;
+        }
+        if (!WriteFile( file, data, size, &written, NULL ) || written != size) WARN( "failed to write %s\n", debugstr_w(path) );
+        CloseHandle( file );
+    }
+}
+
