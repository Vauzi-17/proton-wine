+
+/*
+ * System colors. The app sets its light or dark window colors before Wine starts; in the
+ * Material 3 style they are replaced by the roles of the scheme, so that the programs
+ * drawing with the system colors match the desktop. The colors of the app are kept in
+ * the registry and put back for the other styles. "Auto" follows the colors of the app.
+ */
+
+static const int system_color_ids[] =
+{
+    COLOR_SCROLLBAR, COLOR_BACKGROUND, COLOR_ACTIVECAPTION, COLOR_INACTIVECAPTION, COLOR_MENU, COLOR_WINDOW,
+    COLOR_WINDOWFRAME, COLOR_MENUTEXT, COLOR_WINDOWTEXT, COLOR_CAPTIONTEXT, COLOR_ACTIVEBORDER,
+    COLOR_INACTIVEBORDER, COLOR_APPWORKSPACE, COLOR_HIGHLIGHT, COLOR_HIGHLIGHTTEXT, COLOR_BTNFACE,
+    COLOR_BTNSHADOW, COLOR_GRAYTEXT, COLOR_BTNTEXT, COLOR_INACTIVECAPTIONTEXT, COLOR_BTNHIGHLIGHT,
+    COLOR_3DDKSHADOW, COLOR_3DLIGHT, COLOR_INFOTEXT, COLOR_INFOBK, COLOR_HOTLIGHT, COLOR_GRADIENTACTIVECAPTION,
+    COLOR_GRADIENTINACTIVECAPTION, COLOR_MENUHILIGHT, COLOR_MENUBAR,
+};
+
+#define SYSTEM_COLORS ARRAY_SIZE(system_color_ids)
+
+static const WCHAR colors_key[] = L"Software\\Wine\\Explorer\\Taskbar\\SystemColors";
+static COLORREF app_colors[SYSTEM_COLORS];  /* the colors of the app */
+static BOOL app_colors_known;
+
+static void get_system_colors( COLORREF *colors )
+{
+    unsigned int i;
+
+    for (i = 0; i < SYSTEM_COLORS; i++) colors[i] = GetSysColor( system_color_ids[i] );
+}
+
+static BOOL read_colors( HKEY hkey, const WCHAR *name, COLORREF *colors )
+{
+    DWORD size = SYSTEM_COLORS * sizeof(COLORREF);
+
+    return !RegGetValueW( hkey, NULL, name, RRF_RT_REG_BINARY, NULL, colors, &size ) &&
+           size == SYSTEM_COLORS * sizeof(COLORREF);
+}
+
+/* the current colors are those of the app, unless they are the ones set last time */
+static void init_app_colors(void)
+{
+    COLORREF current[SYSTEM_COLORS], applied[SYSTEM_COLORS];
+    HKEY hkey;
+
+    if (app_colors_known) return;
+    app_colors_known = TRUE;
+    get_system_colors( current );
+    memcpy( app_colors, current, sizeof(app_colors) );
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, colors_key, 0, NULL, 0, KEY_QUERY_VALUE | KEY_SET_VALUE,
+                         NULL, &hkey, NULL )) return;
+    if (read_colors( hkey, L"Applied", applied ) && !memcmp( applied, current, sizeof(current) ))
+        read_colors( hkey, L"App", app_colors );
+    else
+    {
+        RegSetValueExW( hkey, L"App", 0, REG_BINARY, (const BYTE *)app_colors, sizeof(app_colors) );
+        RegDeleteValueW( hkey, L"Applied" );
+    }
     RegCloseKey( hkey );
 }
 
@@ -189,10 +255,13 @@ void m3_save_settings(void)
 BOOL m3_mode_is_dark( UINT mode )
 {
