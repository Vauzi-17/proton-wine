+ */
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <windows.h>
+
+#include "material.h"
+#include "palette.h"
+#include "resource.h"
+
+struct m3_colors m3;
+BOOL m3_dark;
+int m3_dpi = 96;
+
+static HFONT fonts[FONT_COUNT];
+static WCHAR text_face[LF_FACESIZE] = L"Roboto";
+
+int px( int value )
+{
+    return MulDiv( value, m3_dpi, 96 );
+}
+
+COLORREF m3_blend( COLORREF base, COLORREF over, BYTE alpha )
+{
+    return RGB( (GetRValue(base) * (255 - alpha) + GetRValue(over) * alpha) / 255,
+                (GetGValue(base) * (255 - alpha) + GetGValue(over) * alpha) / 255,
+                (GetBValue(base) * (255 - alpha) + GetBValue(over) * alpha) / 255 );
+}
+
+/*
+ * The scheme follows the Material 3 style of the explorer desktop: its accent, and its
+ * brightness, which is either set or follows the window colors of the app ("auto").
+ */
+BOOL m3_update_colors(void)
+{
+    DWORD accent = 0, mode = 0, size;
+    struct m3_colors colors;
+    COLORREF window;
+    HKEY hkey;
+    BOOL dark;
+
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, L"Software\\Wine\\Explorer\\Taskbar", 0, KEY_QUERY_VALUE, &hkey ))
+    {
+        size = sizeof(accent);
+        if (RegGetValueW( hkey, NULL, L"Accent", RRF_RT_REG_DWORD, NULL, &accent, &size )) accent = 0;
+        size = sizeof(mode);
+        if (RegGetValueW( hkey, NULL, L"Mode", RRF_RT_REG_DWORD, NULL, &mode, &size )) mode = 0;
+        RegCloseKey( hkey );
+    }
+    if (accent >= M3_ACCENTS) accent = 0;
+    window = GetSysColor( COLOR_WINDOW );
+    if (mode == 1) dark = FALSE;
+    else if (mode == 2) dark = TRUE;
+    else dark = (GetRValue(window) * 299 + GetGValue(window) * 587 + GetBValue(window) * 114) / 1000 < 128;
+
+    memcpy( &colors, m3_palettes[accent][dark], sizeof(colors) );
+    if (!memcmp( &colors, &m3, sizeof(m3) )) return FALSE;
+    m3 = colors;
+    m3_dark = dark;
+    return TRUE;
+}
+
+static void add_font_resource( UINT id )
+{
+    HRSRC res = FindResourceW( NULL, MAKEINTRESOURCEW(id), (LPCWSTR)RT_RCDATA );
+    DWORD count;
+
+    if (res) AddFontMemResourceEx( LockResource( LoadResource( NULL, res )), SizeofResource( NULL, res ), NULL, &count );
+}
+
+static int CALLBACK font_exists( const LOGFONTW *lf, const TEXTMETRICW *tm, DWORD type, LPARAM lparam )
+{
+    *(BOOL *)lparam = TRUE;
+    return 0;
+}
+
+void m3_init(void)
+{
+    HDC hdc = GetDC( 0 );
+    LOGFONTW lf = { 0 };
+    BOOL found = FALSE;
+
+    m3_dpi = GetDeviceCaps( hdc, LOGPIXELSY );
+    lf.lfCharSet = DEFAULT_CHARSET;
+    lstrcpyW( lf.lfFaceName, L"Roboto" );
+    EnumFontFamiliesExW( hdc, &lf, font_exists, (LPARAM)&found, 0 );
+    ReleaseDC( 0, hdc );
+    if (!found)
+    {
+        NONCLIENTMETRICSW ncm = { sizeof(ncm) };
+
+        SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+        lstrcpyW( text_face, ncm.lfMessageFont.lfFaceName );
+    }
+    add_font_resource( IDR_FONT_SYMBOLS );
+    add_font_resource( IDR_FONT_SYMBOLS_FILLED );
+    m3_update_colors();
+}
+
+HFONT m3_font( enum m3_font font )
+{
+    static const struct { int size, weight; BOOL icon, filled; } specs[FONT_COUNT] =
+    {
+        { 14, FW_NORMAL }, { 12, FW_NORMAL }, { 14, FW_MEDIUM }, { 16, FW_MEDIUM }, { 22, FW_NORMAL },
+        { 24, FW_NORMAL, TRUE }, { 20, FW_NORMAL, TRUE }, { 24, FW_NORMAL, TRUE, TRUE },
+        { 48, FW_NORMAL, TRUE, TRUE }, { 64, FW_NORMAL, TRUE },
+    };
+    LOGFONTW lf = { 0 };
+
+    if (fonts[font]) return fonts[font];
+    lf.lfHeight = -px( specs[font].size );
+    lf.lfWeight = specs[font].weight;
+    lf.lfCharSet = DEFAULT_CHARSET;
+    lf.lfQuality = ANTIALIASED_QUALITY;
+    if (specs[font].icon)
+        lstrcpyW( lf.lfFaceName, specs[font].filled ? L"Wine Files Symbols Filled" : L"Wine Files Symbols" );
+    else if (specs[font].weight == FW_MEDIUM && !lstrcmpW( text_face, L"Roboto" ))
+    {
+        /* the medium face is a family of its own */
+        lstrcpyW( lf.lfFaceName, L"Roboto Medium" );
+        lf.lfWeight = FW_NORMAL;
+    }
+    else lstrcpyW( lf.lfFaceName, text_face );
+    fonts[font] = CreateFontIndirectW( &lf );
+    return fonts[font];
+}
+
+void m3_text( HDC hdc, enum m3_font font, const WCHAR *text, int len, RECT *rect, UINT flags, COLORREF color )
+{
+    HGDIOBJ old = SelectObject( hdc, m3_font( font ));
+
+    SetBkMode( hdc, TRANSPARENT );
+    SetTextColor( hdc, color );
+    DrawTextW( hdc, text, len, rect, flags | DT_NOPREFIX );
+    SelectObject( hdc, old );
+}
+
+void m3_icon( HDC hdc, enum m3_font font, WCHAR glyph, const RECT *rect, COLORREF color )
+{
+    RECT rc = *rect;
+
+    m3_text( hdc, font, &glyph, 1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOCLIP, color );
+}
+
+void m3_fill( HDC hdc, const RECT *rect, COLORREF color )
+{
+    SetDCBrushColor( hdc, color );
+    FillRect( hdc, rect, GetStockObject( DC_BRUSH ));
+}
+
+/*
+ * Shapes. GDI has no anti-aliasing, so the coverage of each pixel is computed from the
+ * signed distance to the shape and the result is alpha blended onto the target.
+ */
+
+struct shape
+{
+    float cx, cy;  /* center */
+    float hw, hh;  /* half size */
+    float radius;
+};
+
+static float shape_distance( const struct shape *s, float x, float y )
+{
+    float qx = fabsf( x - s->cx ) - (s->hw - s->radius);
+    float qy = fabsf( y - s->cy ) - (s->hh - s->radius);
+    float ox = qx > 0 ? qx : 0, oy = qy > 0 ? qy : 0;
+    float inside = qx > qy ? qx : qy;
+
+    return sqrtf( ox * ox + oy * oy ) + (inside < 0 ? inside : 0) - s->radius;
+}
+
+static float clamp01( float value )
+{
+    return value < 0 ? 0 : value > 1 ? 1 : value;
+}
+
+static HBITMAP create_dib( int width, int height, DWORD **bits )
+{
+    BITMAPINFO info;
+
+    memset( &info, 0, sizeof(info) );
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    return CreateDIBSection( 0, &info, DIB_RGB_COLORS, (void **)bits, NULL, 0 );
+}
+
+static DWORD premultiply( COLORREF color, unsigned int a )
+{
+    if (!a) return 0;
+    return (a << 24) | ((GetRValue(color) * a / 255) << 16) | ((GetGValue(color) * a / 255) << 8) |
+           (GetBValue(color) * a / 255);
+}
+
+static void blend_dib( HDC hdc, int x, int y, int width, int height, HBITMAP dib )
+{
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    HDC mem = CreateCompatibleDC( hdc );
+    HGDIOBJ old = SelectObject( mem, dib );
+
+    GdiAlphaBlend( hdc, x, y, width, height, mem, 0, 0, width, height, blend );
+    SelectObject( mem, old );
+    DeleteDC( mem );
+}
+
+static void paint_shape( HDC hdc, const RECT *rect, int radius, int line, COLORREF color, BYTE alpha )
+{
+    int width = rect->right - rect->left, height = rect->bottom - rect->top, i, j;
+    struct shape s;
+    HBITMAP dib;
+    DWORD *bits;
+
+    if (width <= 0 || height <= 0 || !alpha) return;
+    if (!(dib = create_dib( width, height, &bits ))) return;
+    s.cx = s.hw = width / 2.0f;
+    s.cy = s.hh = height / 2.0f;
+    s.radius = min( radius, min( width, height ) / 2 );
+    for (j = 0; j < height; j++)
+    {
+        for (i = 0; i < width; i++)
+        {
+            float d = shape_distance( &s, i + 0.5f, j + 0.5f ), cover;
+
+            if (line) cover = clamp01( 0.5f - d ) - clamp01( 0.5f - (d + line) );
+            else cover = clamp01( 0.5f - d );
+            bits[j * width + i] = premultiply( color, (unsigned int)(cover * alpha + 0.5f) );
+        }
+    }
+    blend_dib( hdc, rect->left, rect->top, width, height, dib );
+    DeleteObject( dib );
+}
+
+void m3_round_rect( HDC hdc, const RECT *rect, int radius, COLORREF color, BYTE alpha )
+{
+    if (radius <= 0 && alpha == 255) m3_fill( hdc, rect, color );
+    else paint_shape( hdc, rect, radius, 0, color, alpha );
+}
+
+void m3_round_frame( HDC hdc, const RECT *rect, int radius, int line, COLORREF color, BYTE alpha )
+{
+    paint_shape( hdc, rect, radius, line, color, alpha );
+}
+
+/* an arc of a circle with round ends, angles in degrees clockwise from 12 o'clock */
+void m3_arc( HDC hdc, int cx, int cy, int radius, int line, float start, float sweep, COLORREF color )
+{
+    int size = 2 * (radius + line), i, j, k;
+    float half = line / 2.0f, rad = 3.14159265f / 180;
+    float ends[2][2];
+    HBITMAP dib;
+    DWORD *bits;
+
+    if (!(dib = create_dib( size, size, &bits ))) return;
+    for (k = 0; k < 2; k++)
+    {
+        float a = (start + k * sweep) * rad;
+        ends[k][0] = size / 2.0f + radius * sinf( a );
+        ends[k][1] = size / 2.0f - radius * cosf( a );
+    }
+    for (j = 0; j < size; j++)
+    {
+        for (i = 0; i < size; i++)
+        {
+            float x = i + 0.5f - size / 2.0f, y = j + 0.5f - size / 2.0f, d;
+            float angle = atan2f( x, -y ) / rad;
+
+            if (angle < 0) angle += 360;
+            angle -= start;
+            while (angle < 0) angle += 360;
+            while (angle >= 360) angle -= 360;
+            if (angle <= sweep) d = fabsf( sqrtf( x * x + y * y ) - radius ) - half;
+            else
+            {
+                float d0 = hypotf( i + 0.5f - ends[0][0], j + 0.5f - ends[0][1] );
+                float d1 = hypotf( i + 0.5f - ends[1][0], j + 0.5f - ends[1][1] );
+                d = min( d0, d1 ) - half;
+            }
+            bits[j * size + i] = premultiply( color, (unsigned int)(clamp01( 0.5f - d ) * 255 + 0.5f) );
+        }
+    }
+    blend_dib( hdc, cx - size / 2, cy - size / 2, size, size, dib );
+    DeleteObject( dib );
+}
+
+/* the coverage of a symbol, drawn white on black */
+static BYTE *glyph_mask( WCHAR glyph, const WCHAR *face, int size, int box )
+{
+    BYTE *mask = malloc( box * box );
+    LOGFONTW lf = { 0 };
+    HBITMAP dib;
+    DWORD *bits;
+    HGDIOBJ old_font, old;
+    HFONT font;
+    RECT rc;
+    HDC mem;
+    int i;
+
+    if (!mask) return NULL;
+    if (!(dib = create_dib( box, box, &bits )))
+    {
+        free( mask );
+        return NULL;
+    }
+    lf.lfHeight = -size;
+    lf.lfQuality = ANTIALIASED_QUALITY;
+    lf.lfCharSet = DEFAULT_CHARSET;
+    lstrcpyW( lf.lfFaceName, face );
+    font = CreateFontIndirectW( &lf );
+    mem = CreateCompatibleDC( 0 );
+    old = SelectObject( mem, dib );
+    old_font = SelectObject( mem, font );
+    SetRect( &rc, 0, 0, box, box );
+    FillRect( mem, &rc, GetStockObject( BLACK_BRUSH ));
+    SetBkMode( mem, TRANSPARENT );
+    SetTextColor( mem, RGB(255,255,255) );
+    DrawTextW( mem, &glyph, 1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOCLIP );
+    GdiFlush();
+    for (i = 0; i < box * box; i++) mask[i] = (GetRValue(bits[i]) + GetGValue(bits[i]) + GetBValue(bits[i])) / 3;
+    SelectObject( mem, old_font );
+    SelectObject( mem, old );
+    DeleteDC( mem );
+    DeleteObject( font );
+    DeleteObject( dib );
+    return mask;
+}
+
+/* the window icon: a folder on a rounded square in the colors of the scheme */
+HICON m3_create_app_icon( int size )
+{
+    int radius = size * 7 / 24, i, j;
+    ICONINFO info = { TRUE };
+    struct shape s;
+    HBITMAP dib;
+    DWORD *bits;
+    BYTE *mask;
+    HICON icon;
+
+    if (!(dib = create_dib( size, size, &bits ))) return 0;
+    mask = glyph_mask( ICON_FOLDER, L"Wine Files Symbols Filled", size * 2 / 3, size );
+    s.cx = s.hw = size / 2.0f;
+    s.cy = s.hh = size / 2.0f;
+    s.radius = radius;
+    for (j = 0; j < size; j++)
+    {
+        for (i = 0; i < size; i++)
+        {
+            float cover = clamp01( 0.5f - shape_distance( &s, i + 0.5f, j + 0.5f ));
+            BYTE a = mask ? mask[j * size + i] : 0;
+            COLORREF color = m3_blend( m3.primary_container, m3.on_primary_container, a );
+
+            bits[j * size + i] = premultiply( color, (unsigned int)(cover * 255 + 0.5f) );
+        }
+    }
+    free( mask );
+    info.hbmColor = dib;
+    info.hbmMask = CreateBitmap( size, size, 1, 1, NULL );
+    icon = CreateIconIndirect( &info );
+    DeleteObject( info.hbmMask );
+    DeleteObject( dib );
+    return icon;
+}
+
+HDC m3_begin_paint( struct m3_buffer *buffer, HDC target, const RECT *rect )
+{
+    buffer->target = target;
+    buffer->rect = *rect;
+    buffer->hdc = CreateCompatibleDC( target );
+    buffer->bitmap = CreateCompatibleBitmap( target, max( rect->right - rect->left, 1 ),
+                                             max( rect->bottom - rect->top, 1 ));
+    buffer->old = SelectObject( buffer->hdc, buffer->bitmap );
+    SetViewportOrgEx( buffer->hdc, -rect->left, -rect->top, NULL );
+    return buffer->hdc;
+}
+
+void m3_end_paint( struct m3_buffer *buffer )
+{
+    SetViewportOrgEx( buffer->hdc, 0, 0, NULL );
+    BitBlt( buffer->target, buffer->rect.left, buffer->rect.top, buffer->rect.right - buffer->rect.left,
+            buffer->rect.bottom - buffer->rect.top, buffer->hdc, 0, 0, SRCCOPY );
+    SelectObject( buffer->hdc, buffer->old );
+    DeleteObject( buffer->bitmap );
+    DeleteDC( buffer->hdc );
+}
