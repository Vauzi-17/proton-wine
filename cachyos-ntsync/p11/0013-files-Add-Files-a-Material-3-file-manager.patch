+static const struct {
+    WCHAR glyph;
+    const wchar_t* extensions;  /* space separated, with spaces around */
+} file_types[] = {
+    {ICON_IMAGE, L" png jpg jpeg gif bmp webp tga dds tif tiff svg psd "},
+    {ICON_MOVIE, L" mp4 mkv avi mov wmv webm flv m4v mpg mpeg bik "},
+    {ICON_MUSIC_NOTE, L" mp3 wav ogg flac m4a aac wma opus mid midi "},
+    {ICON_FOLDER_ZIP, L" zip rar 7z tar gz tgz xz bz2 zst cab lzma pak "},
+    {ICON_ALBUM, L" iso bin cue img mdf mds nrg "},
+    {ICON_TERMINAL, L" bat cmd ps1 sh vbs "},
+    {ICON_EXTENSION, L" dll sys ocx drv ax asi "},
+    {ICON_PICTURE_AS_PDF, L" pdf "},
+    {ICON_FONT_DOWNLOAD, L" ttf otf fon ttc woff "},
+    {ICON_CODE, L" c h cpp hpp cs py js lua java json xml html htm css yml yaml toml "},
+    {ICON_SETTINGS, L" ini cfg conf reg inf "},
+    {ICON_ARTICLE, L" txt log md rtf doc docx nfo "},
+};
+
+void getNodeIcon(struct FileNode* node, struct NodeIcon* icon) {
+    icon->filled = true;
+    icon->accent = false;
+    icon->shell = false;
+
+    switch (node->type) {
+        case TYPE_DIR:
+            icon->glyph = ICON_FOLDER;
+            icon->accent = true;
+            return;
+        case TYPE_DRIVE:
+            icon->glyph = isCDDrivePath(node->name) ? ICON_ALBUM : ICON_HARD_DRIVE;
+            return;
+        case TYPE_DESKTOP:
+            icon->glyph = ICON_DESKTOP_WINDOWS;
+            return;
+        case TYPE_PERSONAL:
+            icon->glyph = ICON_DESCRIPTION;
+            return;
+        case TYPE_COMPUTER:
+            icon->glyph = ICON_COMPUTER;
+            return;
+        case TYPE_FILE:
+            break;
+    }
+
+    icon->filled = false;
+    icon->glyph = ICON_DRAFT;
+
+    wchar_t* ext = getFileExtension(node->name);
+    if (!ext || wcslen(ext) > 8) return;
+
+    wchar_t key[12] = {0};
+    swprintf_s(key, 12, L" %ls ", ext);
+    for (wchar_t* p = key; *p; p++) *p = towlower(*p);
+
+    if (wcsstr(L" exe msi lnk ico cpl scr url ", key)) {
+        icon->glyph = ICON_APPS;
+        icon->shell = true;
+        return;
+    }
+    for (int i = 0; i < sizeof(file_types) / sizeof(file_types[0]); i++) {
+        if (wcsstr(file_types[i].extensions, key)) {
+            icon->glyph = file_types[i].glyph;
+            return;
+        }
+    }
+}
