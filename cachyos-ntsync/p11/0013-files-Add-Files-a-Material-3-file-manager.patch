+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <windows.h>
+
+#include "resource.h"
+
+LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
+
+/* @makedep: files.ico */
+IDI_MAIN ICON files.ico
+
+/* Material Symbols, see fonts.txt */
+/* @makedep: files_symbols.ttf */
+IDR_FONT_SYMBOLS RCDATA files_symbols.ttf
+/* @makedep: files_symbols_filled.ttf */
+IDR_FONT_SYMBOLS_FILLED RCDATA files_symbols_filled.ttf
+
+/* @makedep: files.manifest */
+1 RT_MANIFEST files.manifest
+
+IDD_INPUT DIALOGEX 0, 0, 239, 61
+STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
+CAPTION "Dialog"
+FONT 9, "MS Shell Dlg", 400, 0, 0x1
+BEGIN
+    DEFPUSHBUTTON "OK", IDOK, 125, 41, 50, 14
+    PUSHBUTTON "Cancel", IDCANCEL, 182, 41, 50, 14
+    LTEXT "Label", IDC_LABEL, 6, 6, 226, 12
+    EDITTEXT IDC_EDIT, 6, 21, 226, 12, ES_AUTOHSCROLL
+END
+
+IDD_ABOUT DIALOGEX 0, 0, 170, 70
+STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
+CAPTION "Dialog"
+FONT 9, "MS Shell Dlg", 400, 0, 0x1
+BEGIN
+    ICON IDI_MAIN, IDC_STATIC, 140, 10, 20, 20
+    LTEXT "Label1", IDC_APP_NAME, 7, 7, 128, 12
+    LTEXT "Label2", IDC_APP_VERSION, 7, 19, 128, 9
+    LTEXT "Label3", IDC_APP_DEV_NAME, 7, 31, 128, 16
+    DEFPUSHBUTTON "OK", IDOK, 60, 50, 50, 14, WS_GROUP
+END
+
+IDD_FILE_ACTION DIALOGEX 0, 0, 160, 90
+STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
+CAPTION "Dialog"
+FONT 9, "MS Shell Dlg", 400, 0, 0x1
+BEGIN
+    CONTROL "", IDC_PRELOADER, "Static", SS_OWNERDRAW, 60, 8, 40, 40
+    CTEXT "Label", IDC_LABEL, 0, 55, 160, 10
