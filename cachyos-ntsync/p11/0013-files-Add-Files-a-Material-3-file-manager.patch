+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "main.h"
+
+#define FOOTER_HEIGHT 32
+#define SPLITTER_WIDTH 8
+
+static const wchar_t mainWndClass[] = L"WFM-MainWnd";
+
+extern struct FileNode* currPathFileNode;
+extern HWND hwndContentView;
+extern HWND hwndTreeview;
+
+HINSTANCE globalHInstance = NULL;
+HWND hwndMain = NULL;
+struct LC_STR lc_str = {0};
+
+static wchar_t statusText[64];
+static int treeviewWidth;
+static bool isSizing;
+static int sizingOffset;
+static RECT cardRect, splitterRect, footerRect;
+static HICON smallIcon, bigIcon;
+
+void GetWindowRectInParent(HWND hwnd, RECT* rect) {
+    GetWindowRect(hwnd, rect);
+    MapWindowPoints(HWND_DESKTOP, GetParent(hwnd), (LPPOINT)rect, 2);
+}
+
+INT_PTR CALLBACK AboutDialogProc(HWND hwndDlg, UINT msg, WPARAM wParam, LPARAM lParam) {
+    switch (msg) {
+        case WM_COMMAND: {
+            switch (LOWORD(wParam)) {
+                case IDOK:
+                case IDCANCEL: {
+                  EndDialog(hwndDlg, (INT_PTR) LOWORD(wParam));
+                  return (INT_PTR) TRUE;
+                }
+            }
+            break;
+        }
+        case WM_INITDIALOG: {
+            RECT rect, rect1;
+            wchar_t text[128];
+            GetWindowRect(GetParent(hwndDlg), &rect);
+            GetClientRect(hwndDlg, &rect1);
+            SetWindowPos(hwndDlg, NULL, (rect.right + rect.left) / 2 - (rect1.right - rect1.left) / 2, (rect.bottom + rect.top) / 2 - (rect1.bottom - rect1.top) / 2, 0, 0, SWP_NOZORDER | SWP_NOSIZE);
+
+            SetWindowText(hwndDlg, lc_str.about);
+            SetWindowText(GetDlgItem(hwndDlg, IDC_APP_NAME), lc_str.app_name);
+            SetWindowText(GetDlgItem(hwndDlg, IDC_APP_VERSION), lc_str.app_version);
+            swprintf_s(text, 128, L"%ls %ls", lc_str.based_on, lc_str.app_dev_name);
+            SetWindowText(GetDlgItem(hwndDlg, IDC_APP_DEV_NAME), text);
+            SendDlgItemMessage(hwndDlg, IDC_STATIC, STM_SETICON, (WPARAM)bigIcon, 0);
+            return (INT_PTR)TRUE;
+        }
+    }
+
+    return (INT_PTR)FALSE;
+}
+
+void mainMenuCommand(WPARAM wParam) {
+    switch (LOWORD(wParam)) {
+        case ID_EDIT_CUT:
+            onMenuItemCutClick();
+            break;
+        case ID_EDIT_COPY:
+            onMenuItemCopyClick();
+            break;
+        case ID_EDIT_PASTE:
+            onMenuItemPasteClick();
+            break;
+        case ID_EDIT_PASTE_SHORTCUT:
+            onMenuItemPasteShortcutClick();
+            break;
+        case ID_EDIT_SELECT_ALL:
+            onMenuItemSelectAllClick();
+            break;
+        case ID_HELP_ABOUT:
+            DialogBox(globalHInstance, MAKEINTRESOURCE(IDD_ABOUT), hwndMain, &AboutDialogProc);
+            break;
+        case ID_FILE_EXIT:
+            SendMessage(hwndMain, WM_CLOSE, 0, 0);
+            break;
+        case ID_VIEW_LARGEICONS:
+            setViewStyle(STYLE_LARGE_ICON);
+            break;
+        case ID_VIEW_SMALLICONS:
+            setViewStyle(STYLE_SMALL_ICON);
+            break;
+        case ID_VIEW_LIST:
+            setViewStyle(STYLE_LIST);
+            break;
+        case ID_VIEW_DETAILS:
+            setViewStyle(STYLE_DETAILS);
+            break;
+        case ID_VIEW_REFRESH:
+            navigateRefresh();
+            break;
+    }
+    updateHeaderActions();
+}
+
+/* the menu of the more button, in place of the menu bar */
+void showOverflowMenu(int x, int y) {
+    static const int views[] = {ID_VIEW_LARGEICONS, ID_VIEW_SMALLICONS, ID_VIEW_LIST, ID_VIEW_DETAILS};
+    HMENU menu = CreatePopupMenu();
+    enum ViewStyle style = getViewStyle();
+    int cmd;
+
+    AppendMenu(menu, MF_STRING, ID_VIEW_LARGEICONS, lc_str.large_icons);
+    AppendMenu(menu, MF_STRING, ID_VIEW_SMALLICONS, lc_str.small_icons);
+    AppendMenu(menu, MF_STRING, ID_VIEW_LIST, lc_str.list);
+    AppendMenu(menu, MF_STRING, ID_VIEW_DETAILS, lc_str.details);
+    CheckMenuRadioItem(menu, ID_VIEW_LARGEICONS, ID_VIEW_DETAILS, views[style], MF_BYCOMMAND);
+    AppendMenu(menu, MF_SEPARATOR, 0, NULL);
+    AppendMenu(menu, MF_STRING, ID_EDIT_SELECT_ALL, lc_str.select_all);
+    AppendMenu(menu, MF_STRING | (hasClipboardFiles() ? 0 : MF_GRAYED), ID_EDIT_PASTE_SHORTCUT, lc_str.paste_shortcut);
+    AppendMenu(menu, MF_STRING, ID_VIEW_REFRESH, lc_str.refresh);
+    AppendMenu(menu, MF_SEPARATOR, 0, NULL);
+    AppendMenu(menu, MF_STRING, ID_HELP_ABOUT, lc_str.about);
+    AppendMenu(menu, MF_STRING, ID_FILE_EXIT, lc_str.exit);
+
+    cmd = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTALIGN | TPM_TOPALIGN, x, y, 0, hwndMain, NULL);
+    DestroyMenu(menu);
+    if (cmd) mainMenuCommand(cmd);
+}
+
+void setStatusbarText(wchar_t* text) {
+    wcscpy_s(statusText, 64, text);
+    InvalidateRect(hwndMain, &footerRect, FALSE);
+}
+
+void resizeControls(void) {
+    RECT rect;
+    int headerHeight = getHeaderHeight(), pad = px(8), footer = px(FOOTER_HEIGHT);
+
+    GetClientRect(hwndMain, &rect);
+    SetWindowPos(getHeaderWindow(), NULL, 0, 0, rect.right, headerHeight, SWP_NOZORDER);
+
+    if (treeviewWidth > rect.right - px(240)) treeviewWidth = max(px(120), rect.right - px(240));
+    SetRect(&footerRect, 0, rect.bottom - footer, rect.right, rect.bottom);
+    SetWindowPos(hwndTreeview, NULL, pad, headerHeight, treeviewWidth, footerRect.top - headerHeight, SWP_NOZORDER);
+    SetRect(&splitterRect, pad + treeviewWidth, headerHeight, pad + treeviewWidth + px(SPLITTER_WIDTH), footerRect.top);
+    SetRect(&cardRect, splitterRect.right, headerHeight, rect.right - px(12), footerRect.top);
+    SetWindowPos(hwndContentView, NULL, cardRect.left + px(4), cardRect.top + px(8),
+                 cardRect.right - cardRect.left - px(8), cardRect.bottom - cardRect.top - px(16), SWP_NOZORDER);
+    InvalidateRect(hwndMain, NULL, FALSE);
+}
+
+static void paintMain(HWND hwnd) {
+    struct m3_buffer buffer;
+    PAINTSTRUCT ps;
+    RECT client, rc;
+    HDC hdc;
+
+    BeginPaint(hwnd, &ps);
+    GetClientRect(hwnd, &client);
+    hdc = m3_begin_paint(&buffer, ps.hdc, &client);
+    m3_fill(hdc, &client, m3.surface_container);
+    m3_round_rect(hdc, &cardRect, px(16), m3.surface, 255);
+    if (isSizing) {
+        rc = splitterRect;
+        InflateRect(&rc, -px(3), -px(16));
+        m3_round_rect(hdc, &rc, px(1), m3.outline, 255);
+    }
+    rc = footerRect;
+    rc.left = cardRect.left + px(16);
+    m3_text(hdc, FONT_BODY_SMALL, statusText, -1, &rc, DT_LEFT | DT_VCENTER | DT_SINGLELINE, m3.on_surface_variant);
+    m3_end_paint(&buffer);
+    EndPaint(hwnd, &ps);
+}
+
+void updateColors(void) {
+    if (!m3_update_colors()) return;
+
+    DestroyIcon(smallIcon);
+    DestroyIcon(bigIcon);
+    smallIcon = m3_create_app_icon(GetSystemMetrics(SM_CXSMICON));
+    bigIcon = m3_create_app_icon(GetSystemMetrics(SM_CXICON));
+    SendMessage(hwndMain, WM_SETICON, ICON_SMALL, (LPARAM)smallIcon);
+    SendMessage(hwndMain, WM_SETICON, ICON_BIG, (LPARAM)bigIcon);
+
+    updateHeaderColors();
+    updateContentColors();
+    TreeView_SetBkColor(hwndTreeview, m3.surface_container);
+    TreeView_SetTextColor(hwndTreeview, m3.on_surface);
+    RedrawWindow(hwndMain, NULL, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN);
+}
+
+LRESULT CALLBACK MainWndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
+    switch (msg) {
+        case WM_SIZE: {
+            resizeControls();
+            break;
+        }
+        case WM_PAINT:
+            paintMain(hwnd);
+            return 0;
+        case WM_ERASEBKGND:
+            return 1;
+        case WM_SETCURSOR: {
+            POINT pt;
+            GetCursorPos(&pt);
+            ScreenToClient(hwnd, &pt);
+            if ((HWND)wParam == hwnd && PtInRect(&splitterRect, pt)) {
+                SetCursor(LoadCursor(NULL, IDC_SIZEWE));
+                return TRUE;
+            }
+            break;
+        }
+        case WM_LBUTTONDOWN: {
+            POINT pt = {(short)LOWORD(lParam), (short)HIWORD(lParam)};
+            if (PtInRect(&splitterRect, pt)) {
+                isSizing = true;
+                sizingOffset = pt.x - splitterRect.left;
+                SetCapture(hwnd);
+                InvalidateRect(hwnd, &splitterRect, FALSE);
+            }
+            return 0;
+        }
+        case WM_MOUSEMOVE: {
+            if (isSizing) {
+                int x = (short)LOWORD(lParam) - sizingOffset - px(8);
+                RECT rect;
+                GetClientRect(hwnd, &rect);
+                treeviewWidth = max(px(120), min(x, rect.right - px(240)));
+                resizeControls();
+            }
+            return 0;
+        }
+        case WM_LBUTTONUP:
+        case WM_CAPTURECHANGED: {
+            if (isSizing) {
+                isSizing = false;
+                if (GetCapture() == hwnd) ReleaseCapture();
+                InvalidateRect(hwnd, NULL, FALSE);
+            }
+            return 0;
+        }
+        case WM_COMMAND: {
+            if (lParam == 0 && HIWORD(wParam) == 0) {
+                mainMenuCommand(wParam);
+                return 0;
+            }
+            break;
+        }
+        case WM_SYSCOMMAND: {
+            switch (LOWORD(wParam)) {
+                case ID_HELP_ABOUT: {
+                    DialogBox(globalHInstance, MAKEINTRESOURCE(IDD_ABOUT), hwnd, &AboutDialogProc);
+                    return 0;
+                }
+            }
+            break;
+        }
+        case WM_SYSCOLORCHANGE:
+        case WM_THEMECHANGED:
+        case WM_SETTINGCHANGE:
+            updateColors();
+            break;
+        case WM_SETFOCUS:
+            SetFocus(hwndContentView);
+            return 0;
+        case WM_CLOSE: {
+            if (MessageBox(hwnd, lc_str.msg_confirm_exit_app, lc_str.confirm_exit, MB_YESNO | MB_ICONQUESTION) == IDYES) {
+                PostQuitMessage(0);
+            }
+            return 0;
+        }
+        case WM_DESTROY: {
+            PostQuitMessage(0);
+            return 0;
+        }
+        case WM_NOTIFY: {
+            NMHDR* nmhdr = (NMHDR*)lParam;
+            if (nmhdr->hwndFrom == hwndContentView) {
+                return contentViewNotify(nmhdr);
+            }
+            else if (nmhdr->hwndFrom == hwndTreeview) {
+                return treeviewNotify(nmhdr);
+            }
+            else return 0;
+        }
+    }
+    return DefWindowProc(hwnd, msg, wParam, lParam);
+}
+
+void navigateToFileNode(struct FileNode* node) {
+    if (node) {
+        clearContentView();
+        setCurrPathFileNode(node);
+        navigateRefresh();
+    }
+}
+
+void navigateToPath(wchar_t* path) {
+    if (path) {
+        clearContentView();
+        setCurrPathFromString(path);
+        navigateRefresh();
+    }
+}
+
+void navigateUp(void) {
+    if (currPathFileNode->parent) {
+        clearContentView();
+        setCurrPathFileNode(currPathFileNode->parent);
+        navigateRefresh();
+    }
+}
+
+void navigateRefresh(void) {
+    if (currPathFileNode) {
+        buildChildNodes(currPathFileNode, false);
+        SetWindowText(hwndMain, currPathFileNode->name);
+        updateHeader();
+        refreshContentView();
+    }
+}
+
+void openFileNode(struct FileNode* node) {
+    if (node->type == TYPE_FILE) {
+        wchar_t path[MAX_PATH] = {0};
+        wchar_t parentPath[MAX_PATH] = {0};
+        getFileNodePath(node, path);
+        getFileNodePath(node->parent, parentPath);
+        ShellExecute(hwndMain, L"open", path, NULL, parentPath, SW_SHOW);
+    }
+    else navigateToFileNode(node);
+}
+
+int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, PSTR lpCmdLine, int nCmdShow) {
+    int numArgs;
+    wchar_t** args = CommandLineToArgvW(GetCommandLineW(), &numArgs);
+    INITCOMMONCONTROLSEX icex = {sizeof(icex), ICC_LISTVIEW_CLASSES | ICC_TREEVIEW_CLASSES | ICC_STANDARD_CLASSES};
+
+    wchar_t localeName[16] = {0};
+    GetUserDefaultLocaleName(localeName, 16);
+
+    loadLCStrings(localeName);
+
+    globalHInstance = hInstance;
+    InitCommonControlsEx(&icex);
+    CoInitialize(NULL);
+    m3_init();
+
+    WNDCLASSEX wcx = {0};
+    wcx.cbSize = sizeof(wcx);
+    wcx.style = CS_HREDRAW | CS_VREDRAW;
+    wcx.lpfnWndProc = &MainWndProc;
+    wcx.cbClsExtra = 0;
+    wcx.cbWndExtra = 0;
+    wcx.hInstance = hInstance;
+    wcx.hIcon = LoadIcon(hInstance, MAKEINTRESOURCE(IDI_MAIN));
+    wcx.hCursor = LoadCursor(NULL, IDC_ARROW);
+    wcx.hbrBackground = NULL;
+    wcx.lpszClassName = mainWndClass;
+    wcx.hIconSm = LoadIcon(hInstance, MAKEINTRESOURCE(IDI_MAIN));
+
+    if (!RegisterClassEx(&wcx)) return 0;
+
+    initFileNodes();
+
+    HWND hwndDesktop = GetDesktopWindow();
+    RECT desktopRect;
+    GetWindowRect(hwndDesktop, &desktopRect);
+    int hwndWidth = (desktopRect.right - desktopRect.left) * 0.8f;
+    int hwndHeight = (desktopRect.bottom - desktopRect.top) * 0.8f;
+
+    hwndMain = CreateWindowEx(0, mainWndClass, L"", WS_CLIPCHILDREN | WS_OVERLAPPEDWINDOW,
+                              CW_USEDEFAULT, CW_USEDEFAULT, hwndWidth, hwndHeight, NULL, NULL, hInstance, NULL);
+    if (!hwndMain) return 0;
+
+    smallIcon = m3_create_app_icon(GetSystemMetrics(SM_CXSMICON));
+    bigIcon = m3_create_app_icon(GetSystemMetrics(SM_CXICON));
+    SendMessage(hwndMain, WM_SETICON, ICON_SMALL, (LPARAM)smallIcon);
+    SendMessage(hwndMain, WM_SETICON, ICON_BIG, (LPARAM)bigIcon);
+
+    treeviewWidth = max(px(200), hwndWidth / 5);
+    createHeader();
+    createTreeview();
+    createContentView();
+
+    setViewStyle(STYLE_DETAILS);
+
+    if (numArgs > 1) {
+        navigateToPath(args[1]);
+    }
+    else navigateRefresh();
+    resizeControls();
+
+    ShowWindow(hwndMain, SW_SHOW);
+    UpdateWindow(hwndMain);
+    SetFocus(hwndContentView);
+
+    MSG msg;
+    while(GetMessage(&msg, NULL, 0, 0) > 0) {
+        TranslateMessage(&msg);
+        DispatchMessage(&msg);
+    }
+
+    return (int)msg.wParam;
+}
