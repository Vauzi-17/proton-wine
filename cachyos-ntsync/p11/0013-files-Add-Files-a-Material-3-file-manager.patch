diff --git a/programs/files/header.c b/programs/files/header.c
new file mode 100644
index 000000000..a29a2b32e
--- /dev/null
+++ b/programs/files/header.c
@@ -0,0 +1,679 @@
+/*
+ * Files: the top app bar (up, path, refresh, search, more) and the action bar
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "main.h"
+
+#define APP_BAR_HEIGHT     64
+#define ACTION_BAR_HEIGHT  52
+#define MAX_CRUMBS         64
+
+enum target_id
+{
+    T_NONE = -1,
+    T_UP, T_PATH, T_PATH_EDIT, T_REFRESH, T_SEARCH, T_SEARCH_CLEAR, T_MORE,
+    T_COPY, T_CUT, T_PASTE, T_DELETE, T_NEW_FOLDER, T_NEW_FILE, T_VIEW_LIST, T_VIEW_GRID,
+    T_SEGMENT = 100,  /* + index of the crumb */
+    T_CHEVRON = 200,  /* + index of the crumb */
+};
+
+struct target
+{
+    int id;
+    RECT rect;
+    BOOL enabled;
+};
+
+struct action
+{
+    int id;
+    WCHAR icon;
+    const wchar_t **label;
+};
+
+static const struct action actions[] =
+{
+    { T_COPY, ICON_CONTENT_COPY, &lc_str.copy },
+    { T_CUT, ICON_CONTENT_CUT, &lc_str.cut },
+    { T_PASTE, ICON_CONTENT_PASTE, &lc_str.paste },
+    { T_DELETE, ICON_DELETE, &lc_str.delete },
+    { T_NEW_FOLDER, ICON_CREATE_NEW_FOLDER, &lc_str.new_folder },
+    { T_NEW_FILE, ICON_NOTE_ADD, &lc_str.new_file },
+};
+
+static struct target targets[MAX_CRUMBS * 2 + 32];
+static int target_count;
+static int hot_target = T_NONE, pressed_target = T_NONE;
+static BOOL tracking, action_labels = TRUE;
+
+static HWND hwndHeader, hwndPathEdit, hwndSearchEdit;
+static WNDPROC PathEditOrigWndProc, SearchEditOrigWndProc;
+static HBRUSH field_brush;
+static BOOL path_editing;
+static RECT path_field, search_field;
+
+static struct FileNode *crumbs[MAX_CRUMBS];
+static int crumb_count, first_crumb;
+
+extern struct FileNode* currPathFileNode;
+extern HINSTANCE globalHInstance;
+extern HWND hwndMain;
+extern HWND hwndContentView;
+
+int getHeaderHeight(void)
+{
+    return px( APP_BAR_HEIGHT + ACTION_BAR_HEIGHT );
+}
+
+static struct target *add_target( int id, int left, int top, int right, int bottom, BOOL enabled )
+{
+    struct target *target;
+
+    if (target_count >= ARRAY_SIZE(targets)) return NULL;
+    target = &targets[target_count++];
+    target->id = id;
+    SetRect( &target->rect, left, top, right, bottom );
+    target->enabled = enabled;
+    return target;
+}
+
+static const struct target *find_target( int id )
+{
+    int i;
+
+    for (i = 0; i < target_count; i++) if (targets[i].id == id) return &targets[i];
+    return NULL;
+}
+
+static int text_width( enum m3_font font, const WCHAR *text )
+{
+    HDC hdc = GetDC( hwndHeader );
+    HGDIOBJ old = SelectObject( hdc, m3_font( font ));
+    SIZE size = { 0 };
+
+    GetTextExtentPoint32W( hdc, text, lstrlenW( text ), &size );
+    SelectObject( hdc, old );
+    ReleaseDC( hwndHeader, hdc );
+    return size.cx;
+}
+
+static void layout(void)
+{
+    RECT client;
+    int width, x, y, right, search_width, i, pad = px( 8 ), button = px( 40 ), avail, total;
+    int crumb_widths[MAX_CRUMBS];
+    BOOL selection = getSelectedCount() > 0;
+
+    GetClientRect( hwndHeader, &client );
+    width = client.right;
+    target_count = 0;
+
+    /* app bar */
+    y = (px( APP_BAR_HEIGHT ) - button) / 2;
+    add_target( T_UP, pad, y, pad + button, y + button, currPathFileNode && currPathFileNode->parent );
+    right = width - pad;
+    add_target( T_MORE, right - button, y, right, y + button, TRUE );
+    right -= button + pad;
+    search_width = max( px( 160 ), min( px( 320 ), width * 28 / 100 ));
+    SetRect( &search_field, right - search_width, y - px( 2 ), right, y + button + px( 2 ));
+    add_target( T_SEARCH, search_field.left, search_field.top, search_field.right, search_field.bottom, TRUE );
+    if (GetWindowTextLengthW( hwndSearchEdit ))
+        add_target( T_SEARCH_CLEAR, search_field.right - px( 4 ) - px( 36 ), search_field.top + px( 4 ),
+                    search_field.right - px( 4 ), search_field.bottom - px( 4 ), TRUE );
+    right = search_field.left - pad;
+    add_target( T_REFRESH, right - button, y, right, y + button, TRUE );
+    right -= button + pad;
+    SetRect( &path_field, pad + button + pad, y - px( 2 ), right, y + button + px( 2 ));
+    add_target( T_PATH_EDIT, path_field.right - px( 4 ) - px( 36 ), path_field.top + px( 4 ),
+                path_field.right - px( 4 ), path_field.bottom - px( 4 ), TRUE );
+
+    /* the crumbs that fit, from the last one */
+    avail = path_field.right - path_field.left - px( 12 ) - px( 44 );
+    total = 0;
+    first_crumb = crumb_count;
+    for (i = crumb_count - 1; i >= 0; i--)
+    {
+        crumb_widths[i] = text_width( i == crumb_count - 1 ? FONT_LABEL : FONT_BODY, crumbs[i]->name ) + px( 20 ) + px( 24 );
+        if (total + crumb_widths[i] > avail - (i ? px( 44 ) : 0) && i != crumb_count - 1) break;
+        total += crumb_widths[i];
+        first_crumb = i;
+    }
+    x = path_field.left + px( 6 );
+    y = path_field.top + (path_field.bottom - path_field.top - px( 32 )) / 2;
+    if (first_crumb > 0)
+    {
+        add_target( T_SEGMENT + first_crumb - 1, x, y, x + px( 32 ), y + px( 32 ), TRUE );
+        x += px( 32 );
+    }
+    for (i = first_crumb; i < crumb_count; i++)
+    {
+        int w = crumb_widths[i] - px( 24 );
+
+        if (x + w > path_field.right - px( 44 )) w = max( px( 24 ), path_field.right - px( 44 ) - x - px( 24 ));
+        add_target( T_SEGMENT + i, x, y, x + w, y + px( 32 ), TRUE );
+        x += w;
+        add_target( T_CHEVRON + i, x, y, x + px( 24 ), y + px( 32 ), crumbs[i]->type != TYPE_FILE );
+        x += px( 24 );
+    }
+    add_target( T_PATH, path_field.left, path_field.top, path_field.right, path_field.bottom, TRUE );
+
+    /* action bar: labels while they fit */
+    total = 0;
+    for (i = 0; i < ARRAY_SIZE(actions); i++)
+        total += px( 12 + 20 + 8 + 16 ) + text_width( FONT_LABEL, *actions[i].label ) + px( 4 );
+    action_labels = total + px( 40 ) + 2 * button + px( 32 ) < width;
+    x = pad;
+    y = px( APP_BAR_HEIGHT ) + (px( ACTION_BAR_HEIGHT ) - button) / 2;
+    for (i = 0; i < ARRAY_SIZE(actions); i++)
+    {
+        int w = action_labels ? px( 12 + 20 + 8 + 16 ) + text_width( FONT_LABEL, *actions[i].label ) : button;
+        BOOL enabled = TRUE;
+
+        switch (actions[i].id)
+        {
+        case T_COPY:
+        case T_CUT:
+        case T_DELETE: enabled = selection; break;
+        case T_PASTE: enabled = hasClipboardFiles(); break;
+        }
+        if (actions[i].id == T_NEW_FOLDER) x += px( 16 );  /* the divider */
+        add_target( actions[i].id, x, y, x + w, y + button, enabled );
+        x += w + px( 4 );
+    }
+    right = width - pad;
+    add_target( T_VIEW_GRID, right - button, y, right, y + button, TRUE );
+    add_target( T_VIEW_LIST, right - 2 * button, y, right - button, y + button, TRUE );
+
+    /* the edit controls */
+    if (path_editing)
+        SetWindowPos( hwndPathEdit, NULL, path_field.left + px( 18 ), path_field.top + (path_field.bottom - path_field.top - px( 20 )) / 2,
+                      path_field.right - path_field.left - px( 18 ) - px( 44 ), px( 20 ), SWP_NOZORDER | SWP_SHOWWINDOW );
+    x = search_field.left + px( 12 + 24 + 8 );
+    SetWindowPos( hwndSearchEdit, NULL, x, search_field.top + (search_field.bottom - search_field.top - px( 20 )) / 2,
+                  search_field.right - x - px( 44 ), px( 20 ), SWP_NOZORDER );
+}
+
+static int hit_test( POINT pt )
+{
+    int i;
+
+    for (i = 0; i < target_count; i++)
+    {
+        if (PtInRect( &targets[i].rect, pt ))
+        {
+            if (targets[i].id == T_PATH && path_editing) return T_NONE;
+            if (targets[i].id == T_SEARCH && GetFocus() == hwndSearchEdit) return T_NONE;
+            return targets[i].enabled ? targets[i].id : T_NONE;
+        }
+    }
+    return T_NONE;
+}
+
+static BYTE state_level( int id )
+{
+    if (id == pressed_target && id == hot_target) return M3_PRESSED;
+    if (id == hot_target && pressed_target == T_NONE) return M3_HOVER;
+    return 0;
+}
+
+static void draw_icon_button( HDC hdc, int id, WCHAR icon, COLORREF color )
+{
+    const struct target *t = find_target( id );
+    BYTE level;
+
+    if (!t) return;
+    if ((level = state_level( id ))) m3_round_rect( hdc, &t->rect, px( 20 ), m3.on_surface, level );
+    m3_icon( hdc, FONT_ICON, icon, &t->rect, t->enabled ? color : m3_blend( m3.surface_container, m3.on_surface, M3_DISABLED ));
+}
+
+static void draw_path_field( HDC hdc )
+{
+    COLORREF variant = m3.on_surface_variant;
+    const struct target *t;
+    RECT rc;
+    int i;
+
+    m3_round_rect( hdc, &path_field, (path_field.bottom - path_field.top) / 2, m3.surface_container_highest, 255 );
+    if (path_editing)
+    {
+        m3_round_frame( hdc, &path_field, (path_field.bottom - path_field.top) / 2, px( 2 ), m3.primary, 255 );
+        return;
+    }
+    if (first_crumb > 0 && (t = find_target( T_SEGMENT + first_crumb - 1 )))
+    {
+        if (state_level( t->id )) m3_round_rect( hdc, &t->rect, px( 16 ), m3.on_surface, state_level( t->id ));
+        rc = t->rect;
+        m3_text( hdc, FONT_BODY, L"\x2026", 1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE, variant );
+    }
+    for (i = first_crumb; i < crumb_count; i++)
+    {
+        BOOL last = i == crumb_count - 1;
+
+        if ((t = find_target( T_SEGMENT + i )))
+        {
+            if (state_level( t->id )) m3_round_rect( hdc, &t->rect, px( 16 ), m3.on_surface, state_level( t->id ));
+            rc = t->rect;
+            InflateRect( &rc, -px( 10 ), 0 );
+            m3_text( hdc, last ? FONT_LABEL : FONT_BODY, crumbs[i]->name, -1, &rc,
+                     DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS, last ? m3.on_surface : variant );
+        }
+        if ((t = find_target( T_CHEVRON + i )))
+        {
+            if (state_level( t->id )) m3_round_rect( hdc, &t->rect, px( 12 ), m3.on_surface, state_level( t->id ));
+            m3_icon( hdc, FONT_ICON_SMALL, ICON_CHEVRON_RIGHT, &t->rect, variant );
+        }
+    }
+    draw_icon_button( hdc, T_PATH_EDIT, ICON_EDIT, variant );
+}
+
+static void draw_search_field( HDC hdc )
+{
+    BOOL focused = GetFocus() == hwndSearchEdit;
+    RECT rc = search_field;
+
+    m3_round_rect( hdc, &search_field, (search_field.bottom - search_field.top) / 2, m3.surface_container_highest, 255 );
+    if (focused) m3_round_frame( hdc, &search_field, (search_field.bottom - search_field.top) / 2, px( 2 ), m3.primary, 255 );
+    else if (state_level( T_SEARCH )) m3_round_rect( hdc, &search_field, (search_field.bottom - search_field.top) / 2, m3.on_surface, M3_HOVER );
+    rc.left += px( 12 );
+    rc.right = rc.left + px( 24 );
+    m3_icon( hdc, FONT_ICON, ICON_SEARCH, &rc, m3.on_surface_variant );
+    if (find_target( T_SEARCH_CLEAR )) draw_icon_button( hdc, T_SEARCH_CLEAR, ICON_CLOSE, m3.on_surface_variant );
+}
+
+static void draw_actions( HDC hdc )
+{
+    COLORREF disabled = m3_blend( m3.surface_container, m3.on_surface, M3_DISABLED );
+    enum ViewStyle style = getViewStyle();
+    const struct target *t;
+    RECT rc;
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(actions); i++)
+    {
+        BYTE level;
+
+        if (!(t = find_target( actions[i].id ))) continue;
+        if (actions[i].id == T_NEW_FOLDER)
+        {
+            SetRect( &rc, t->rect.left - px( 10 ), t->rect.top + px( 10 ), t->rect.left - px( 9 ), t->rect.bottom - px( 10 ));
+            m3_fill( hdc, &rc, m3.outline_variant );
+        }
+        if ((level = state_level( t->id ))) m3_round_rect( hdc, &t->rect, px( 20 ), m3.on_surface, level );
+        rc = t->rect;
+        if (action_labels)
+        {
+            rc.left += px( 12 );
+            rc.right = rc.left + px( 20 );
+            m3_icon( hdc, FONT_ICON_SMALL, actions[i].icon, &rc, t->enabled ? m3.primary : disabled );
+            rc.left = rc.right + px( 8 );
+            rc.right = t->rect.right;
+            m3_text( hdc, FONT_LABEL, *actions[i].label, -1, &rc, DT_LEFT | DT_VCENTER | DT_SINGLELINE,
+                     t->enabled ? m3.on_surface : disabled );
+        }
+        else m3_icon( hdc, FONT_ICON_SMALL, actions[i].icon, &rc, t->enabled ? m3.primary : disabled );
+    }
+
+    /* the view: a segmented button */
+    if ((t = find_target( T_VIEW_LIST )))
+    {
+        const struct target *grid = find_target( T_VIEW_GRID );
+        BOOL list = style != STYLE_LARGE_ICON;
+
+        SetRect( &rc, t->rect.left, t->rect.top, grid->rect.right, grid->rect.bottom );
+        m3_round_frame( hdc, &rc, px( 20 ), px( 1 ), m3.outline, 255 );
+        rc = list ? t->rect : grid->rect;
+        InflateRect( &rc, -px( 1 ), -px( 1 ));
+        m3_round_rect( hdc, &rc, px( 19 ), m3.secondary_container, 255 );
+        if (state_level( T_VIEW_LIST )) m3_round_rect( hdc, &t->rect, px( 20 ), m3.on_surface, state_level( T_VIEW_LIST ));
+        if (state_level( T_VIEW_GRID )) m3_round_rect( hdc, &grid->rect, px( 20 ), m3.on_surface, state_level( T_VIEW_GRID ));
+        m3_icon( hdc, FONT_ICON_SMALL, ICON_VIEW_LIST, &t->rect, list ? m3.on_secondary_container : m3.on_surface_variant );
+        m3_icon( hdc, FONT_ICON_SMALL, ICON_GRID_VIEW, &grid->rect, list ? m3.on_surface_variant : m3.on_secondary_container );
+    }
+}
+
+static void paint( HWND hwnd )
+{
+    struct m3_buffer buffer;
+    PAINTSTRUCT ps;
+    RECT client;
+    HDC hdc;
+
+    BeginPaint( hwnd, &ps );
+    GetClientRect( hwnd, &client );
+    hdc = m3_begin_paint( &buffer, ps.hdc, &client );
+    m3_fill( hdc, &client, m3.surface_container );
+    draw_icon_button( hdc, T_UP, ICON_ARROW_UPWARD, m3.on_surface_variant );
+    draw_path_field( hdc );
+    draw_icon_button( hdc, T_REFRESH, ICON_REFRESH, m3.on_surface_variant );
+    draw_search_field( hdc );
+    draw_icon_button( hdc, T_MORE, ICON_MORE_VERT, m3.on_surface_variant );
+    draw_actions( hdc );
+    m3_end_paint( &buffer );
+    EndPaint( hwnd, &ps );
+}
+
+static void show_folder_menu( const struct target *t, struct FileNode *parent )
+{
+    HMENU menu = CreatePopupMenu();
+    struct FileNode *child, *chosen = NULL;
+    POINT pt = { t->rect.left, t->rect.bottom };
+    int id = 1, cmd;
+
+    buildChildNodes( parent, false );
+    for (child = parent->children; child; child = child->sibling)
+        if (child->type != TYPE_FILE) AppendMenuW( menu, MF_STRING, id++, child->name );
+    if (id == 1)
+    {
+        DestroyMenu( menu );
+        return;
+    }
+    ClientToScreen( hwndHeader, &pt );
+    cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_LEFTALIGN | TPM_TOPALIGN, pt.x, pt.y, 0, hwndHeader, NULL );
+    DestroyMenu( menu );
+    for (child = parent->children, id = 1; child && cmd; child = child->sibling)
+        if (child->type != TYPE_FILE && id++ == cmd) chosen = child;
+    if (chosen)
+    {
+        wchar_t path[MAX_PATH] = {0};
+
+        getFileNodePath( chosen, path );
+        navigateToPath( path );
+        SetFocus( hwndContentView );
+    }
+}
+
+static void set_path_editing( BOOL editing )
+{
+    if (path_editing == editing) return;
+    path_editing = editing;
+    if (editing)
+    {
+        wchar_t path[MAX_PATH] = {0};
+
+        if (currPathFileNode) getFileNodePath( currPathFileNode, path );
+        SetWindowTextW( hwndPathEdit, path );
+        layout();
+        SetFocus( hwndPathEdit );
+        SendMessageW( hwndPathEdit, EM_SETSEL, 0, -1 );
+    }
+    else ShowWindow( hwndPathEdit, SW_HIDE );
+    InvalidateRect( hwndHeader, NULL, FALSE );
+}
+
+static void activate( int id )
+{
+    const struct target *t = find_target( id );
+
+    if (id >= T_CHEVRON && id < T_CHEVRON + MAX_CRUMBS)
+    {
+        show_folder_menu( t, crumbs[id - T_CHEVRON] );
+        return;
+    }
+    if (id >= T_SEGMENT && id < T_SEGMENT + MAX_CRUMBS)
+    {
+        navigateToFileNode( crumbs[id - T_SEGMENT] );
+        SetFocus( hwndContentView );
+        return;
+    }
+    switch (id)
+    {
+    case T_UP:
+        navigateUp();
+        SetFocus( hwndContentView );
+        break;
+    case T_PATH:
+    case T_PATH_EDIT:
+        set_path_editing( TRUE );
+        break;
+    case T_REFRESH:
+        navigateRefresh();
+        SetFocus( hwndContentView );
+        break;
+    case T_SEARCH:
+        SetFocus( hwndSearchEdit );
+        break;
+    case T_SEARCH_CLEAR:
+        SetWindowTextW( hwndSearchEdit, L"" );
+        refreshContentView();
+        SetFocus( hwndContentView );
+        break;
+    case T_MORE:
+    {
+        POINT pt = { t->rect.right, t->rect.bottom };
+
+        ClientToScreen( hwndHeader, &pt );
+        showOverflowMenu( pt.x, pt.y );
+        break;
+    }
+    case T_COPY: onMenuItemCopyClick(); break;
+    case T_CUT: onMenuItemCutClick(); break;
+    case T_PASTE: onMenuItemPasteClick(); break;
+    case T_DELETE: onMenuItemDeleteClick(); break;
+    case T_NEW_FOLDER: onMenuItemNewFolderClick(); break;
+    case T_NEW_FILE: onMenuItemNewFileClick(); break;
+    case T_VIEW_LIST: setViewStyle( STYLE_DETAILS ); break;
+    case T_VIEW_GRID: setViewStyle( STYLE_LARGE_ICON ); break;
+    }
+    updateHeaderActions();
+}
+
+static void set_hot( int id )
+{
+    if (id == hot_target) return;
+    hot_target = id;
+    InvalidateRect( hwndHeader, NULL, FALSE );
+}
+
+static LRESULT CALLBACK HeaderWndProc( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam )
+{
+    POINT pt;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+        paint( hwnd );
+        return 0;
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_SIZE:
+        layout();
+        InvalidateRect( hwnd, NULL, FALSE );
+        return 0;
+    case WM_MOUSEMOVE:
+        if (!tracking)
+        {
+            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd };
+
+            TrackMouseEvent( &tme );
+            tracking = TRUE;
+        }
+        pt.x = (short)LOWORD(lParam);
+        pt.y = (short)HIWORD(lParam);
+        set_hot( hit_test( pt ));
+        return 0;
+    case WM_MOUSELEAVE:
+        tracking = FALSE;
+        set_hot( T_NONE );
+        return 0;
+    case WM_LBUTTONDOWN:
+        pt.x = (short)LOWORD(lParam);
+        pt.y = (short)HIWORD(lParam);
+        pressed_target = hit_test( pt );
+        hot_target = pressed_target;
+        if (pressed_target != T_NONE) SetCapture( hwnd );
+        InvalidateRect( hwnd, NULL, FALSE );
+        return 0;
+    case WM_LBUTTONUP:
+    {
+        int id = pressed_target;
+
+        pt.x = (short)LOWORD(lParam);
+        pt.y = (short)HIWORD(lParam);
+        pressed_target = T_NONE;
+        if (GetCapture() == hwnd) ReleaseCapture();
+        InvalidateRect( hwnd, NULL, FALSE );
+        if (id != T_NONE && hit_test( pt ) == id) activate( id );
+        return 0;
+    }
+    case WM_CAPTURECHANGED:
+        pressed_target = T_NONE;
+        InvalidateRect( hwnd, NULL, FALSE );
+        return 0;
+    case WM_CTLCOLOREDIT:
+        SetTextColor( (HDC)wParam, m3.on_surface );
+        SetBkColor( (HDC)wParam, m3.surface_container_highest );
+        return (LRESULT)field_brush;
+    case WM_COMMAND:
+        if ((HWND)lParam == hwndSearchEdit && (HIWORD(wParam) == EN_CHANGE || HIWORD(wParam) == EN_SETFOCUS ||
+                                               HIWORD(wParam) == EN_KILLFOCUS))
+        {
+            layout();
+            InvalidateRect( hwnd, NULL, FALSE );
+        }
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wParam, lParam );
+}
+
+static LRESULT CALLBACK PathEditWndProc( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam )
+{
+    switch (msg)
+    {
+    case WM_GETDLGCODE:
+        return DLGC_WANTALLKEYS;
+    case WM_KEYDOWN:
+        if (wParam == VK_RETURN)
+        {
+            wchar_t path[MAX_PATH] = {0};
+
+            GetWindowTextW( hwnd, path, MAX_PATH );
+            set_path_editing( FALSE );
+            navigateToPath( path );
+            SetFocus( hwndContentView );
+            return 0;
+        }
+        if (wParam == VK_ESCAPE)
+        {
+            set_path_editing( FALSE );
+            SetFocus( hwndContentView );
+            return 0;
+        }
+        break;
+    case WM_CHAR:
+        if (wParam == '\r' || wParam == 27) return 0;
+        break;
+    case WM_KILLFOCUS:
+        set_path_editing( FALSE );
+        break;
+    }
+    return CallWindowProcW( PathEditOrigWndProc, hwnd, msg, wParam, lParam );
+}
+
+static LRESULT CALLBACK SearchEditWndProc( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam )
+{
+    switch (msg)
+    {
+    case WM_GETDLGCODE:
+        return DLGC_WANTALLKEYS;
+    case WM_KEYDOWN:
+        if (wParam == VK_RETURN)
+        {
+            static wchar_t keyword[64];
+
+            GetWindowTextW( hwnd, keyword, ARRAY_SIZE(keyword) );
+            if (keyword[0]) searchFor( keyword );
+            else refreshContentView();
+            return 0;
+        }
+        if (wParam == VK_ESCAPE)
+        {
+            SetWindowTextW( hwnd, L"" );
+            refreshContentView();
+            SetFocus( hwndContentView );
+            return 0;
+        }
+        break;
+    case WM_CHAR:
+        if (wParam == '\r' || wParam == 27) return 0;
+        break;
+    }
+    return CallWindowProcW( SearchEditOrigWndProc, hwnd, msg, wParam, lParam );
+}
+
+void updateHeaderColors(void)
+{
+    if (field_brush) DeleteObject( field_brush );
+    field_brush = CreateSolidBrush( m3.surface_container_highest );
+    InvalidateRect( hwndHeader, NULL, FALSE );
+    InvalidateRect( hwndSearchEdit, NULL, TRUE );
+    InvalidateRect( hwndPathEdit, NULL, TRUE );
+}
+
+void updateHeader(void)
+{
+    struct FileNode *node;
+    wchar_t cue[128];
+    int count = 0, i;
+
+    for (node = currPathFileNode; node && count < MAX_CRUMBS; node = node->parent) count++;
+    crumb_count = count;
+    for (node = currPathFileNode, i = count - 1; node && i >= 0; node = node->parent, i--) crumbs[i] = node;
+
+    if (currPathFileNode)
+    {
+        swprintf_s( cue, ARRAY_SIZE(cue), L"%ls %ls", lc_str.search, currPathFileNode->name );
+        SendMessageW( hwndSearchEdit, EM_SETCUEBANNER, FALSE, (LPARAM)cue );
+    }
+    SetWindowTextW( hwndSearchEdit, L"" );
+    set_path_editing( FALSE );
+    layout();
+    InvalidateRect( hwndHeader, NULL, FALSE );
+}
+
+void updateHeaderActions(void)
+{
+    layout();
+    InvalidateRect( hwndHeader, NULL, FALSE );
+}
+
+void createHeader(void)
+{
+    WNDCLASSW wc = { 0 };
+
+    wc.lpfnWndProc = HeaderWndProc;
+    wc.hInstance = globalHInstance;
+    wc.hCursor = LoadCursorW( NULL, (LPCWSTR)IDC_ARROW );
+    wc.lpszClassName = L"FilesHeader";
+    RegisterClassW( &wc );
+
+    field_brush = CreateSolidBrush( m3.surface_container_highest );
+    hwndHeader = CreateWindowExW( 0, L"FilesHeader", NULL, WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN,
+                                  0, 0, 0, 0, hwndMain, NULL, globalHInstance, NULL );
+    hwndPathEdit = CreateWindowExW( 0, WC_EDITW, NULL, WS_CHILD | ES_AUTOHSCROLL | ES_LEFT,
+                                    0, 0, 0, 0, hwndHeader, NULL, globalHInstance, NULL );
+    hwndSearchEdit = CreateWindowExW( 0, WC_EDITW, NULL, WS_CHILD | WS_VISIBLE | ES_AUTOHSCROLL | ES_LEFT,
+                                      0, 0, 0, 0, hwndHeader, NULL, globalHInstance, NULL );
+    SendMessageW( hwndPathEdit, WM_SETFONT, (WPARAM)m3_font( FONT_BODY ), 0 );
+    SendMessageW( hwndSearchEdit, WM_SETFONT, (WPARAM)m3_font( FONT_BODY ), 0 );
+    PathEditOrigWndProc = (WNDPROC)SetWindowLongPtrW( hwndPathEdit, GWLP_WNDPROC, (LONG_PTR)PathEditWndProc );
+    SearchEditOrigWndProc = (WNDPROC)SetWindowLongPtrW( hwndSearchEdit, GWLP_WNDPROC, (LONG_PTR)SearchEditWndProc );
+}
+
+HWND getHeaderWindow(void)
+{
+    return hwndHeader;
+}
