+static void keyDown(WORD key) {
+    bool ctrl = GetKeyState(VK_CONTROL) < 0;
+
+    if (ctrl) {
+        switch (key) {
+            case 'C': onMenuItemCopyClick(); break;
+            case 'X': onMenuItemCutClick(); break;
+            case 'V': onMenuItemPasteClick(); break;
+            case 'A': onMenuItemSelectAllClick(); break;
+        }
+        updateHeaderActions();
+        return;
+    }
+    switch (key) {
+        case VK_DELETE:
+            onMenuItemDeleteClick();
+            break;
+        case VK_F2:
+            updateSelectedItems();
+            onMenuItemRenameClick();
+            break;
+        case VK_F5:
+            navigateRefresh();
+            break;
+        case VK_BACK:
+            navigateUp();
+            break;
+    }
+}
