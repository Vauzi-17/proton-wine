diff --git a/programs/files/string_utils.h b/programs/files/string_utils.h
new file mode 100644
index 000000000..723a04d92
--- /dev/null
+++ b/programs/files/string_utils.h
@@ -0,0 +1,36 @@
+#ifndef STRING_UTILS_H
+#define STRING_UTILS_H
+
+#include <wchar.h>
+
+static inline wchar_t* strReplace(wchar_t *str, const wchar_t *oldval, const wchar_t *newval, bool freestr) {
+    wchar_t* pwc;
+    pwc = wcsstr(str, oldval);
+    if (!pwc) return str;
+    int offset = pwc - str;
+    
+    wchar_t* endstr = str + (offset + wcslen(oldval));
+    int resLen = offset + wcslen(newval) + wcslen(endstr) + 1;
+    wchar_t* res = malloc(resLen * sizeof(wchar_t));
+    wcsncpy_s(res, resLen, str, offset);
+    wcscat_s(res, resLen, newval);
+    wcscat_s(res, resLen, endstr);
+    res[resLen-1] = L'\0';
+    
+    if (freestr) free(str);
+    return res;
+}
+
+static inline void strToLower(wchar_t* str, wchar_t* result) {
+    int count = wcslen(str);
+    for (int i = 0; i < count; i++) result[i] = towlower(str[i]);
+    result[count] = L'\0';
+}
+
+static inline void strToUpper(wchar_t* str, wchar_t* result) {
+    int count = wcslen(str);
+    for (int i = 0; i < count; i++) result[i] = towupper(str[i]);
+    result[count] = L'\0';
+}
+
+#endif
diff --git a/programs/files/treeview.c b/programs/files/treeview.c
new file mode 100644
index 000000000..624c36cb7
--- /dev/null
+++ b/programs/files/treeview.c
@@ -0,0 +1,223 @@
+#include "main.h"
+#include "icons.h"
+
+extern struct FileNode* treeFileNode;
+extern HINSTANCE globalHInstance;
+extern HWND hwndMain;
+
+HWND hwndTreeview = NULL;
+
+static void updateTreeItemsDeep(HTREEITEM parentItem, struct FileNode* parentNode) {
+    HTREEITEM child = TreeView_GetChild(hwndTreeview, parentItem);
+    
+    while (child != NULL) {
+        HTREEITEM itemToDelete = child;
+        child = TreeView_GetNextSibling(hwndTreeview, child);
+        TreeView_DeleteItem(hwndTreeview, itemToDelete);
+    }
+    
+    if (parentNode->children) {
+        TVINSERTSTRUCT tvis;
+        tvis.hParent = parentItem;
+        tvis.hInsertAfter = TVI_LAST;
+        tvis.itemex.mask = TVIF_CHILDREN | TVIF_IMAGE | TVIF_SELECTEDIMAGE | TVIF_PARAM | TVIF_TEXT | TVIF_STATE;
+        
+        struct FileNode* node = parentNode->children;
+        do {
+            tvis.itemex.cChildren = node->hasChildDirs ? 1 : 0;
+            tvis.itemex.state = node->children ? TVIS_EXPANDED : 0;
+            tvis.itemex.stateMask = TVIS_EXPANDED;
+            tvis.itemex.pszText = node->name;
+            tvis.itemex.cchTextMax = wcslen(node->name);
+            tvis.itemex.iImage = 0;
+            tvis.itemex.iSelectedImage = 0;
+            tvis.itemex.lParam = (LPARAM)node;
+
+            HTREEITEM handle = TreeView_InsertItem(hwndTreeview, &tvis);
+            updateTreeItemsDeep(handle, node);
+        }
+        while ((node = node->sibling) != NULL);
+    }
+}
+
+static void updateTreeItems(void) {
+    TreeView_DeleteAllItems(hwndTreeview);
+    
+    TVINSERTSTRUCT tvis;
+    tvis.hParent = NULL;
+    tvis.hInsertAfter = TVI_ROOT;
+    tvis.itemex.mask = TVIF_CHILDREN | TVIF_IMAGE | TVIF_SELECTEDIMAGE | TVIF_PARAM | TVIF_TEXT | TVIF_STATE;
+    
+    struct FileNode* node = treeFileNode;
+    do {
+        tvis.itemex.cChildren = node->hasChildDirs ? 1 : 0;
+        tvis.itemex.state = node->children ? TVIS_EXPANDED : 0;
+        tvis.itemex.stateMask = TVIS_EXPANDED;
+        tvis.itemex.pszText = node->name;
+        tvis.itemex.cchTextMax = wcslen(node->name);
+        tvis.itemex.iImage = 0;
+        tvis.itemex.iSelectedImage = 0;
+        tvis.itemex.lParam = (LPARAM)node;
+
+        HTREEITEM handle = TreeView_InsertItem(hwndTreeview, &tvis);
+        updateTreeItemsDeep(handle, node);      
+    }
+    while ((node = node->sibling) != NULL);
+}
+
+static void treeItemExpand(HTREEITEM treeItem, struct FileNode* node) {
+    buildChildNodes(node, true);
+    checkIfNodesHasChildDirs(node->children, false);
+    updateTreeItemsDeep(treeItem, node);
+}
+
+static void treeItemCollapse(HTREEITEM treeItem, struct FileNode* node) {
+    UNREFERENCED_PARAMETER(treeItem);
+    freeChildNodes(node);
+}
+
+static HTREEITEM hotItem;
+static bool tracking;
+static WNDPROC OrigWndProc;
+
+/* a navigation drawer: rounded items, chevrons and Material symbols, no lines */
+static LRESULT customDraw(NMTVCUSTOMDRAW* nmtvcd) {
+    switch (nmtvcd->nmcd.dwDrawStage) {
+        case CDDS_PREPAINT:
+            return CDRF_NOTIFYITEMDRAW | CDRF_NOTIFYPOSTPAINT;
+        case CDDS_POSTPAINT: {
+            /* the themed tree view fills its background with the window color, not its own */
+            HTREEITEM last = TreeView_GetLastVisible(hwndTreeview);
+            RECT client, rc;
+            GetClientRect(hwndTreeview, &client);
+            if (!last) m3_fill(nmtvcd->nmcd.hdc, &client, m3.surface_container);
+            else if (TreeView_GetItemRect(hwndTreeview, last, &rc, FALSE) && rc.bottom + 1 < client.bottom) {
+                client.top = rc.bottom + 1;
+                m3_fill(nmtvcd->nmcd.hdc, &client, m3.surface_container);
+            }
+            return CDRF_DODEFAULT;
+        }
+        case CDDS_ITEMPREPAINT: {
+            HDC hdc = nmtvcd->nmcd.hdc;
+            HTREEITEM hItem = (HTREEITEM)nmtvcd->nmcd.dwItemSpec;
+            TVITEMW item = {0};
+            struct NodeIcon icon;
+            RECT client, rc = nmtvcd->nmcd.rc;
+            int indent = TreeView_GetIndent(hwndTreeview), depth = 0;
+            bool selected = TreeView_GetSelection(hwndTreeview) == hItem;
+            HTREEITEM parent = hItem;
+
+            while ((parent = TreeView_GetParent(hwndTreeview, parent))) depth++;
+            item.mask = TVIF_PARAM | TVIF_STATE | TVIF_CHILDREN;
+            item.stateMask = TVIS_EXPANDED;
+            item.hItem = hItem;
+            TreeView_GetItem(hwndTreeview, &item);
+
+            GetClientRect(hwndTreeview, &client);
+            rc.left = client.left;
+            rc.right = client.right;
+            rc.bottom++;  /* the rectangles of the items leave out their last line */
+            m3_fill(hdc, &rc, m3.surface_container);
+            rc.bottom--;
+            InflateRect(&rc, -px(2), -px(2));
+            if (selected) m3_round_rect(hdc, &rc, (rc.bottom - rc.top) / 2, m3.secondary_container, 255);
+            else if (hItem == hotItem) m3_round_rect(hdc, &rc, (rc.bottom - rc.top) / 2, m3.on_surface, M3_HOVER);
+
+            rc = nmtvcd->nmcd.rc;
+            if (item.cChildren) {
+                rc.left = depth * indent;
+                rc.right = rc.left + indent;
+                m3_icon(hdc, FONT_ICON_SMALL, (item.state & TVIS_EXPANDED) ? ICON_EXPAND_MORE : ICON_CHEVRON_RIGHT, &rc,
+                        m3.on_surface_variant);
+            }
+            getNodeIcon((struct FileNode*)item.lParam, &icon);
+            rc.left = (depth + 1) * indent;
+            rc.right = rc.left + px(28);
+            m3_icon(hdc, FONT_ICON_SMALL, icon.glyph, &rc,
+                    selected ? m3.on_secondary_container : icon.accent ? m3.primary : m3.on_surface_variant);
+            rc.left = rc.right + px(8);
+            rc.right = client.right - px(12);
+            m3_text(hdc, FONT_LABEL, ((struct FileNode*)item.lParam)->name, -1, &rc,
+                    DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS,
+                    selected ? m3.on_secondary_container : m3.on_surface_variant);
+            return CDRF_SKIPDEFAULT;
+        }
+    }
+    return CDRF_DODEFAULT;
+}
+
+static void setHotItem(HTREEITEM hItem) {
+    RECT rc;
+    if (hItem == hotItem) return;
+    if (hotItem && TreeView_GetItemRect(hwndTreeview, hotItem, &rc, FALSE)) InvalidateRect(hwndTreeview, &rc, FALSE);
+    hotItem = hItem;
+    if (hotItem && TreeView_GetItemRect(hwndTreeview, hotItem, &rc, FALSE)) InvalidateRect(hwndTreeview, &rc, FALSE);
+}
+
+static LRESULT CALLBACK TreeviewWndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
+    switch (msg) {
+        case WM_MOUSEMOVE: {
+            TVHITTESTINFO tvhti = {{(short)LOWORD(lParam), (short)HIWORD(lParam)}};
+            if (!tracking) {
+                TRACKMOUSEEVENT tme = {sizeof(tme), TME_LEAVE, hwnd};
+                TrackMouseEvent(&tme);
+                tracking = true;
+            }
+            setHotItem(TreeView_HitTest(hwnd, &tvhti));
+            break;
+        }
+        case WM_MOUSELEAVE:
+            tracking = false;
+            setHotItem(NULL);
+            break;
+    }
+    return CallWindowProc(OrigWndProc, hwnd, msg, wParam, lParam);
+}
+
+LRESULT treeviewNotify(NMHDR* nmhdr) {
+    switch (nmhdr->code) {
+        case TVN_ITEMEXPANDING: {
+            NMTREEVIEW* nmtv = (NMTREEVIEW*)nmhdr;
+            struct FileNode* node = (struct FileNode*)nmtv->itemNew.lParam;
+            if (nmtv->action == TVE_EXPAND) treeItemExpand(nmtv->itemNew.hItem, node);
+            break;
+        }
+        case TVN_ITEMEXPANDED: {
+            NMTREEVIEW* nmtv = (NMTREEVIEW*)nmhdr;
+            struct FileNode* node = (struct FileNode*)nmtv->itemNew.lParam;
+            if (nmtv->action == TVE_COLLAPSE) {
+                treeItemCollapse(nmtv->itemNew.hItem, node);
+            }
+            break;
+        }
+        case TVN_SELCHANGED: {
+            NMTREEVIEW* nmtv = (NMTREEVIEW*)nmhdr;
+            if (nmtv->action == TVC_BYMOUSE || nmtv->action == TVC_BYKEYBOARD) {
+                struct FileNode* node = (struct FileNode*)nmtv->itemNew.lParam;
+                if (node) navigateToFileNode(node);
+            }
+            break;
+        }
+        case NM_CUSTOMDRAW:
+            return customDraw((NMTVCUSTOMDRAW*)nmhdr);
+    }
+
+    return 0;   
+}
+
+void createTreeview(void) {
+    hwndTreeview = CreateWindowEx(0, WC_TREEVIEW, NULL, WS_VISIBLE | WS_CHILD | WS_CLIPSIBLINGS | TVS_HASBUTTONS | TVS_LINESATROOT |
+                                  TVS_SHOWSELALWAYS | TVS_FULLROWSELECT | TVS_NOHSCROLL, 0, 0, 0, 0, hwndMain, (HMENU)NULL, globalHInstance, NULL);
+
+    /* an empty image list keeps room for the symbols */
+    TreeView_SetImageList(hwndTreeview, ImageList_Create(px(28), px(16), ILC_COLOR32, 1, 0), TVSIL_NORMAL);
+    SendMessage(hwndTreeview, WM_SETFONT, (WPARAM)m3_font(FONT_LABEL), 0);
+    TreeView_SetItemHeight(hwndTreeview, px(40));
+    TreeView_SetIndent(hwndTreeview, px(20));
+    TreeView_SetBkColor(hwndTreeview, m3.surface_container);
+    TreeView_SetTextColor(hwndTreeview, m3.on_surface);
+    OrigWndProc = (WNDPROC)SetWindowLongPtr(hwndTreeview, GWLP_WNDPROC, (LONG_PTR)TreeviewWndProc);
+
+    updateTreeItems();                            
+    UpdateWindow(hwndTreeview);                               
+}
