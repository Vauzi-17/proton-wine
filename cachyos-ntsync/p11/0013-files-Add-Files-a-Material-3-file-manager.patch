+/* rows and tiles in the Material style, drawn instead of the list view's own */
+static LRESULT customDraw(NMLVCUSTOMDRAW* nmlvcd) {
+    switch (nmlvcd->nmcd.dwDrawStage) {
+        case CDDS_PREPAINT:
+            return CDRF_NOTIFYITEMDRAW;
+        case CDDS_ITEMPREPAINT: {
+            HDC hdc = nmlvcd->nmcd.hdc;
+            int index = nmlvcd->nmcd.dwItemSpec;
+            bool selected = ListView_GetItemState(hwndContentView, index, LVIS_SELECTED) & LVIS_SELECTED;
+            COLORREF text = selected ? m3.on_secondary_container : m3.on_surface;
+            COLORREF variant = selected ? m3.on_secondary_container : m3.on_surface_variant;
+            struct ListItem* item;
+            RECT bounds, rc, client;
+
+            if (index < 0 || index >= numItems) return CDRF_SKIPDEFAULT;
+            item = &items[index];
+            loadItem(item);
+            GetClientRect(hwndContentView, &client);
+            ListView_GetItemRect(hwndContentView, index, &bounds, LVIR_BOUNDS);
+
+            if (viewStyle == STYLE_LARGE_ICON) {
+                rc = bounds;
+                InflateRect(&rc, -px(2), -px(2));
+                if (selected) m3_round_rect(hdc, &rc, px(16), m3.secondary_container, 255);
+                else if (index == hotItem) m3_round_rect(hdc, &rc, px(16), m3.on_surface, M3_HOVER);
+                ListView_GetItemRect(hwndContentView, index, &rc, LVIR_ICON);
+                drawItemIcon(hdc, item, &rc, true, m3.on_secondary_container, selected);
+                rc.top = rc.bottom + px(2);
+                rc.bottom = bounds.bottom - px(4);
+                rc.left = bounds.left + px(6);
+                rc.right = bounds.right - px(6);
+                m3_text(hdc, FONT_BODY, item->node->name, -1, &rc, DT_CENTER | DT_WORDBREAK | DT_END_ELLIPSIS | DT_EDITCONTROL, text);
+                return CDRF_SKIPDEFAULT;
+            }
+
+            if (viewStyle == STYLE_DETAILS) {
+                /* the whole width, not only the columns */
+                bounds.left = max(bounds.left, client.left);
+                bounds.right = client.right;
+            }
+            rc = bounds;
+            InflateRect(&rc, -px(4), -px(1));
+            if (selected) m3_round_rect(hdc, &rc, px(12), m3.secondary_container, 255);
+            else if (index == hotItem) m3_round_rect(hdc, &rc, px(12), m3.on_surface, M3_HOVER);
+
+            ListView_GetItemRect(hwndContentView, index, &rc, LVIR_ICON);
+            rc.left += px(8);
+            rc.right += px(8);
+            drawItemIcon(hdc, item, &rc, false, m3.on_secondary_container, selected);
+
+            ListView_GetItemRect(hwndContentView, index, &rc, LVIR_LABEL);
+            rc.left += px(16);
+            if (viewStyle == STYLE_DETAILS) {
+                RECT column;
+                ListView_GetSubItemRect(hwndContentView, index, 0, LVIR_LABEL, &column);
+                rc.right = column.right - px(4);
+            }
+            else rc.right = bounds.right - px(8);
+            m3_text(hdc, FONT_BODY, item->node->name, -1, &rc, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS, text);
+
+            if (viewStyle == STYLE_DETAILS) {
+                int columns = Header_GetItemCount(ListView_GetHeader(hwndContentView));
+                for (int i = 1; i < columns; i++) {
+                    const wchar_t* str = L"";
+                    switch (i) {
+                        case COLUMN_TYPE_IDX: str = item->type; break;
+                        case COLUMN_SIZE_IDX: str = item->node->type == TYPE_FILE ? item->formattedSize : L""; break;
+                        case COLUMN_DATE_IDX: str = item->node->type == TYPE_FILE ? item->formattedDate : L""; break;
+                        case COLUMN_PATH_IDX: {
+                            if (!item->path) {
+                                wchar_t path[MAX_PATH] = {0};
+                                getFileNodePath(item->node, path);
+                                item->path = wcsdup(path);
+                            }
+                            str = item->path;
+                            break;
+                        }
+                    }
+                    ListView_GetSubItemRect(hwndContentView, index, i, LVIR_LABEL, &rc);
+                    rc.left += px(6);
+                    rc.right -= px(6);
+                    m3_text(hdc, FONT_BODY, str, -1, &rc, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS, variant);
+                }
+            }
+            return CDRF_SKIPDEFAULT;
+        }
+    }
+    return CDRF_DODEFAULT;
+}
