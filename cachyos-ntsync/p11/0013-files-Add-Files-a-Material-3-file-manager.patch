diff --git a/programs/files/iso_image.c b/programs/files/iso_image.c
new file mode 100644
index 000000000..bcfd164ff
--- /dev/null
+++ b/programs/files/iso_image.c
@@ -0,0 +1,194 @@
+/*
+ * Files: extracting ISO 9660 images and CD images, in place of libcdio
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "main.h"
+
+#define ISO_SECTOR 2048
+#define MAX_DEPTH 32
+
+struct IsoImage {
+    HANDLE file;
+    DWORD sectorSize;   /* 2048, or 2352 for raw CD sectors */
+    DWORD dataOffset;   /* of the 2048 bytes of data in a sector */
+    bool joliet;
+    volatile bool* cancel;
+};
+
+static bool readSectors(struct IsoImage* image, DWORD lsn, BYTE* buffer, DWORD count) {
+    for (DWORD i = 0; i < count; i++) {
+        LARGE_INTEGER pos;
+        DWORD read;
+
+        pos.QuadPart = (LONGLONG)(lsn + i) * image->sectorSize + image->dataOffset;
+        if (!SetFilePointerEx(image->file, pos, NULL, FILE_BEGIN)) return false;
+        if (!ReadFile(image->file, buffer + i * ISO_SECTOR, ISO_SECTOR, &read, NULL) || read != ISO_SECTOR) return false;
+    }
+    return true;
+}
+
+static DWORD le32(const BYTE* p) {
+    return p[0] | (p[1] << 8) | (p[2] << 16) | ((DWORD)p[3] << 24);
+}
+
+/* the name of a directory record: UCS-2 big endian with Joliet, else ASCII without the version */
+static void recordName(struct IsoImage* image, const BYTE* record, wchar_t* name) {
+    int len = record[32], count = 0;
+    const BYTE* p = record + 33;
+
+    if (image->joliet) {
+        for (int i = 0; i + 1 < len && count < MAX_PATH - 1; i += 2) name[count++] = (p[i] << 8) | p[i + 1];
+    }
+    else {
+        for (int i = 0; i < len && count < MAX_PATH - 1; i++) name[count++] = towlower(p[i]);
+    }
+    name[count] = 0;
+    wchar_t* version = wcschr(name, L';');
+    if (version) *version = 0;
+    if (count && name[wcslen(name) - 1] == L'.') name[wcslen(name) - 1] = 0;
+}
+
+static void extractFile(struct IsoImage* image, DWORD lsn, DWORD size, const wchar_t* path) {
+    HANDLE out = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    BYTE* buffer = malloc(16 * ISO_SECTOR);
+
+    if (out != INVALID_HANDLE_VALUE && buffer) {
+        while (size > 0 && !*image->cancel) {
+            DWORD sectors = min(16, (size + ISO_SECTOR - 1) / ISO_SECTOR), bytes = min(size, sectors * ISO_SECTOR), written;
+            if (!readSectors(image, lsn, buffer, sectors) || !WriteFile(out, buffer, bytes, &written, NULL)) break;
+            lsn += sectors;
+            size -= bytes;
+        }
+    }
+    free(buffer);
+    if (out != INVALID_HANDLE_VALUE) CloseHandle(out);
+}
+
+static void extractDirectory(struct IsoImage* image, DWORD lsn, DWORD size, const wchar_t* dstPath, int depth) {
+    DWORD sectors = (size + ISO_SECTOR - 1) / ISO_SECTOR;
+    BYTE* buffer;
+
+    if (depth > MAX_DEPTH || !sectors || sectors > 4096 || !(buffer = malloc(sectors * ISO_SECTOR))) return;
+    if (readSectors(image, lsn, buffer, sectors)) {
+        DWORD offset = 0;
+        while (offset < size && !*image->cancel) {
+            const BYTE* record = buffer + offset;
+            wchar_t name[MAX_PATH], path[MAX_PATH];
+
+            if (!record[0]) {
+                /* records do not cross sectors: go to the next one */
+                offset = (offset / ISO_SECTOR + 1) * ISO_SECTOR;
+                continue;
+            }
+            if (offset + record[0] > sectors * ISO_SECTOR || record[0] < 34) break;
+            offset += record[0];
+            if (record[32] == 1 && (record[33] == 0 || record[33] == 1)) continue;  /* . and .. */
+
+            recordName(image, record, name);
+            if (!name[0]) continue;
+            joinPaths((wchar_t*)dstPath, name, path);
+            if (record[25] & 2) {
+                CreateDirectoryW(path, NULL);
+                extractDirectory(image, le32(record + 2), le32(record + 10), path, depth + 1);
+            }
+            else extractFile(image, le32(record + 2), le32(record + 10), path);
+        }
+    }
+    free(buffer);
+}
+
+/* the data track of a cue sheet: its bin file and sector format */
+static bool openCueSheet(const wchar_t* cuePath, struct IsoImage* image) {
+    char text[4096] = {0}, binName[MAX_PATH] = {0};
+    wchar_t binPath[MAX_PATH], dir[MAX_PATH], name[MAX_PATH];
+    HANDLE cue = CreateFileW(cuePath, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    DWORD read = 0;
+    char *p, *q;
+
+    if (cue == INVALID_HANDLE_VALUE) return false;
+    ReadFile(cue, text, sizeof(text) - 1, &read, NULL);
+    CloseHandle(cue);
+
+    if (!(p = strstr(text, "FILE"))) return false;
+    if ((p = strchr(p, '"')) && (q = strchr(p + 1, '"')) && q - p - 1 < MAX_PATH) memcpy(binName, p + 1, q - p - 1);
+    if (!binName[0]) return false;
+    if (strstr(text, "MODE2/2352")) {
+        image->sectorSize = 2352;
+        image->dataOffset = 24;
+    }
+    else if (strstr(text, "MODE1/2352")) {
+        image->sectorSize = 2352;
+        image->dataOffset = 16;
+    }
+
+    MultiByteToWideChar(CP_ACP, 0, binName, -1, name, MAX_PATH);
+    getParentDirFromPath((wchar_t*)cuePath, dir);
+    joinPaths(dir, name, binPath);
+    image->file = CreateFileW(binPath, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    return image->file != INVALID_HANDLE_VALUE;
+}
+
+/* raw 2352 byte sectors start with a sync pattern; mode 2 data comes after a subheader */
+static void detectSectors(struct IsoImage* image) {
+    static const BYTE sync[12] = {0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0};
+    BYTE header[16];
+    DWORD read;
+
+    SetFilePointer(image->file, 0, NULL, FILE_BEGIN);
+    if (ReadFile(image->file, header, 16, &read, NULL) && read == 16 && !memcmp(header, sync, 12)) {
+        image->sectorSize = 2352;
+        image->dataOffset = header[15] == 2 ? 24 : 16;
+    }
+}
+
+bool extractIsoImage(wchar_t* imagePath, wchar_t* dstPath, volatile bool* cancel) {
+    struct IsoImage image = {INVALID_HANDLE_VALUE, ISO_SECTOR, 0, false, cancel};
+    BYTE descriptor[ISO_SECTOR];
+    DWORD rootLsn = 0, rootSize = 0;
+    bool ok = false;
+
+    if (hasFileExtension(imagePath, L"cue")) {
+        if (!openCueSheet(imagePath, &image)) return false;
+    }
+    else {
+        image.file = CreateFileW(imagePath, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+        if (image.file == INVALID_HANDLE_VALUE) return false;
+        detectSectors(&image);
+    }
+
+    /* the volume descriptors: the primary one, and the Joliet one if there is one */
+    for (DWORD lsn = 16; lsn < 64 && readSectors(&image, lsn, descriptor, 1); lsn++) {
+        if (memcmp(descriptor + 1, "CD001", 5) || descriptor[0] == 255) break;
+        if (descriptor[0] == 1 && !rootSize) {
+            rootLsn = le32(descriptor + 156 + 2);
+            rootSize = le32(descriptor + 156 + 10);
+        }
+        else if (descriptor[0] == 2 && descriptor[88] == '%' && descriptor[89] == '/' &&
+                 (descriptor[90] == '@' || descriptor[90] == 'C' || descriptor[90] == 'E')) {
+            rootLsn = le32(descriptor + 156 + 2);
+            rootSize = le32(descriptor + 156 + 10);
+            image.joliet = true;
+            break;
+        }
+    }
+    if (rootSize) {
+        extractDirectory(&image, rootLsn, rootSize, dstPath, 0);
+        ok = true;
+    }
+    CloseHandle(image.file);
+    return ok;
+}
