#include <winnt.h>

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

/* Theme color display names */
STRINGTABLE
{
@COLOR_DISPLAY_NAMES@
}

/* Theme color tooltips */
STRINGTABLE
{
@COLOR_TOOLTIPS@
}

/* Theme size display names and tooltips */
STRINGTABLE
{
    3000 "Normal"
    4000 "Normal"
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* Theme version */
1 PACKTHEM_VERSION {0x3}

/* Theme color names: the six accents in light and dark */
1 COLORNAMES
{
@COLORNAMES@
"\0"
}

/* Theme size names */
1 SIZENAMES
{
"NormalSize\0"
"\0"
}

/* Theme ini files, one per color */
1 FILERESNAMES
{
@FILERESNAMES@
"\0"
}

/* Theme definition */
THEMES_INI TEXTFILE
{
"[documentation]\r\n"
"DisplayName = Material 3\r\n"
"ToolTip = Material 3 Visual Style\r\n"
}

/* The images are drawn in key colors, which [WineRecolor] maps to the colors of the scheme */

